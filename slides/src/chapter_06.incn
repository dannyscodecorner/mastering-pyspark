                    ], level=2),
                    paragraph([
                        text("The blocks are organised"),
                        line_break(),
                        text("by destination partition."),
                    ]),
                ], style="scb-prepare-note"),
            ], style="scb-scene", attributes=[attr("role", "group"), attr("aria-label", "The same three workers prepare shuffle blocks from both inputs. Local and remote fetches bring corresponding sales and products to each join partition. Local joins produce five sales including the unmatched M1 sale with NULL category.")]),

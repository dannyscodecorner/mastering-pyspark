                            span("books"),
                        ], style="jm-record jm-books jm-lookup-B1"),
                        group([
                            span("G1"),
                            span("games"),
                        ], style="jm-record jm-games jm-lookup-G1"),
                        group([
                            span("X1"),
                            span("accessories"),
                        ], style="jm-record jm-extra jm-lookup-X1"),
                    ], style="jm-broadcast-copy jm-after-2"),
                    span("→", style="jm-local-match-arrow jm-after-3", attributes=[attr("aria-hidden", "true")]),
                    group([
                        group([
                            span("B1"),
                            span("10"),
                            span("books"),
                        ], style="jm-record jm-books jm-after-3 jm-b1-output"),
                    ], style="jm-broadcast-result"),
                ], style="jm-broadcast-lane", attributes=[attr("style", "--lane:2")]),
                node(NodeKind.Svg, children=[
                    node(NodeKind.SvgDefinitions, children=[
                        node(NodeKind.SvgMarker, children=[
                            node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L10 5L0 10Z")]),
                        ], attributes=[attr("id", "jm-broadcast-arrow"), attr("viewBox", "0 0 10 10"), attr("refX", "9"), attr("refY", "5"), attr("markerWidth", "5"), attr("markerHeight", "5"), attr("orient", "auto")]),
                    ]),
                    node(NodeKind.SvgPath, style="jm-broadcast-wire", attributes=[attr("d", "M620 48V104Q620 112 628 112H698")]),
                    node(NodeKind.SvgPath, style="jm-broadcast-wire", attributes=[attr("d", "M640 48V204Q640 212 648 212H698")]),
                    node(NodeKind.SvgPath, style="jm-broadcast-wire", attributes=[attr("d", "M660 48V304Q660 312 668 312H698")]),
                ], style="jm-broadcast-routes jm-after-2", attributes=[attr("viewBox", "0 0 1308 396"), attr("aria-hidden", "true")]),
            ], style="jm-broadcast-scene"),
            step_cues(steps),
            group([
                node(NodeKind.Button, content="Previous point", attributes=[attr("data-lesson-prev", flag=true)]),
                node(NodeKind.Button, content="Next point", attributes=[attr("data-lesson-next", flag=true)]),
                node(NodeKind.Button, content="Replay", attributes=[attr("data-lesson-reset", flag=true)]),
                span("", style="lesson-position", attributes=[attr("aria-live", "polite")]),
            ], style="lesson-controls"),
        ], style="lesson jm-lesson jm-broadcast", attributes=[attr("data-lesson", flag=true), attr("data-point", "4")]),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("67"),
        ]),
        ],
        notes="""This is the alternative to the shuffled strategies, so explicitly return to the original input placement from “Same key. Different places.” rather than continue from their already-paid shuffle. Worker A holds B1/25 and G1/40 with G1/games, B has B1/15 and M1/10 with X1/accessories, and C has B1/10 with B1/books. The products source remains visible as provenance. Step 1 collects the build-side relation and builds the hashed relation at the driver. Step 2 distributes the complete relation, containing B1, G1 and X1, to each participating executor. The drawn routes are conceptual dissemination, not the literal topology of Spark's torrent/block broadcast implementation. One prepared broadcast relation can be shared by tasks on an executor; do not imply one full copy is required per task. Spark may fetch broadcast blocks as tasks need them.

Step 3 highlight all B1 sales in their original locations and B1/books in every copied lookup. Those sales now match locally. Step 4 adds G1/40/games and M1/10/NULL and preserves all 5 sales totaling 100. Each lookup includes X1 even though it produces no sale. No hash redistribution of the large sales input is required for this join. This does not mean there is zero network traffic, nor that existing skew in the sales input has vanished. The full build side has to be safe for the driver and executors; compressed file size is not its in-memory hash size. Broadcast selection depends on supported join type, build side, statistics, thresholds and hints, and AQE may convert an eligible plan. Avoiding a shuffle by initially planning broadcast is different from converting after upstream shuffle work has already run. No measured speedup is claimed.
Sources: https://spark.apache.org/docs/latest/sql-performance-tuning.html ; https://github.com/apache/spark/blob/v3.5.6/sql/core/src/main/scala/org/apache/spark/sql/execution/exchange/BroadcastExchangeExec.scala ; https://github.com/apache/spark/blob/v3.5.6/sql/core/src/main/scala/org/apache/spark/sql/execution/joins/BroadcastHashJoinExec.scala""",
    )

pub def slide_join_nested_loop() -> Slide:
    steps = [
        TeachingStep(label="Range condition",
            heading="An equality-key lookup cannot answer this range condition directly.",
            explanation="Each task has the broadcast bands and tests candidate rows against its sales.",
            cue_key="", numbered=false),
        TeachingStep(label="Test amount 25",
            heading="For amount 25, only the Medium band matches.",
            explanation="The task evaluates the range condition against all three candidate bands.",
            cue_key="", numbered=false),
        TeachingStep(label="Test amount 40",
            heading="For amount 40, only the High band matches.",
            explanation="The lower bound is inclusive and the upper bound is exclusive.",
            cue_key="", numbered=false),
        TeachingStep(label="Count the comparisons",
            heading="Broadcasting the candidates does not remove the pair comparisons.",
            explanation="For this example, two sales need six tests. Large inputs can make candidate-pair work expensive.",
            cue_key="", numbered=false),
    ]
    return Slide(
        slug="join-nested-loop",
        title="Broadcast nested-loop joins",
        frame=Frame.Composed,
        styles="slide lesson-slide join-mechanics ",
        content=[
            group([
            text("06 / GROUPING, JOINING & AGGREGATING"),
        ], style="eyebrow"),
            heading("Broadcast nested-loop joins", level=1),
            group([
            step_rail(steps),
            group([
                code("sales.amount >= bands.lower AND sales.amount < bands.upper"),
                span("A new condition and a new lookup"),
            ], style="jm-query jm-condition"),
            group([
                node(NodeKind.Aside, children=[
                    heading("Amount bands", level=2),
                    prose("Broadcast all three candidate rows."),
                    node(NodeKind.Table, children=[
                        node(NodeKind.TableHead, children=[
                            node(NodeKind.Row, children=[
                                node(NodeKind.HeaderCell, content="Band"),
                                node(NodeKind.HeaderCell, content="lower ≤ amount < upper"),
                            ]),
                        ]),
                        node(NodeKind.TableBody, children=[
                            node(NodeKind.Row, children=[
                                node(NodeKind.HeaderCell, content="Low"),
                                node(NodeKind.Cell, content="0 ≤ amount < 20"),
                            ]),
                            node(NodeKind.Row, children=[
                                node(NodeKind.HeaderCell, content="Medium"),
                                node(NodeKind.Cell, content="20 ≤ amount < 40"),
                            ]),
                            node(NodeKind.Row, children=[
                                node(NodeKind.HeaderCell, content="High"),
                                node(NodeKind.Cell, content="40 ≤ amount < 60"),
                            ]),
                        ]),
                    ], style="jm-bands"),
                    group([
                        heading("Worker A’s sales", level=3),
                        group([
                            span("B1"),
                            span("25"),
                        ], style="jm-record jm-books "),
                        group([
                            span("G1"),
                            span("40"),
                        ], style="jm-record jm-games "),
                    ], style="jm-loop-source"),
                ], style="jm-loop-input"),
                group([
                    group([
                        heading("Inside Worker A’s join task", level=2),
                        span("Test the range condition for each candidate"),
                    ], style="jm-task-heading"),
                    node(NodeKind.Table, children=[
                        node(NodeKind.TableHead, children=[
                            node(NodeKind.Row, children=[
                                node(NodeKind.HeaderCell, content="Sale amount"),
                                node(NodeKind.HeaderCell, children=[
                                    text("Low "),
                                    node(NodeKind.Small, content="0–20"),
                                ]),
                                node(NodeKind.HeaderCell, children=[
                                    text("Medium "),
                                    node(NodeKind.Small, content="20–40"),
                                ]),
                                node(NodeKind.HeaderCell, children=[
                                    text("High "),
                                    node(NodeKind.Small, content="40–60"),
                                ]),
                            ]),
                        ]),
                        node(NodeKind.TableBody, children=[
                            node(NodeKind.Row, children=[
                                node(NodeKind.HeaderCell, content="25"),
                                node(NodeKind.Cell, children=[
                                    span("✕", style="jm-after-1"),
                                ]),
                                node(NodeKind.Cell, children=[
                                    span("✓", style="jm-after-1"),
                                ], style="jm-match-cell"),
                                node(NodeKind.Cell, children=[
                                    span("✕", style="jm-after-1"),
                                ]),
                            ], style="jm-test-25"),
                            node(NodeKind.Row, children=[
                                node(NodeKind.HeaderCell, content="40"),
                                node(NodeKind.Cell, children=[
                                    span("✕", style="jm-after-2"),
                                ]),
                                node(NodeKind.Cell, children=[
                                    span("✕", style="jm-after-2"),
                                ]),
                                node(NodeKind.Cell, children=[
                                    span("✓", style="jm-after-2"),
                                ], style="jm-match-cell"),
                            ], style="jm-test-40"),
                        ]),
                    ], style="jm-candidate-grid"),
                    group([
                        heading("Joined rows", level=3),
                        group([
                            span("B1"),
                            span("25"),
                            span("Medium"),
                        ], style="jm-record jm-books jm-after-1"),
                        group([
                            span("G1"),
                            span("40"),
                            span("High"),
                        ], style="jm-record jm-games jm-after-2"),
                    ], style="jm-loop-out"),
                    group([
                        strong("2 sales × 3 bands = 6 tests"),
                        span("Two pairs satisfy the condition."),
                    ], style="jm-cost-line jm-after-3"),
                ], style="jm-comparison-area"),
            ], style="jm-loop-layout"),
            step_cues(steps),
            group([
                node(NodeKind.Button, content="Previous point", attributes=[attr("data-lesson-prev", flag=true)]),
                node(NodeKind.Button, content="Next point", attributes=[attr("data-lesson-next", flag=true)]),
                node(NodeKind.Button, content="Replay", attributes=[attr("data-lesson-reset", flag=true)]),
                span("", style="lesson-position", attributes=[attr("aria-live", "polite")]),
            ], style="lesson-controls"),
        ], style="lesson jm-lesson jm-loop", attributes=[attr("data-lesson", flag=true), attr("data-point", "3")]),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("68"),
        ]),
        ],
        notes="""Make the condition change explicit. We are leaving the product equality join and assigning each sale to an amount band. The small bands input is new and fully shown: Low [0,20), Medium [20,40), High [40,60). Use a left join with bands as the right broadcast side. Focus on Worker A's existing B1/25 and G1/40 rows. A BroadcastNestedLoopJoin can test 25 against all three bands and 40 against all three, giving six condition evaluations and two output rows in this displayed task. Since the example is a left join with potential multiple matching bands, finding one match is not a general reason to stop. Other join types can short-circuit, and exact implementation costs vary. The remaining sales in other tasks would match Low; we have not silently removed them from the whole dataset.

Equality hash lookup needs an equality key; this range-only predicate has none. An equality join plus a residual range predicate can still use an equality-key strategy. BroadcastNestedLoopJoin is one supported plan for non-equi joins and can also serve as a fallback for some equi joins. Do not claim every non-equi join chooses this operator, or that a broadcast hint automatically gives BroadcastHashJoin. The displayed 2×3 count is toy candidate-pair arithmetic, not a benchmark. Range structures and domain-specific optimisations are outside this introduction. The copied side still costs network and memory. Full source relation preparation is analogous to the preceding broadcast slide, except the broadcast data is used for pair tests instead of a key hash probe.
Sources: https://github.com/apache/spark/blob/v3.5.6/sql/core/src/main/scala/org/apache/spark/sql/execution/SparkStrategies.scala ; https://github.com/apache/spark/blob/v3.5.6/sql/core/src/main/scala/org/apache/spark/sql/execution/joins/BroadcastNestedLoopJoinExec.scala""",
    )

pub def slide_join_cartesian() -> Slide:
    steps = [
        TeachingStep(label="Input partitions",
            heading="A CartesianProduct plan works on pairs of input partitions.",
            explanation="Here the original sales and products each have three input partitions.",
            cue_key="", numbered=false),
        TeachingStep(label="Partition pairs",
            heading="Three sales partitions × three products partitions gives nine tasks.",
            explanation="The tasks evaluate different partition pairs; the same input can be read by several tasks.",
            cue_key="", numbered=false),
        TeachingStep(label="Inside one task",
            heading="This task emits every pair from its two input partitions.",
            explanation="These are the requested cross-join results, including unequal product IDs.",
            cue_key="", numbered=false),
        TeachingStep(label="Complete result",
            heading="The complete result contains 5 × 3 = 15 rows.",
            explanation="For larger inputs, the candidate work and cross-join output grow as N × M.",
            cue_key="", numbered=false),
    ]
    return Slide(
        slug="join-cartesian",
        title="Cartesian product joins",
        frame=Frame.Composed,
        styles="slide lesson-slide join-mechanics ",
        content=[
            group([
            text("06 / GROUPING, JOINING & AGGREGATING"),
        ], style="eyebrow"),
            heading("Cartesian product joins", level=1),
            group([
            step_rail(steps),
            group([
                node(NodeKind.Preformatted, children=[
                    code("sales.crossJoin(products)"),
                ], style="language-python"),
                span("This example requests every sale–product pair"),
            ], style="jm-query"),
            group([
                group([
                    heading("Every sales partition meets every products partition", level=2),
                    node(NodeKind.Table, children=[
                        node(NodeKind.TableHead, children=[
                            node(NodeKind.Row, children=[
                                node(NodeKind.HeaderCell),
                                node(NodeKind.HeaderCell, children=[
                                    text("Products P0"),
                                    node(NodeKind.Small, content="G1 / games"),
                                ]),
                                node(NodeKind.HeaderCell, children=[
                                    text("Products P1"),
                                    node(NodeKind.Small, content="X1 / accessories"),
                                ]),
                                node(NodeKind.HeaderCell, children=[
                                    text("Products P2"),
                                    node(NodeKind.Small, content="B1 / books"),
                                ]),
                            ]),
                        ]),
                        node(NodeKind.TableBody, children=[
                            node(NodeKind.Row, children=[
                                node(NodeKind.HeaderCell, children=[
                                    text("Sales P0"),
                                    node(NodeKind.Small, children=[
                                        text("B1 / 25"),
                                        line_break(),
                                        text("G1 / 40"),
                                    ]),
                                ]),
                                node(NodeKind.Cell, children=[
                                    group([
                                        node(NodeKind.Bold, content="Task 0"),
                                        span("2 × 1"),
                                        node(NodeKind.Strong, content="2 output rows", style="jm-after-3"),
                                    ], style="jm-after-1"),
                                ], style="jm-pair-cell jm-pair-focus"),
                                node(NodeKind.Cell, children=[
                                    group([
                                        node(NodeKind.Bold, content="Task 1"),
                                        span("2 × 1"),

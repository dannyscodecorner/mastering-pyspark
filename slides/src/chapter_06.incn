pub def slide_section_6() -> Slide:
    return Slide(
        slug="section-6",
        title="Grouping, joining and aggregating",
        frame=Frame.Composed,
        styles="slide dark joins-cover joins-waterfall-cover joins-railway-cover",
        content=[
            image("assets/joins-railway-junction.png", "Railway tracks converging through a switching yard at dusk.", style="joins-waterfall-art"),
            group([
            text("06 / FOLLOWING THE FLOW OF DATA"),
        ], style="eyebrow"),
            group([
            span("06", attributes=[attr("aria-hidden", "true")]),
            rich_heading([
                text("Grouping,"),
                line_break(),
                text("joining &"),
                line_break(),
                text("aggregating"),
            ], level=1),
            prose("what Spark has to do behind the scenes", style="joins-waterfall-subtitle"),
        ], style="joins-waterfall-title"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("56"),
        ]),
        ],
        notes="Start with the familiar PySpark syntax, then recap the logical join types and grouping/aggregation calls. Assume the audience already knows relational joins. Ask: you know how to write this query, so why can it become expensive in Spark? Follow the data across workers through shuffle and skew, then explain the physical join strategies Spark can choose and how hints affect that choice. Return to the same report for partial aggregation and the product-version matching rule, and close with the single-server database comparison. The railway junction is cover artwork; the chapter uses literal records, partitions and workers to explain the mechanics. Distributed databases can face the same distribution costs; do not present these challenges as unique to Spark.",
    )

pub def slide_group_join_code() -> Slide:
    return Slide(
        slug="group-join-code",
        title="The code is simple",
        frame=Frame.Composed,
        styles="slide lesson-slide join-code-slide",
        content=[
            group([
            text("06 / GROUPING, JOINING & AGGREGATING"),
        ], style="eyebrow"),
            heading("The code is simple", level=1),
            group([
            group([
                heading("Start with the two inputs", level=2),
                code_block("""sales = spark.read.parquet("data/sales")
products = spark.read.parquet("data/products")"""),
            ]),
            group([
                heading("Join, group, then aggregate", level=2),
                code_block("""from pyspark.sql import functions as F

enriched = sales.join(
    products, on="product_id", how="left"
)

totals = (
    enriched
    .groupBy("category")
    .agg(F.sum("amount").alias("total"))
)
totals.show()"""),
            ]),
        ], style="join-code-grid"),
            paragraph([
            text("Result: "),
            strong("books 50"),
            text(" · "),
            strong("games 40"),
            text(" · "),
            strong("NULL 10"),
            span("M1 stays in the left join; its missing category forms the NULL group."),
        ], style="join-code-result"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("57"),
        ]),
        ],
        notes="Open the chapter with familiar syntax. Read two Parquet inputs, join on product_id, group by category and sum amount. Pause: the request takes only a few lines — what does Spark have to do to execute it across partitions? Establish the question before discussing movement, strategies or skew. Assume an existing SparkSession named spark. The product lookup has unique product_id values. No output ordering is guaranteed without orderBy. groupBy defines grouping keys; agg supplies the calculation. show is the action. A name-based equi-join emits one product_id column. This uses five sales from the joins example. X1 has no sale and does not appear in this left join. NULL category collects the unmatched M1 amount. The illustrative Parquet paths contain the same five sales and three products used throughout this chapter. Ask which operations may require records to move. Do not infer a physical strategy solely from this code; inspect the plan.",
    )

pub def slide_join_types() -> Slide:
    return Slide(
        slug="join-types",
        title="Choose which rows to keep",
        frame=Frame.Composed,
        styles="slide join-slide join-how",
        content=[
            group([
            text("06 / GROUPING, JOINING & AGGREGATING"),
        ], style="eyebrow"),
            heading("Choose which rows to keep", level=1),
            code_block("""enriched = sales.join(
    products, on="product_id", how="left"
)"""),
            group([
            group([
                span("how"),
                span("What the result contains"),
            ], style="jh-header"),
            group([
                code("\"inner\""),
                span("Matching pairs only"),
            ]),
            group([
                code("\"left\""),
                span("All sales; missing product values become NULL"),
            ]),
            group([
                code("\"right\""),
                span("All products; missing sale values become NULL"),
            ]),
            group([
                code("\"full\""),
                span("Matches and unmatched rows from both inputs"),
            ]),
            group([
                code("\"left_semi\""),
                span("Sales with a match; sales columns only"),
            ]),
            group([
                code("\"left_anti\""),
                span("Sales without a match; sales columns only"),
            ]),
        ], style="join-how-table"),
            group([
            node(NodeKind.Code, content="sales.crossJoin(products)", style="language-python"),
            node(NodeKind.Span, children=[
                strong("Cross:"),
                text(" every sales–product pair, without a matching condition."),
            ]),
        ], style="join-how-cross"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("58"),
        ]),
        ],
        notes="Adapted from the user's original corpus: Sections/Section 3 - Preparing Data using Spark SQL/3.4 - Grouping, Joining, and Aggregating - part 1.pptx, slide 4, Spark’s Join Types in a nutshell, and slides 5–11. Spend about 30–60 seconds here; assume familiarity and do not reopen the full join-semantics lesson. A is the left DataFrame, B the right. Inner is the default. Full/outer/full_outer are aliases, as are left/left_outer and right/right_outer. Semi returns qualifying left rows without right columns or multiplication by multiple right matches; anti returns nonmatching left rows. Cross is the Cartesian product. Cross is also supported as how=\"cross\"; omit the on condition for a Cartesian product, or use crossJoin as shown. The displayed how choices govern semantics, not physical join strategy. Outer joins fill missing-side values with NULL. Transition: we know which rows we want; now how do matching records on different workers meet?  Source verification: https://spark.apache.org/docs/latest/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrame.join.html",
    )

pub def slide_grouping_aggregates() -> Slide:
    return Slide(
        slug="grouping-aggregates",
        title="Group the rows. Calculate for each group.",
        frame=Frame.Composed,
        styles="slide join-slide aggregate-code",
        content=[
            group([
            text("06 / GROUPING, JOINING & AGGREGATING"),
        ], style="eyebrow"),
            heading("Group the rows. Calculate for each group.", level=1),
            group([
            group([
                heading("Continue with the joined sales", level=2),
                code_block("""totals = (
    enriched
    .groupBy("category")
    .agg(
        F.sum("amount").alias("total"),
        F.count("*").alias("sales_count"),
    )
)

totals.show()"""),
                paragraph([
                    text("Same "),
                    code("enriched"),
                    text(" DataFrame. Same five sales."),
                ], style="ag-context"),
            ]),
            group([
                heading("One result row per category", level=2),
                node(NodeKind.Table, children=[
                    node(NodeKind.TableHead, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="category"),
                            node(NodeKind.HeaderCell, content="total"),
                            node(NodeKind.HeaderCell, content="sales_count"),
                        ]),
                    ]),
                    node(NodeKind.TableBody, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="books"),
                            node(NodeKind.Cell, content="50"),
                            node(NodeKind.Cell, content="3"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="games"),
                            node(NodeKind.Cell, content="40"),
                            node(NodeKind.Cell, content="1"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="NULL"),
                            node(NodeKind.Cell, content="10"),
                            node(NodeKind.Cell, content="1"),
                        ]),
                    ]),
                ], style="ag-result"),
                group([
                    paragraph([
                        code("groupBy"),
                        span("Which rows belong together?"),
                    ]),
                    paragraph([
                        code("agg"),
                        span("What do we calculate for each group?"),
                    ]),
                    paragraph([
                        code("alias"),
                        span("What do we call the result columns?"),
                    ]),
                ], style="ag-roles"),
            ]),
        ], style="ag-code-layout"),
            paragraph([
            text("Other aggregate functions: "),
            code("avg"),
            text(" · "),
            code("min"),
            text(" · "),
            code("max"),
            text(" · "),
            code("countDistinct"),
        ], style="ag-bottom"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("59"),
        ]),
        ],
        notes="Inspired by the original corpus: Section 3, 3.5 Grouping, Joining, and Aggregating part 2, slides4,5,10, covering aggregate functions, GroupedData and aliases. Continue from enriched on the opening code slide; functions is already imported as F. Explain grouping keys first, then the two aggregate expressions and the names of their output columns. Three books sales25,15,10 sum to50; games40 has one sale; unmatched M1 has NULL category and amount10. Spark groups null category values together. count(\"*\") counts rows, including the row with NULL category; count(\"category\") would exclude null category values. groupBy returns GroupedData; agg returns a DataFrame. The table shows an illustrative order: show alone does not guarantee row order. Keep this explanation on semantics and syntax; do not discuss shuffle or partial aggregation yet. Close with: simple to write, but what happens when the required records live in different partitions?",
    )

pub def slide_join_shuffle() -> Slide:
    steps = [
        TeachingStep(label="Scattered inputs",
            heading="The code names two DataFrames. The workers each hold only a piece.",
            explanation="Sales and products are split into partitions; the matching records may be elsewhere.",
            cue_key="", numbered=false),
        TeachingStep(label="Find B1",
            heading="Which worker has all three B1 sales and their product category?",
            explanation="The sales are on all three workers. The matching product record is only on Worker C.",
            cue_key="", numbered=false),
        TeachingStep(label="Bring B1 together",
            heading="Bring the B1 sales and the B1 product record to one join task.",
            explanation="Some input is local. The other pieces must be fetched from other workers.",
            cue_key="", numbered=false),
        TeachingStep(label="Do it for every key",
            heading="One source can feed several destinations. A destination can need several sources.",
            explanation="That redistribution is the shuffle. What work is hidden inside these arrows?",
            cue_key="", numbered=false),
    ]

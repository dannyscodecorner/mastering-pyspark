                            text(" in books."),
                        ], style="jc-question"),
                        paragraph([
                            text("But every B1 sale can now match"),
                            line_break(),
                            strong("two product records"),
                            text("."),
                        ], style="jc-output-note"),
                    ], style="jc-state jc-p1"),
                    group([
                        heading("Six rows from the B1 sales", level=2),
                        node(NodeKind.Table, children=[
                            node(NodeKind.TableHead, children=[
                                node(NodeKind.Row, children=[
                                    node(NodeKind.HeaderCell, content="sale amount"),
                                    node(NodeKind.HeaderCell, content="version"),
                                    node(NodeKind.HeaderCell, content="category"),
                                ]),
                            ]),
                            node(NodeKind.TableBody, children=[
                                node(NodeKind.Row, children=[
                                    node(NodeKind.Cell, content="25"),
                                    node(NodeKind.Cell, content="current"),
                                    node(NodeKind.Cell, content="books"),
                                ], style="jc-books"),
                                node(NodeKind.Row, children=[
                                    node(NodeKind.Cell, content="25"),
                                    node(NodeKind.Cell, content="old"),
                                    node(NodeKind.Cell, content="books"),
                                ], style="jc-books jc-pair-old"),
                                node(NodeKind.Row, children=[
                                    node(NodeKind.Cell, content="15"),
                                    node(NodeKind.Cell, content="current"),
                                    node(NodeKind.Cell, content="books"),
                                ], style="jc-books"),
                                node(NodeKind.Row, children=[
                                    node(NodeKind.Cell, content="15"),
                                    node(NodeKind.Cell, content="old"),
                                    node(NodeKind.Cell, content="books"),
                                ], style="jc-books jc-pair-old"),
                                node(NodeKind.Row, children=[
                                    node(NodeKind.Cell, content="10"),
                                    node(NodeKind.Cell, content="current"),
                                    node(NodeKind.Cell, content="books"),
                                ], style="jc-books"),
                                node(NodeKind.Row, children=[
                                    node(NodeKind.Cell, content="10"),
                                    node(NodeKind.Cell, content="old"),
                                    node(NodeKind.Cell, content="books"),
                                ], style="jc-books jc-pair-old"),
                            ]),
                        ], style="jc-table jc-pairs"),
                        prose("B2, G1 and unmatched M1 still add one row each.", style="jc-small"),
                    ], style="jc-state jc-p2"),
                    group([
                        heading("Run the same aggregation", level=2),
                        node(NodeKind.Table, children=[
                            node(NodeKind.TableHead, children=[
                                node(NodeKind.Row, children=[
                                    node(NodeKind.HeaderCell, content="category"),
                                    node(NodeKind.HeaderCell, content="before"),
                                    node(NodeKind.HeaderCell, content="now"),
                                ]),
                            ]),
                            node(NodeKind.TableBody, children=[
                                node(NodeKind.Row, children=[
                                    node(NodeKind.Cell, content="books"),
                                    node(NodeKind.Cell, content="70"),
                                    node(NodeKind.Cell, content="120"),
                                ], style="jc-books jc-inflated"),
                                node(NodeKind.Row, children=[
                                    node(NodeKind.Cell, content="games"),
                                    node(NodeKind.Cell, content="40"),
                                    node(NodeKind.Cell, content="40"),
                                ], style="jc-games"),
                                node(NodeKind.Row, children=[
                                    node(NodeKind.Cell, content="NULL"),
                                    node(NodeKind.Cell, content="10"),
                                    node(NodeKind.Cell, content="10"),
                                ], style="jc-null"),
                            ]),
                        ], style="jc-table jc-totals"),
                        paragraph([
                            text("B1: 50 × 2 = 100; B2 adds 20."),
                            line_break(),
                            strong("Report total: 120 → 170"),

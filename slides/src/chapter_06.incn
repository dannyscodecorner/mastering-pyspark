                        ], style="jm-record jm-books jm-lookup-B1"),
                        group([
                            span("G1"),
                            span("games"),
                        ], style="jm-record jm-games jm-lookup-G1"),
                        group([
                            span("X1"),
                            span("accessories"),
                        ], style="jm-record jm-extra jm-lookup-X1"),
                    ], style="jm-broadcast-copy jm-after-2"),
                    span("→", style="jm-local-match-arrow jm-after-3", attributes=[attr("aria-hidden", "true")]),
                    group([

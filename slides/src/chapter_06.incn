                ], style="jm-broadcast-preparation"),
                group([
                    span("Original input partitions"),
                    span("Broadcast lookup in each executor"),
                    span("Joined rows"),
                ], style="jm-broadcast-labels"),
                group([
                    heading("Worker A", level=2),
                    group([
                        group([

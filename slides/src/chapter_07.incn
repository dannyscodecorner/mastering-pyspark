"""Editable Incan content migrated from the captured index.html."""

from surface import Attribute, Chapter, Frame, NodeKind, Slide, Surface, TeachingStep, attr, code, code_block, emphasis, group, heading, image, line_break, node, paragraph, prose, rich_heading, span, strong, text
from components import step_rail, step_cues

pub def slide_section_7() -> Slide:
    return Slide(
        slug="section-7",
        title="Structured Streaming",
        frame=Frame.Composed,
        styles="slide dark joins-waterfall-cover streaming-cover",
        content=[
            image("assets/joins-waterfalls.png", "Waterfalls flowing continuously into a deep teal pool.", style="joins-waterfall-art"),
            group([
            text("07 / STRUCTURED STREAMING"),
        ], style="eyebrow"),
            group([
            span("07", attributes=[attr("aria-hidden", "true")]),
            rich_heading([
                text("Structured"),
                line_break(),
                text("Streaming"),
            ], level=1),
        ], style="joins-waterfall-title"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("76"),
        ]),
        ],
        notes="The same DataFrame model, now with data that keeps arriving. Follow the original section 8.2 and 8.3 narrative: Spark SQL, the unbounded input table, the programming model, output modes, word count, sources and sinks, and converting and managing a query. The waterfall is chapter artwork, not a literal model of Spark execution.",
    )

pub def slide_streaming_model() -> Slide:
    return Slide(
        slug="streaming-model",
        title="Spark Structured Streaming",
        frame=Frame.Composed,
        styles="slide streaming-slide ",
        content=[
            group([
            text("07 / STRUCTURED STREAMING"),
        ], style="eyebrow"),
            heading("Spark Structured Streaming", level=1),
            prose("The DataFrame API for data that keeps arriving.", style="ss-lead"),
            group([
            group([
                span("THIS CHAPTER", style="ss-kicker"),
                rich_heading([
                    text("Structured"),
                    line_break(),
                    text("Streaming"),
                ], level=2),
                prose("DataFrames and Spark SQL"),
                code("pyspark.sql"),
            ], style="ss-api-current"),
            span("≠", style="ss-not-equal", attributes=[attr("aria-label", "is different from")]),
            group([
                span("THE OLDER API", style="ss-kicker"),
                rich_heading([
                    text("Spark"),
                    line_break(),
                    text("Streaming"),
                ], level=2),
                prose("DStreams, built on RDDs"),
                code("pyspark.streaming"),
            ], style="ss-api-legacy"),
        ], style="ss-api-comparison"),
            prose("We will keep using the DataFrame model we already know.", style="ss-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("77"),
        ]),
        ],
        notes="Original corpus: Section 8, 8.2 Spark Structured Streaming, slide 4–6 and 12. Keep the naming distinction brief. Spark Streaming is the older DStream API. Structured Streaming belongs to Spark SQL and uses DataFrames in PySpark. This is not a switch to DStreams. The older slide12 notes contained unrelated ML/MLlib text and are not reused. Overview: https://spark.apache.org/docs/4.2.0/streaming/index.html",
    )

pub def slide_streaming_conversion() -> Slide:
    return Slide(
        slug="streaming-conversion",
        title="From a batch DataFrame to a streaming DataFrame",
        frame=Frame.Composed,
        styles="slide streaming-slide ss-code-slide",
        content=[
            group([
            text("07 / STRUCTURED STREAMING"),
        ], style="eyebrow"),
            heading("From a batch DataFrame to a streaming DataFrame", level=1),
            group([
            group([
                heading("Batch", level=2),
                code_block("static_lines = spark.read.text(\"data/words\")", style="language-python"),
            ]),
            group([
                heading("Streaming", level=2),
                code_block("lines = spark.readStream.text(\"data/words\")", style="language-python"),
            ]),
        ], style="ss-readers"),
            group([
            code_block("""from pyspark.sql import functions as F

counts = (
    lines
    .select(
        F.explode(F.split("value", " "))
        .alias("word")
    )
    .groupBy("word")
    .count()
)""", style="language-python"),
            group([
                heading("The same word-count query", level=2),
                paragraph([
                    text("Each text line is a row in the "),
                    code("value"),
                    text(" column."),
                ]),
                prose("Split the line into words, then group and count them."),
                paragraph([
                    text("For the batch version, use "),
                    code("static_lines"),
                    text(" in the same pipeline."),
                ], style="ss-small"),
            ]),
        ], style="ss-conversion-body"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("78"),
        ]),
        ],
        notes="Original corpus: Section 8, 8.3 Managing and Converting Streams, slides2–4 and recording around03:00. Preserve the static/read versus streaming/readStream comparison and shared transformations. SparkSession spark is assumed from the earlier course setup. data/words contains prepared plain text files, each with the exact lines from the preceding word-count example. Text input has the fixed value string column, so no schema inference example is needed. Add each new file atomically and leave earlier files unchanged. For this controlled example words are separated by single spaces; this is not a general text tokenizer. Use static_lines for a bounded run and lines for a streaming run. Not every batch transformation has an equivalent supported streaming combination. https://spark.apache.org/docs/4.2.0/streaming/apis-on-dataframes-and-datasets.html API reference: https://spark.apache.org/docs/latest/api/python/reference/pyspark.ss/api/pyspark.sql.streaming.DataStreamReader.text.html Prepared input files and replay instructions: data/streaming-example.md.",
    )

pub def slide_streaming_sql() -> Slide:

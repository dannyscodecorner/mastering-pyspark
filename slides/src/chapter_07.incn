                node(NodeKind.SvgTitle, content="Batch and Structured Streaming share Spark SQL", attributes=[attr("id", "ss-engine-title")]),
                node(NodeKind.SvgDescription, content="Within the Spark SQL engine, a bounded batch input and ongoing streaming input use the DataFrame API and Catalyst query planning. A physical plan is executed as tasks on Spark executors. These are alternative query models, not two sources being joined together.", attributes=[attr("id", "ss-engine-desc")]),
                node(NodeKind.SvgDefinitions, children=[
                    node(NodeKind.SvgMarker, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M0 0 L10 5 L0 10Z"), attr("fill", "#557c98")]),

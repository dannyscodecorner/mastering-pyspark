pub def slide_streaming_state() -> Slide:
    return Slide(
        slug="streaming-state",
        title="A running count needs state",
        frame=Frame.Composed,
        styles="slide streaming-slide ss-state-slide",
        content=[
            group([
            text("07 / STRUCTURED STREAMING"),
        ], style="eyebrow"),
            heading("A running count needs state", level=1),
            paragraph([
            text("After Batch 3, the next "),
            code("dog"),
            text(" must continue from 4."),
        ], style="ss-time-intro"),
            group([
            group([
                heading("Counts retained after Batch 3", level=2),
                node(NodeKind.Table, children=[
                    node(NodeKind.Caption, content="Word counts retained between batches", style="sr-only"),
                    node(NodeKind.TableHead, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="word", attributes=[attr("scope", "col")]),
                            node(NodeKind.HeaderCell, content="count", attributes=[attr("scope", "col")]),
                        ]),
                    ]),
                    node(NodeKind.TableBody, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="cat", attributes=[attr("scope", "row")]),
                            node(NodeKind.Cell, content="2"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="dog", attributes=[attr("scope", "row")]),
                            node(NodeKind.Cell, content="4"),
                        ], style="ss-state-dog"),
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="owl", attributes=[attr("scope", "row")]),
                            node(NodeKind.Cell, content="2"),
                        ]),
                    ]),
                ], style="ss-state-table"),
                prose("Spark keeps aggregate state between batches.", style="ss-state-caption"),
            ]),
            group([
                group([
                    rich_heading([
                        text("Another "),
                        code("dog"),
                        text(" arrives"),
                    ], level=3),
                    paragraph([
                        text("Read the saved count, add 1, keep 5."),
                        line_break(),
                        text("The count does not need every earlier word record."),
                    ]),
                ]),
                group([
                    heading("More distinct words arrive", level=3),
                    paragraph([
                        text("Each new word needs its own count."),
                        line_break(),
                        text("The number of retained keys can keep growing."),
                    ]),
                ]),
                group([
                    heading("Sending output does not clear this state", level=3),
                    prose("Update and Complete still need these counts for the next batch."),
                ]),
            ], style="ss-state-cases"),
        ], style="ss-state-grid"),
            paragraph([
            text("When can Spark forget an old count?"),
            line_break(),
            span("For counts over a time interval, we first need to define which time matters."),
        ], style="ss-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("92"),
        ]),
        ],
        notes="""Return to the original running word count after examining the rows each output mode sends. Its state is the current count for each observed word, logically partitioned across the executors. This is not a single driver table or an input-history buffer. Another dog changes 4 to 5; the other two entries remain. More records for the same three keys do not require three new entries every batch. New distinct words add keys. An unwindowed aggregation has no event-time boundary that lets Spark forget one of these word counts. State consumes resources, and checkpointing protects it for recovery, as explained later. Spark may still retain source files or progress metadata separately; the claim about not retaining every word concerns the aggregate state needed to update this count. Use the question at the bottom to change the business question explicitly: next we count all words per ten-minute interval rather than each word across the lifetime of the query.

https://spark.apache.org/docs/4.2.0/streaming/apis-on-dataframes-and-datasets.html#state-store""",
    )

pub def slide_streaming_event_time() -> Slide:
    return Slide(
        slug="streaming-event-time",
        title="Count words by when they happened",
        frame=Frame.Composed,
        styles="slide streaming-slide ss-window-slide",
        content=[
            group([
            text("07 / STRUCTURED STREAMING"),
        ], style="eyebrow"),
            heading("Count words by when they happened", level=1),
            paragraph([
            text("Now each word has an "),
            code("event_time"),
            text(" timestamp. Count all words per ten-minute interval."),
        ], style="ss-time-intro"),
            node(NodeKind.Preformatted, children=[
            code("""window_counts = events.groupBy(
    F.window("event_time", "10 minutes")
).count()"""),
        ], style="language-python ss-window-query"),
            group([
            group([
                heading("Input in arrival order", level=2),
                node(NodeKind.Table, children=[
                    node(NodeKind.Caption, content="Four word events, including a delayed cat record", style="sr-only"),
                    node(NodeKind.TableHead, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="Arrival", attributes=[attr("scope", "col")]),
                            node(NodeKind.HeaderCell, content="event_time", attributes=[attr("scope", "col")]),
                            node(NodeKind.HeaderCell, content="word", attributes=[attr("scope", "col")]),
                        ]),
                    ]),
                    node(NodeKind.TableBody, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="1"),
                            node(NodeKind.Cell, content="12:01"),
                            node(NodeKind.Cell, content="cat"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="2"),
                            node(NodeKind.Cell, content="12:04"),
                            node(NodeKind.Cell, content="dog"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="3"),
                            node(NodeKind.Cell, content="12:12"),
                            node(NodeKind.Cell, content="owl"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="4 · late"),
                            node(NodeKind.Cell, content="12:03"),
                            node(NodeKind.Cell, content="cat"),
                        ], style="ss-late-word"),
                    ]),
                ], style="ss-timed-events"),
            ]),
            group([
                heading("Counts after these arrivals", level=2),
                node(NodeKind.DefinitionList, children=[
                    group([
                        node(NodeKind.Term, content="12:00–12:10"),
                        node(NodeKind.Definition, children=[
                            span("2 → "),
                            text("3"),
                        ]),
                    ]),
                    group([
                        node(NodeKind.Term, content="12:10–12:20"),
                        node(NodeKind.Definition, content="1"),
                    ]),
                ], style="ss-window-totals"),
                paragraph([
                    text("The late cat belongs to the first window."),
                    line_break(),
                    text("Window start is included, end is excluded."),
                ], style="ss-window-note"),
            ]),
        ], style="ss-window-grid"),
            prose("Event time is when the event happened. Processing time is when Spark handles it.", style="ss-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("93"),
        ]),
        ],
        notes="""Explicitly introduce a new timestamped example. The original text source had only value; it did not contain event_time. Here events is a streaming DataFrame with event_time TIMESTAMP and word STRING. For a Parquet source, the reader would be events = spark.readStream.schema("event_time TIMESTAMP, word STRING").parquet("data/timed-words"). This path and the timestamped rows are illustrative, separate from the supplied plain-text word-count files. No new Spark run or timed Parquet fixture is claimed. All displayed times share the same date and session time zone. F is the functions alias introduced earlier. This query counts rows per tumbling ten-minute event-time window, not per word. Adding word to groupBy would instead count each word within each interval. No watermark has been configured yet, so old windows can continue to change and their state is retained. A window alone does not make a count final.

Read the arrivals in order. Cat at12:01 and dog at12:04 make two events in the first interval. Owl at12:12 belongs to the next. The last-arriving cat carries event time12:03, so it raises the earlier interval to3. The arrival index is explanatory ordering, not an extra source column or a batch number. Late means event-time order differs from arrival order; it does not mean invalid. The displayed totals are aggregate state after the arrivals. If publishing the evolving result, this no-watermark query can use Update with a compatible sink. Now ask how long Spark should keep accepting changes to that older interval.

https://spark.apache.org/docs/latest/api/python/reference/pyspark.sql/api/pyspark.sql.functions.window.html
https://spark.apache.org/docs/4.2.0/streaming/apis-on-dataframes-and-datasets.html#handling-late-data-and-watermarking""",
    )

pub def slide_streaming_watermarks() -> Slide:
    return Slide(
        slug="streaming-watermarks",
        title="When can an old window close?",
        frame=Frame.Composed,
        styles="slide streaming-slide ss-watermark-slide",
        content=[
            group([
            text("07 / STRUCTURED STREAMING"),
        ], style="eyebrow"),
            heading("When can an old window close?", level=1),
            group([
            group([
                node(NodeKind.Preformatted, children=[
                    code("""window_counts = (
    events
    .withWatermark("event_time", "10 minutes")
    .groupBy(
        F.window("event_time", "10 minutes")
    )
    .count()
)"""),
                ], style="language-python"),
                paragraph([
                    text("This run uses "),
                    code(".outputMode(\"append\")"),
                    text("."),
                    line_break(),
                    text("It publishes a window once its count is final."),
                ], style="ss-watermark-output"),
            ]),
            group([
                heading("Later, event time reaches 12:21", level=2),
                node(NodeKind.DefinitionList, children=[
                    group([
                        node(NodeKind.Term, content="Greatest event time observed"),
                        node(NodeKind.Definition, content="12:21"),
                    ]),
                    group([
                        node(NodeKind.Term, content="Allowed delay"),
                        node(NodeKind.Definition, content="− 10 min"),
                    ]),
                    group([
                        node(NodeKind.Term, content="Watermark advances to"),
                        node(NodeKind.Definition, content="12:11"),
                    ]),
                ], style="ss-watermark-math"),
                group([
                    strong("12:00–12:10 · count 3"),
                    span("Once Spark applies that watermark:"),
                    span("Publish the final count and remove its state."),
                ], style="ss-final-window"),
                prose("A later arrival for this closed window will no longer revise its count.", style="ss-watermark-late"),
            ], style="ss-watermark-example"),
        ], style="ss-watermark-grid"),
            paragraph([
            text("The watermark follows event-time progress, not the wall clock."),
            line_break(),
            span("A longer delay allows more late data, but keeps state longer and delays final Append results."),
        ], style="ss-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("94"),
        ]),
        ],
        notes="""This is an alternative run of the timestamped query, configured before start, with a ten-minute delay and Append output. It is not an in-place edit to a running query. Return to the first interval whose count became3. The late12:03 cat was nine minutes behind the then-greatest observed time12:12, inside this allowance. Later input with event time12:21 permits the single-stream watermark to advance to12:11. Once that watermark is applied in a subsequent micro-batch and the first window is finalized, Append emits count3 and its aggregation state can be removed. A future event for that already-closed window cannot revise the published count. The new12:21 event belongs to a later window, omitted from this close-up.

Do not equate the window width with the watermark delay: both happen to be ten minutes here, but they are separate settings. Window width defines groups; delay defines lateness tolerance relative to observed event time. Watermark advancement and cleanup happen through query execution, not at an exact wall-clock instant. Idle input may leave a window open. Data within the threshold is guaranteed inclusion; data beyond it may or may not be processed, depending on watermark/state progress. Do not teach the delay as a universal exact cutoff for individual records.

withWatermark must precede the aggregation and use its event-time column. Append waits for finality, Update can publish provisional counts before cleanup, and Complete retains all aggregate groups instead of cleaning them up this way. Return to these distinctions in the following compatibility table. The state-store backend and multiple-input watermark policies are outside this single-stream example.

https://spark.apache.org/docs/latest/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrame.withWatermark.html
https://spark.apache.org/docs/4.2.0/streaming/apis-on-dataframes-and-datasets.html#conditions-for-watermarking-to-clean-aggregation-state""",
    )

pub def slide_streaming_output_compatibility() -> Slide:
    return Slide(
        slug="streaming-output-compatibility",
        title="Which output modes can the query use?",
        frame=Frame.Composed,
        styles="slide streaming-slide ss-output-compat",
        content=[
            group([
            text("07 / STRUCTURED STREAMING"),
        ], style="eyebrow"),
            heading("Which output modes can the query use?", level=1),
            prose("Micro-batch execution · common query shapes in Apache Spark 4.2", style="ss-output-scope"),
            node(NodeKind.Table, children=[
            node(NodeKind.Caption, content="Output-mode compatibility for representative micro-batch queries", style="sr-only"),
            node(NodeKind.Columns, children=[
                node(NodeKind.Column, attributes=[attr("style", "width:568px")]),
                node(NodeKind.Column),
                node(NodeKind.Column),
                node(NodeKind.Column),
            ]),
            node(NodeKind.TableHead, children=[
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Query", attributes=[attr("scope", "col")]),
                    node(NodeKind.HeaderCell, content="Append", attributes=[attr("scope", "col")]),
                    node(NodeKind.HeaderCell, content="Update", attributes=[attr("scope", "col")]),
                    node(NodeKind.HeaderCell, content="Complete", attributes=[attr("scope", "col")]),
                ]),
            ]),
            node(NodeKind.TableBody, children=[
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, children=[
                        text("select / filter"),
                        span("No aggregation"),
                    ], attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="Yes"),
                    node(NodeKind.Cell, content="Yes"),
                    node(NodeKind.Cell, content="No", style="ss-output-no"),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, children=[
                        text("Running word count"),
                        span("No time window"),
                    ], attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="No", style="ss-output-no"),
                    node(NodeKind.Cell, content="Yes"),
                    node(NodeKind.Cell, content="Yes"),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, children=[
                        text("Windowed count + watermark"),
                        span("Tumbling or sliding event-time window"),
                    ], attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="Yes"),
                    node(NodeKind.Cell, content="Yes"),
                    node(NodeKind.Cell, content="Yes"),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, children=[
                        text("Stream–stream join"),
                        span("A supported join and condition"),
                    ], attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="Yes"),
                    node(NodeKind.Cell, content="No", style="ss-output-no"),
                    node(NodeKind.Cell, content="No", style="ss-output-no"),
                ]),
            ]),
        ], style="ss-output-compat-table"),
            paragraph([
            text("The query, sink and execution mode must all support the choice."),
            line_break(),
            span("Real-time mode currently supports Update only."),
        ], style="ss-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("95"),
        ]),
        ],
        notes="""This is a focused compatibility check, not every combination of stateful operators. The window row assumes withWatermark precedes the aggregation on the same event-time column. Session windows and custom stateful APIs have additional restrictions. Append and Update emit equivalent rows for the simple stateless example. Unsupported choices fail validation; Spark does not quietly change modes.

Append waits until event-time progress finalizes a window. Update can publish provisional counts and later revise them. Complete keeps all aggregate groups, including older windows. Refer back to the late cat and the finalized12:00–12:10 window. Complete retains older groups; it does not get the same state cleanup as Append or Update.

Sink support is a separate check, shown on the upcoming sink slide. Output mode alone does not establish retry or delivery guarantees. Real-time's current Update-only restriction is independent of this micro-batch table; runtime operator support must also be checked.

Query compatibility: https://spark.apache.org/docs/4.2.0/streaming/apis-on-dataframes-and-datasets.html#output-modes
Window finality and cost: https://docs.databricks.com/aws/en/structured-streaming/output-mode
Real-time restriction: https://docs.databricks.com/aws/en/structured-streaming/real-time/reference#execution-modes ; https://apache.github.io/spark/streaming/real-time-mode.html#requirements (in-progress documentation)""",
    )

pub def slide_streaming_output_recap() -> Slide:
    return Slide(
        slug="streaming-output-recap",
        title="Output modes: recap",
        frame=Frame.Composed,
        styles="slide streaming-slide ss-output-recap",
        content=[
            group([
            text("07 / STRUCTURED STREAMING"),
        ], style="eyebrow"),
            heading("Output modes: recap", level=1),
            group([
            group([
                span("01"),
                heading("Complete", level=2),
                prose("The whole current result, including unchanged rows."),
            ]),
            group([
                span("02"),
                heading("Append", level=2),
                prose("Only new, final rows. This is the default."),
            ]),
            group([
                span("03"),
                heading("Update", level=2),
                prose("Only new or updated result rows, carrying their new values."),
            ]),
        ], style="ss-recap"),
            prose("The output mode selects rows. The sink decides how they are stored.", style="ss-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("96"),
        ]),
        ],
        notes="""Close the output-mode explanation before introducing sources and sinks. Complete repeats the current result; Append adds final rows; Update emits the rows the query updated, with their new values. Update is not a delta and does not automatically merge a destination table. Complete is not a universal instruction to overwrite a destination.

The mode must be supported by the query, execution mode and chosen sink. The examples here used micro-batch execution; Real-time currently requires Update. Ask which rows would be sent after the third word-count batch, then move on to where input comes from and where output goes.
https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.ss/api/pyspark.sql.streaming.DataStreamWriter.outputMode.html
https://spark.apache.org/docs/4.2.0/streaming/apis-on-dataframes-and-datasets.html#output-modes""",
    )


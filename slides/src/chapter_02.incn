                        node(NodeKind.SvgCircle, attributes=[attr("cx", "1103"), attr("cy", "140"), attr("r", "6")]),
                        node(NodeKind.SvgCircle, attributes=[attr("cx", "1092"), attr("cy", "189"), attr("r", "6")]),
                        node(NodeKind.SvgCircle, attributes=[attr("cx", "1030"), attr("cy", "190"), attr("r", "6")]),
                    ], attributes=[attr("stroke", "#ddb68c"), attr("fill", "#3d3028")]),
                    node(NodeKind.SvgText, content="GraphX", style="cmp-heading", attributes=[attr("x", "1024"), attr("y", "232")]),
                    node(NodeKind.SvgText, content="Graph processing", style="cmp-sub", attributes=[attr("x", "1024"), attr("y", "268")]),
                    node(NodeKind.SvgText, content="and analytics", style="cmp-sub", attributes=[attr("x", "1024"), attr("y", "298")]),
                    node(NodeKind.SvgPath, attributes=[attr("d", "M338 348V372M826 348V372M1142 348V372"), attr("stroke", "#9aacc0"), attr("fill", "none")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "20"), attr("y", "372"), attr("width", "1268"), attr("height", "96"), attr("rx", "12"), attr("fill", "#332c44"), attr("stroke", "#a78cbd")]),
                    node(NodeKind.SvgText, content="Spark Core", style="cmp-heading", attributes=[attr("x", "48"), attr("y", "414")]),
                    node(NodeKind.SvgText, content="Distributed execution engine", style="cmp-sub", attributes=[attr("x", "48"), attr("y", "446")]),
                    node(NodeKind.SvgText, content="Task scheduling · memory management", style="cmp-sub", attributes=[attr("x", "584"), attr("y", "414")]),
                    node(NodeKind.SvgText, content="Fault tolerance · distributed data", style="cmp-sub", attributes=[attr("x", "584"), attr("y", "446")]),
                ], attributes=[attr("stroke-width", "2")]),
            ], attributes=[attr("viewBox", "0 0 1308 480"), attr("role", "img"), attr("aria-labelledby", "components-title components-desc")]),
        ], style="components-stack"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("24"),
        ]),
        ],
        notes="""That is how Spark developed. Here is what we mean by Spark today. Start at the foundation: Spark Core handles distributed execution. Above it, Spark SQL gives us structured data and DataFrames. Structured Streaming is built on Spark SQL: show its position inside that box. MLlib and GraphX complete the overview; they are context, not additional course topics. Python reaches SQL, Structured Streaming and MLlib through PySpark. The Python band intentionally stops before GraphX, whose API is Scala. This is a capability map, not a call sequence or a complete API inventory; PySpark also exposes the RDD API. Legacy DStream Spark Streaming is omitted in favour of Structured Streaming. Transition: These capabilities share the same engine. Now let’s look at how we represent the data that engine works on.
Sources: https://spark.apache.org/streaming/ ; https://spark.apache.org/docs/latest/graphx-programming-guide.html ; https://spark.apache.org/docs/latest/ml-guide.html""",
    )

pub def slide_spark_history_recap() -> Slide:
    return Slide(
        slug="spark-history-recap",
        title="Introducing Spark: recap",
        frame=Frame.Composed,
        styles="slide chapter-recap",
        content=[
            group([
            text("02 / INTRODUCING SPARK"),
        ], style="eyebrow"),
            heading("Introducing Spark: recap", level=1),
            node(NodeKind.Table, children=[
            node(NodeKind.Caption, content="Introducing Spark: recap: key takeaways", style="sr-only"),
            node(NodeKind.Columns, children=[
                node(NodeKind.Column),
                node(NodeKind.Column),
            ]),
            node(NodeKind.TableBody, children=[
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Data reuse", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="Spark grew from the need to reuse working data across iterative and interactive computations."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Structured queries", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="DataFrames add schemas and expressions that Spark SQL can analyse and optimise."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Shared engine", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="SQL, Structured Streaming and machine learning use the same distributed foundation."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Newer capabilities", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="AQE adapts plans using runtime information. Spark Connect lets a remote client submit query plans."),
                ]),
            ]),
        ], style="chapter-recap-table"),
            prose("DataFrames and Spark SQL are the main interfaces we will use.", style="chapter-recap-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("25"),
        ]),
        ],
        notes="""Close the history on the reasons behind the evolution, rather than asking the audience to memorise release dates. Spark adds reusable working data, structured query optimisation and broader ways to use the engine. Persistence is optional; this is not a claim that every computation stays in memory.

https://spark.apache.org/history
https://www.usenix.org/conference/hotcloud-10/spark-cluster-computing-working-sets
https://spark.apache.org/docs/4.2.0/sql-programming-guide.html
https://spark.apache.org/docs/4.2.0/sql-performance-tuning.html
https://spark.apache.org/docs/4.2.0/spark-connect-overview.html""",
    )

pub def chapter_02_chapter() -> Chapter:
    return Chapter(number="2", title="02 / INTRODUCING SPARK", first_page=1, slides=[
        slide_history_intro(),
        slide_hadoop_prompt(),
        slide_history(),
        slide_history_hadoop(),
        slide_history_spark_begins(),
        slide_history_open_source(),
        slide_history_apache(),
        slide_history_1(),
        slide_history_dataframes(),
        slide_history_2(),
        slide_history_modern(),
        slide_history_connect(),
        slide_history_4(),
        slide_history_current(),
        slide_spark_components(),
        slide_spark_history_recap(),
    ])

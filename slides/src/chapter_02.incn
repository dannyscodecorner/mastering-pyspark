            node(NodeKind.Figure, children=[
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgTitle, content="Spark’s main components", attributes=[attr("id", "components-title")]),
                node(NodeKind.SvgDescription, content="PySpark provides Python access to Spark SQL, Structured Streaming and MLlib. Structured Streaming builds on Spark SQL. GraphX uses Scala. All share Spark’s distributed execution engine.", attributes=[attr("id", "components-desc")]),

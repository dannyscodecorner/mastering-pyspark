                    node(NodeKind.SvgText, content="at scale", style="cmp-sub", attributes=[attr("x", "708"), attr("y", "298")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "996"), attr("y", "112"), attr("width", "292"), attr("height", "236"), attr("rx", "14"), attr("fill", "#3d3028"), attr("stroke", "#ae825e")]),
                    node(NodeKind.SvgText, content="SCALA API", style="cmp-small", attributes=[attr("x", "1024"), attr("y", "67")]),
                    node(NodeKind.SvgGroup, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M1035 147L1067 168L1103 140M1067 168L1092 189M1067 168L1030 190")]),
                        node(NodeKind.SvgCircle, attributes=[attr("cx", "1035"), attr("cy", "147"), attr("r", "6")]),

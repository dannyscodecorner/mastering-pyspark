pub def slide_glue_recap() -> Slide:
    return Slide(
        slug="glue-recap",
        title="Spark in AWS Glue: recap",
        frame=Frame.Composed,
        styles="slide chapter-recap recap-draft",
        content=[
            group([
            text("09 / SPARK IN AWS GLUE"),
        ], style="eyebrow"),
            heading("Spark in AWS Glue: recap", level=1),
            prose("Draft recap · chapter 09 is still an outline", style="recap-status"),
            node(NodeKind.Table, children=[
            node(NodeKind.Columns, children=[
                node(NodeKind.Column),
                node(NodeKind.Column),
            ]),
            node(NodeKind.TableBody, children=[
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Runtime", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="Match the code and dependencies to the Glue runtime selected for the job."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Workers", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="Connect the worker configuration to the driver, executors and tasks."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Data access", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="Check the catalog, connectors and permissions needed by the job."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Diagnosis", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="Use the Spark UI to connect a slow Glue run to its stages, tasks and data movement."),
                ]),
            ]),
        ], style="chapter-recap-table"),
            prose("Apply the same questions about execution, correctness and performance to the Glue job.", style="chapter-recap-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("122"),
        ]),
        ],
        notes="""Draft closing points for chapter 09. Revisit after the Glue job and Spark UI walkthroughs are built. These points apply the earlier Spark material to the selected Glue environment. Verify exact runtime versions, worker behaviour, access policies and console steps when developing the demonstrations. Recovery coverage remains in the Glue overview and needs a workload-specific example.
https://docs.aws.amazon.com/glue/latest/dg/monitor-spark-ui.html""",
    )


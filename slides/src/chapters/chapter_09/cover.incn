"""Cover slide."""

from surface import Frame, NodeKind, Slide, group, line_break, node, prose, rich_heading, span, text

pub def slide_section_9() -> Slide:
    return Slide(
        slug="section-9",
        title="Spark in AWS Glue",
        frame=Frame.Composed,
        styles="slide dark",
        content=[
            group([
            text("09 / SPARK IN AWS GLUE"),
        ], style="eyebrow"),
            group([
            span("09", style="chapter-number"),
            group([
                rich_heading([
                    text("Spark in"),
                    line_break(),
                    text("AWS Glue"),
                ], level=1),
                prose("Running and monitoring Spark applications in AWS Glue"),
            ]),
        ], style="divider"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("118"),
        ]),
        ],
        notes="Bring the course together by applying the Spark execution model, query reasoning and streaming concepts to AWS Glue. This is a separate final chapter, following the general Working with PySpark material. The next two slides are retained content outlines for development, not completed demonstrations.",
    )

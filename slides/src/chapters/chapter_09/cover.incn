"""Cover slide."""

from surface import Frame, NodeKind, Slide, group, line_break, node, prose, rich_heading, span, text

pub def slide_section_9() -> Slide:
    return Slide(
        slug="section-9",
        title="Running Spark in Production",
        frame=Frame.Composed,
        styles="slide dark",
        content=[
            group([
            text("09 / RUNNING SPARK IN PRODUCTION"),
        ], style="eyebrow"),
            group([
            span("09", style="chapter-number"),
            group([
                rich_heading([
                    text("Running Spark"),
                    line_break(),
                    text("in Production"),
                ], level=1),
                prose("A brief look at deployment, dependencies, access and monitoring"),
            ]),
        ], style="divider"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("118"),
        ]),
        ],
        notes="Use this chapter as a brief orientation to what changes when the lab pipeline runs in production: runtime and dependency choices, resources, data access, monitoring and recovery. AWS Glue is a concrete example within the wider topic. A separate live demonstration can show how these concerns appear in one environment. The detailed walkthroughs remain outlines; do not try to teach every operational detail in this session.",
    )

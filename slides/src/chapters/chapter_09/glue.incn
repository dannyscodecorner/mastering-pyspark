"""Glue slide."""

from surface import Frame, NodeKind, Slide, group, heading, node, span, text

pub def slide_glue() -> Slide:
    return Slide(
        slug="glue",
        title="Spark in AWS Glue",
        frame=Frame.Composed,
        styles="slide ",
        content=[
            group([
            text("09 / RUNNING SPARK IN PRODUCTION"),
        ], style="eyebrow"),
            heading("Spark in AWS Glue", level=1),
            node(NodeKind.OrderedList, children=[
            node(NodeKind.ListItem, children=[
                span("01"),
                text("Glue jobs, workers and the driver/executor model"),
            ]),
            node(NodeKind.ListItem, children=[
                span("02"),
                text("Glue runtime versions versus local Spark"),
            ]),
            node(NodeKind.ListItem, children=[
                span("03"),
                text("GlueContext, DynamicFrames and DataFrames"),
            ]),
            node(NodeKind.ListItem, children=[
                span("04"),
                text("Catalogs, connectors and data access"),
            ]),
            node(NodeKind.ListItem, children=[
                span("05"),
                text("AQE versus resource scaling; progress and monitoring"),
            ]),
            node(NodeKind.ListItem, children=[
                span("06"),
                text("Streaming, checkpoints, bookmarks and recovery"),
            ]),
        ], style="topic-list"),
            span("CONTENT SKELETON", style="draft-label"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("121"),
        ]),
        ],
        notes="AWS Glue is one concrete deployment example within Running Spark in Production. Reuse the earlier query and execution vocabulary to orient a separate live walkthrough around runtime, workers, dependencies, data access and monitoring. Keep this short in the current session. Runtime-specific claims remain to be verified against the chosen environment.",
    )

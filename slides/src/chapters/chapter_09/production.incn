"""Production slide."""

from surface import Frame, NodeKind, Slide, group, heading, node, span, text

pub def slide_production() -> Slide:
    return Slide(
        slug="production",
        title="Running Spark in Production",
        frame=Frame.Composed,
        styles="slide ",
        content=[
            group([
            text("09 / RUNNING SPARK IN PRODUCTION"),
        ], style="eyebrow"),
            heading("Running Spark in Production", level=1),
            node(NodeKind.OrderedList, children=[
            node(NodeKind.ListItem, children=[
                span("01"),
                text("Launching an application and placing the driver"),
            ]),
            node(NodeKind.ListItem, children=[
                span("02"),
                text("Packaging Python and other dependencies"),
            ]),
            node(NodeKind.ListItem, children=[
                span("03"),
                text("Remote execution interfaces and configuration"),
            ]),
            node(NodeKind.ListItem, children=[
                span("04"),
                text("Monitoring, diagnosis and scaling decisions"),
            ]),
            node(NodeKind.ListItem, children=[
                span("05"),
                text("Reruns, reliable output and deployment environments"),
            ]),
        ], style="topic-list"),
            span("CONTENT SKELETON", style="draft-label"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("120"),
        ]),
        ],
        notes="Use the chapter08 pipeline to introduce the decisions needed in a production environment: how to launch it, package dependencies, configure execution, monitor progress and recover. Keep this a brief overview. AWS Glue can illustrate those decisions in a separate demonstration; the detailed operational walkthrough remains to be developed.",
    )

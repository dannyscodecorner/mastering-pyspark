"""Join skew slide."""

from surface import Frame, NodeKind, Slide, TeachingStep, attr, group, heading, node, prose, span, text
from components import step_rail, step_cues

pub def slide_join_skew() -> Slide:
    steps = [
        TeachingStep(label="Spot the long tail",
            heading="One overloaded channel holds up the stage.",
            explanation="That task handles more data and may spill to disk while other tasks have already finished.",
            cue_key="", numbered=false),
        TeachingStep(label="Explain the imbalance",
            heading="More partitions do not automatically spread a hot key.",
            explanation="Also check duplicate keys: a many-to-many join can create a large output even from modest inputs.",
            cue_key="", numbered=false),
        TeachingStep(label="Adapt when eligible",
            heading="AQE can mitigate skew in supported shuffle joins.",
            explanation="Filter or reduce unnecessary input first; treat salting as a targeted technique, not a default fix.",
            cue_key="", numbered=false),
    ]
    return Slide(
        slug="join-skew",
        title="One hot key can hold up the stage",
        frame=Frame.Composed,
        styles="slide lesson-slide join-slide",
        content=[
            group([
            text("06 / GROUPING, JOINING & AGGREGATING"),
        ], style="eyebrow"),
            heading("One hot key can hold up the stage", level=1),
            group([
            step_rail(steps),
            group([
                group([
                    group([
                        prose("Same sales model, now at production scale", style="join-label"),
                        heading("Four channels. Uneven traffic.", level=2),
                        node(NodeKind.Svg, children=[
                            node(NodeKind.SvgText, content="P0", attributes=[attr("x", "5"), attr("y", "55")]),
                            node(NodeKind.SvgPath, style="canal-bank", attributes=[attr("d", "M88 48 C250 30 400 64 620 48")]),
                            node(NodeKind.SvgPath, style="canal-water", attributes=[attr("d", "M88 48 C250 30 400 64 620 48")]),
                            node(NodeKind.SvgPath, style="water-flow", attributes=[attr("d", "M88 48 C250 30 400 64 620 48")]),
                            node(NodeKind.SvgGroup, children=[
                                node(NodeKind.SvgRectangle, attributes=[attr("x", "110"), attr("y", "35"), attr("width", "42"), attr("height", "26"), attr("rx", "5")]),
                                node(NodeKind.SvgText, content="B1", attributes=[attr("x", "118"), attr("y", "53")]),
                            ], style="cargo"),
                            node(NodeKind.SvgGroup, children=[

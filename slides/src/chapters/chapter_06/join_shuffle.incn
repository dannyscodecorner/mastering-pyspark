                        node(NodeKind.SvgPath, style="ss-route", attributes=[attr("pathLength", "1"), attr("d", "M550 192 H694 Q702 192 702 184 V110 Q702 102 710 102 H872")]),
                        node(NodeKind.SvgPath, style="ss-route", attributes=[attr("pathLength", "1"), attr("d", "M550 298 H742 Q750 298 750 290 V126 Q750 118 758 118 H872")]),
                        node(NodeKind.SvgText, content="local", attributes=[attr("x", "608"), attr("y", "71")]),
                        node(NodeKind.SvgText, content="remote", attributes=[attr("x", "765"), attr("y", "147")]),
                    ], style="ss-b1-routes"),
                    node(NodeKind.SvgGroup, children=[
                        node(NodeKind.SvgPath, style="ss-route ss-route-muted", attributes=[attr("pathLength", "1"), attr("d", "M550 108 H622 Q630 108 630 116 V208 Q630 216 638 216 H872")]),
                        node(NodeKind.SvgPath, style="ss-route ss-route-muted", attributes=[attr("pathLength", "1"), attr("d", "M550 210 H650 Q658 210 658 218 V320 Q658 328 666 328 H872")]),
                        node(NodeKind.SvgPath, style="ss-route ss-route-muted", attributes=[attr("pathLength", "1"), attr("d", "M550 232 H872")]),

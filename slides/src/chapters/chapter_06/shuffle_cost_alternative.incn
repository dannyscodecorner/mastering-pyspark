            group([
                group([
                    text("Input partitions"),
                ], style="scb-column scb-column-input"),
                group([
                    text("Partition · encode · write"),
                ], style="scb-column scb-column-write"),
                group([
                    span("Fetch · decode", style="scb-read-label"),
                    span("Match the two inputs locally", style="scb-join-label"),
                ], style="scb-column scb-column-read"),
                group([
                    heading("Worker A", level=2),

"""Shuffle cost alternative slide."""

from surface import Frame, NodeKind, Slide, TeachingStep, attr, code, group, heading, line_break, node, paragraph, prose, rich_heading, span, strong, text
from components import step_rail, step_cues

pub def slide_shuffle_cost_alternative() -> Slide:
    steps = [
        TeachingStep(label="Scattered inputs",
            heading="A join task needs the relevant records from both DataFrames.",
            explanation="Follow the same inputs from the previous slide, including B1/books on Worker C.",
            cue_key="", numbered=false),
        TeachingStep(label="Prepare the blocks",
            heading="The source tasks prepare blocks for the destination partitions.",
            explanation="Both sides are partitioned, encoded and written as intermediate shuffle output.",
            cue_key="", numbered=false),
        TeachingStep(label="Fetch & decode",
            heading="Each destination fetches its contributions, then decodes the records.",
            explanation="Watch all three B1 sales and B1/books arrive at partition 0.",
            cue_key="", numbered=false),
        TeachingStep(label="Join locally",
            heading="Now each task can join its corresponding sales and products.",
            explanation="Five sales emerge: books 25, 15, 10 · games 40 · NULL 10.",
            cue_key="", numbered=false),
        TeachingStep(label="Why it costs",
            heading="Getting those inputs together added work across the cluster.",
            explanation="More bytes mean more I/O. Uneven destinations can leave one task working long after the others.",
            cue_key="", numbered=false),
    ]
    return Slide(
        slug="shuffle-cost-alternative",
        title="The shuffle is work across the cluster",
        frame=Frame.Composed,
        styles="slide lesson-slide join-slide shuffle-cluster-slide",
        content=[
            group([
            text("06 / GROUPING, JOINING & AGGREGATING"),
        ], style="eyebrow"),
            heading("The shuffle is work across the cluster", level=1),
            group([
            step_rail(steps),
            group([
                code("sales.join(products, on=\"product_id\", how=\"left\")"),

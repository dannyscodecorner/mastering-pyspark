"""Dataframe example slide."""

from surface import Frame, NodeKind, Slide, attr, code, group, heading, node, paragraph, span, text

pub def slide_dataframe_example() -> Slide:
    return Slide(
        slug="dataframe-example",
        title="Transformations and Actions",
        frame=Frame.Composed,
        styles="slide ",
        content=[
            group([
            text("04 / LAZY PANDAS"),
        ], style="eyebrow"),
            heading("Transformations and Actions", level=1),
            node(NodeKind.Preformatted, children=[
            node(NodeKind.Code, content="""result = (events
    .filter(col("amount") > 0)
    .groupBy("category")
    .count()
)

result.show()  # action""", style="language-python"),
        ], attributes=[attr("aria-label", "PySpark transformation example")]),
            paragraph([
            text("Here, "),
            code("groupBy().count()"),
            text(" builds an aggregate. "),
            code("show()"),
            text(" is the action."),
        ], style="takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("44"),
        ]),
        ],
        notes="Sample code layout, not a runnable notebook. Assumes events is a DataFrame and col is imported from pyspark.sql.functions. Explain that GroupedData.count() returns a DataFrame, unlike DataFrame.count().",
    )

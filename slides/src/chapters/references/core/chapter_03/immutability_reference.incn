"""Immutability reference slide."""

from surface import Frame, NodeKind, Slide, attr, code, code_block, group, heading, node, paragraph, span, strong, text

pub def slide_immutability_reference() -> Slide:
    return Slide(
        slug="immutability-reference",
        title="df = df.select(…)",
        frame=Frame.Composed,
        styles="slide core-slide migrated",
        content=[

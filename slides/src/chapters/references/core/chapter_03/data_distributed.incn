                    node(NodeKind.SvgText, content="books", style="trial-code", attributes=[attr("x", "866"), attr("y", "295")]),
                    node(NodeKind.SvgText, content="15", style="trial-code", attributes=[attr("x", "1188"), attr("y", "295")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "850"), attr("y", "308"), attr("width", "420"), attr("height", "42"), attr("fill", "#f8efe0")]),
                    node(NodeKind.SvgText, content="music", style="trial-code", attributes=[attr("x", "866"), attr("y", "337")]),
                    node(NodeKind.SvgText, content="10", style="trial-code", attributes=[attr("x", "1188"), attr("y", "337")]),

                    node(NodeKind.SvgText, content="Python holds a reference", style="trial-note", attributes=[attr("x", "32"), attr("y", "346")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "1"), attr("aria-label", "One logical table")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgPath, attributes=[attr("d", "M428 188H492Q500 188 500 180V110Q500 102 508 102H572M500 188V298Q500 306 508 306H572"), attr("fill", "none"), attr("stroke", "#286faf"), attr("stroke-width", "3")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "576"), attr("y", "8"), attr("width", "724"), attr("height", "174"), attr("rx", "12"), attr("fill", "#e8f3ee"), attr("stroke", "#639681"), attr("stroke-width", "2")]),

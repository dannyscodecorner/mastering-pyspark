                    node(NodeKind.SvgText, content="40", style="trial-code", attributes=[attr("x", "1188"), attr("y", "137")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "576"), attr("y", "208"), attr("width", "724"), attr("height", "166"), attr("rx", "12"), attr("fill", "#f8efe0"), attr("stroke", "#b79762"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Executor B", style="trial-title", attributes=[attr("x", "600"), attr("y", "246")]),

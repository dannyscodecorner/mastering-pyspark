"""Data distributed slide."""

from surface import Frame, NodeKind, Slide, attr, code, group, heading, node, paragraph, prose, span, strong, text

pub def slide_data_distributed() -> Slide:
    return Slide(
        slug="data-distributed",
        title="A DataFrame is still distributed",
        frame=Frame.Composed,
        styles="slide core-slide core-trial",
        content=[
            group([
            text("03 / SPARK’S CORE ABSTRACTIONS"),
        ], style="eyebrow"),
            heading("A DataFrame is still distributed", level=1),
            prose("A familiar table does not mean all the rows live in Python.", style="subtitle"),
            node(NodeKind.Figure, children=[
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgTitle, content="One table, multiple partitions", attributes=[attr("id", "data-distributed-title")]),
                node(NodeKind.SvgDescription, content="The table is our logical view; executors process its partitions.", attributes=[attr("id", "data-distributed-desc")]),
                node(NodeKind.SvgDefinitions, children=[

"""Dataframe partitions slide."""

from surface import Frame, NodeKind, Slide, attr, code, group, heading, node, paragraph, span, strong, text

pub def slide_dataframe_partitions() -> Slide:
    return Slide(
        slug="dataframe-partitions",
        title="A DataFrame is distributed",
        frame=Frame.Composed,
        styles="slide core-slide migrated",
        content=[
            group([
            text("03 / SPARK’S CORE ABSTRACTIONS"),
        ], style="eyebrow"),
            heading("A DataFrame is distributed", level=1),
            node(NodeKind.Figure, children=[
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgTitle, content="A DataFrame is distributed", attributes=[attr("id", "df-distributed-title")]),
                node(NodeKind.SvgDescription, content="The Python reference is local; the data is processed in partitions by Spark.", attributes=[attr("id", "df-distributed-desc")]),
                node(NodeKind.SvgDefinitions, children=[
                    node(NodeKind.SvgMarker, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L8 3L0 6Z"), attr("fill", "#286faf")]),
                    ], attributes=[attr("id", "df-distributed-arrow"), attr("markerWidth", "8"), attr("markerHeight", "6"), attr("refX", "7"), attr("refY", "3"), attr("orient", "auto")]),
                ]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "12"), attr("y", "40"), attr("width", "350"), attr("height", "255"), attr("rx", "6"), attr("fill", "#e8f3ef"), attr("stroke", "#60998d"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Python application", style="core-svg-heading", attributes=[attr("x", "36"), attr("y", "78")]),
                    node(NodeKind.SvgText, content="sales", style="core-svg-code", attributes=[attr("x", "36"), attr("y", "143")]),
                    node(NodeKind.SvgText, content="DataFrame reference", attributes=[attr("x", "36"), attr("y", "190"), attr("class", "")]),
                    node(NodeKind.SvgText, content="Not all rows in Python", style="core-svg-note", attributes=[attr("x", "36"), attr("y", "234")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "1"), attr("aria-label", "The Python variable refers to a DataFrame")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "500"), attr("y", "12"), attr("width", "790"), attr("height", "320"), attr("rx", "6"), attr("fill", "#f1f5f8"), attr("stroke", "#9badb9"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Distributed execution", style="core-svg-heading", attributes=[attr("x", "524"), attr("y", "52")]),
                    node(NodeKind.SvgPath, attributes=[attr("d", "M362 166H494"), attr("fill", "none"), attr("stroke", "#286faf"), attr("stroke-width", "2"), attr("marker-end", "url(#df-distributed-arrow)")]),
                    node(NodeKind.SvgText, content="plan", style="core-svg-note", attributes=[attr("x", "385"), attr("y", "143")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "2"), attr("aria-label", "Spark processes partitions using executors")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "524"), attr("y", "82"), attr("width", "352"), attr("height", "218"), attr("rx", "6"), attr("fill", "#e8f0f7"), attr("stroke", "#286faf"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Executor A", style="core-svg-heading", attributes=[attr("x", "544"), attr("y", "120")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "540"), attr("y", "140"), attr("width", "320"), attr("height", "140"), attr("rx", "6"), attr("fill", "#fff"), attr("stroke", "#96adc0"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Partition 0", style="core-svg-note", attributes=[attr("x", "556"), attr("y", "173")]),
                    node(NodeKind.SvgText, content="books  25", style="core-svg-code", attributes=[attr("x", "556"), attr("y", "213")]),
                    node(NodeKind.SvgText, content="games  40", style="core-svg-code", attributes=[attr("x", "556"), attr("y", "253")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "912"), attr("y", "82"), attr("width", "352"), attr("height", "218"), attr("rx", "6"), attr("fill", "#e8f0f7"), attr("stroke", "#286faf"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Executor B", style="core-svg-heading", attributes=[attr("x", "932"), attr("y", "120")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "928"), attr("y", "140"), attr("width", "320"), attr("height", "140"), attr("rx", "6"), attr("fill", "#fff"), attr("stroke", "#96adc0"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Partition 1", style="core-svg-note", attributes=[attr("x", "944"), attr("y", "173")]),
                    node(NodeKind.SvgText, content="books  15", style="core-svg-code", attributes=[attr("x", "944"), attr("y", "213")]),
                    node(NodeKind.SvgText, content="music  10", style="core-svg-code", attributes=[attr("x", "944"), attr("y", "253")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "3"), attr("aria-label", "Partitions contain subsets of rows")]),
            ], attributes=[attr("viewBox", "0 0 1308 350"), attr("role", "img"), attr("aria-labelledby", "df-distributed-title df-distributed-desc")]),
            group([
                paragraph([
                    strong("A DataFrame is distributed"),
                    span("The Python reference is local; the data is processed in partitions by Spark."),
                ], style="narration-cue cue-0"),
                paragraph([
                    strong("1 · A local reference"),
                    span("sales is a Python reference to a DataFrame, not a local container holding every row."),
                ], style="narration-cue cue-1"),
                paragraph([
                    strong("2 · A distributed computation"),
                    span("Spark plans the work and schedules tasks on executors."),
                ], style="narration-cue cue-2"),
                paragraph([
                    strong("3 · Rows in partitions"),
                    span("Each partition holds a subset of rows. An executor can process many partitions."),
                ], style="narration-cue cue-3"),
            ], style="narration-cues"),
            group([
                node(NodeKind.Button, content="Previous point", attributes=[attr("type", "button"), attr("data-motion-action", "prev")]),
                node(NodeKind.Button, content="Play slowly", attributes=[attr("type", "button"), attr("data-motion-action", "play")]),
                node(NodeKind.Button, content="Pause", attributes=[attr("type", "button"), attr("data-motion-action", "pause")]),
                node(NodeKind.Button, content="Next point", attributes=[attr("type", "button"), attr("data-motion-action", "next")]),
                node(NodeKind.Button, content="Replay", attributes=[attr("type", "button"), attr("data-motion-action", "replay")]),
                node(NodeKind.Span, children=[
                    text("Step "),
                    span("3", attributes=[attr("data-motion-step-label", flag=true)]),
                    text(" of 3"),
                ], style="core-step"),
            ], attributes=[attr("data-motion-controls", flag=true), attr("hidden", flag=true)]),
            node(NodeKind.Paragraph, style="sr-only", attributes=[attr("data-motion-status", flag=true), attr("role", "status"), attr("aria-live", "polite"), attr("aria-atomic", "true")]),
        ], style="core-motion jvm-walkthrough", attributes=[attr("data-motion-root", flag=true), attr("data-motion-mode", "step"), attr("data-step-count", "3"), attr("data-step-current", "3"), attr("data-frame", "static"), attr("style", "--motion-hold:6000ms"), attr("tabindex", "0"), attr("aria-label", "A DataFrame is distributed. Use previous and next point to step through the explanation.")]),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("39"),
        ]),
        ],
        notes="Return to the architecture vocabulary. This sketch shows an execution-time view, not data already loaded by assigning a variable. Two partitions and two executors are illustrative: partitions are not pinned permanently to executors and their counts need not match. All partitions have the same logical schema. Only request bounded local results; collect() materialises all returned rows locally. Detailed execution and shuffle boundaries come later.  Original workshop slides 15–21. Updated against https://spark.apache.org/docs/latest/rdd-programming-guide.html and https://spark.apache.org/docs/latest/sql-programming-guide.html . ",
    )

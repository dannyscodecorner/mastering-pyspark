                    span("", style="history-rail-dot"),
                    span("Spark 4.2", style="history-rail-name"),
                ], style="history-stop spark-era "),
            ], style="history-track", attributes=[attr("style", "transform:translateY(-1074px)")]),
        ], style="history-rail", attributes=[attr("aria-hidden", "true")]),
            group([
            span("07 / 12", style="history-stop-count"),
            prose("Spark 1.3 · 2015", style="history-kicker"),
            heading("DataFrames and a growing community", level=1),
            node(NodeKind.Figure, children=[
                node(NodeKind.Svg, children=[
                    node(NodeKind.SvgTitle, content="DataFrames and a growing community", attributes=[attr("id", "hist-6-title")]),
                    node(NodeKind.SvgDescription, content="DataFrames introduce named columns and schemas while the contributor community grows.", attributes=[attr("id", "hist-6-desc")]),
                    node(NodeKind.SvgDefinitions, children=[
                        node(NodeKind.SvgMarker, children=[
                            node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L10 5L0 10"), attr("fill", "#54797d")]),
                        ], attributes=[attr("id", "hj-arrow-6"), attr("viewBox", "0 0 10 10"), attr("refX", "9"), attr("refY", "5"), attr("markerWidth", "6"), attr("markerHeight", "6"), attr("orient", "auto")]),
                    ]),
                    node(NodeKind.SvgGroup, children=[

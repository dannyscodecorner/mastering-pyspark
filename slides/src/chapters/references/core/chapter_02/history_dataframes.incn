                group([
                    span("2014", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 1.0", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2015", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("DataFrames", style="history-rail-name"),
                ], style="history-stop spark-era focal"),
                group([
                    span("2016", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 2.0", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2020/21", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 3.x", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2023", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Connect", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2025", style="history-rail-year"),
                    span("", style="history-rail-dot"),

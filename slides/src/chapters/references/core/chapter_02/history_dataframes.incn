                            node(NodeKind.SvgText, content="amount", style="hj-node-title", attributes=[attr("x", "285.0"), attr("y", "85.5"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node neutral", attributes=[attr("x", "20"), attr("y", "102"), attr("width", "106"), attr("height", "41"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="…", style="hj-node-title", attributes=[attr("x", "73.0"), attr("y", "129.5"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node neutral", attributes=[attr("x", "126"), attr("y", "102"), attr("width", "106"), attr("height", "41"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="…", style="hj-node-title", attributes=[attr("x", "179.0"), attr("y", "129.5"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node neutral", attributes=[attr("x", "232"), attr("y", "102"), attr("width", "106"), attr("height", "41"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="…", style="hj-node-title", attributes=[attr("x", "285.0"), attr("y", "129.5"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node neutral", attributes=[attr("x", "20"), attr("y", "143"), attr("width", "106"), attr("height", "41"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="…", style="hj-node-title", attributes=[attr("x", "73.0"), attr("y", "170.5"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node neutral", attributes=[attr("x", "126"), attr("y", "143"), attr("width", "106"), attr("height", "41"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="…", style="hj-node-title", attributes=[attr("x", "179.0"), attr("y", "170.5"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node neutral", attributes=[attr("x", "232"), attr("y", "143"), attr("width", "106"), attr("height", "41"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="…", style="hj-node-title", attributes=[attr("x", "285.0"), attr("y", "170.5"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node teal", attributes=[attr("x", "438"), attr("y", "55"), attr("width", "385"), attr("height", "170"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="A growing community", style="hj-node-title", attributes=[attr("x", "630.5"), attr("y", "135.0"), attr("text-anchor", "middle")]),
                            node(NodeKind.SvgText, content="Developers across organizations", style="hj-node-sub", attributes=[attr("x", "630.5"), attr("y", "165.0"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgText, content="Columns and schemas", style="hj-label", attributes=[attr("x", "20"), attr("y", "250")]),
                        node(NodeKind.SvgText, content="A broader project and ecosystem", style="hj-label", attributes=[attr("x", "438"), attr("y", "250")]),
                    ], attributes=[attr("style", "--hj-marker:url(#hj-arrow-6)")]),
                ], attributes=[attr("viewBox", "0 0 850 290"), attr("role", "img"), attr("aria-labelledby", "hist-6-title hist-6-desc")]),
            ], style="history-visual"),
            prose("Named columns and schemas give Spark more information to optimize your computation.", style="history-backstory"),
        ], style="history-scene"),
            prose("Chronological milestones · spacing not to scale", style="history-scale-note"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("16"),
        ]),
        ],
        notes="""2015 — DataFrames and a growing community.

The DataFrame API arrives in Spark 1.3, building on Spark SQL. This changes how we express a lot of data engineering: describe operations on columns and allow the engine to optimize them. Save schemas, Catalyst and API examples for their dedicated sections. RDDs remain available. Community detail: a preserved Apache site snapshot in 2016 reports more than 1,000 cumulative contributors. Do not state that threshold was crossed in 2015 without a dated primary source. https://svn.apache.org/repos/asf/spark/site/index.html

Advance once to travel to the next milestone. The rail uses milestone spacing, not a proportional elapsed-time scale.

Sources (checked 2026-09-18):
https://spark.apache.org/history
https://spark.apache.org/releases/spark-release-1-0-0.html
https://spark.apache.org/releases/spark-release-1-3-0.html
https://spark.apache.org/releases/spark-release-2-0-0.html""",
    )

"""History modern slide."""

from surface import Frame, NodeKind, Slide, attr, group, heading, node, prose, span, text

pub def slide_history_modern() -> Slide:
    return Slide(
        slug="history-modern",
        title="2020 / 2021 — Spark 3.0 and AQE",
        frame=Frame.Composed,
        styles="slide migrated history-journey spark-era",
        attributes=[attr("data-history-index", "8")],
        content=[
            group([
            text("02 / INTRODUCING SPARK"),
        ], style="eyebrow"),
            group([
            group([
                group([
                    span("2003/04", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Google’s papers", style="history-rail-name"),
                ], style="history-stop  "),
                group([
                    span("2006", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Hadoop", style="history-rail-name"),
                ], style="history-stop  "),
                group([
                    span("2009", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark begins", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2010", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Open source", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2013", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Apache", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2014", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 1.0", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2015", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("DataFrames", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2016", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 2.0", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2020/21", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 3.x", style="history-rail-name"),
                ], style="history-stop spark-era focal"),
                group([
                    span("2023", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Connect", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2025", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 4.0", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2026", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 4.2", style="history-rail-name"),
                ], style="history-stop spark-era "),
            ], style="history-track", attributes=[attr("style", "transform:translateY(-1510px)")]),
        ], style="history-rail", attributes=[attr("aria-hidden", "true")]),
            group([
            span("09 / 12", style="history-stop-count"),
            prose("2020: AQE arrives · 2021: enabled by default", style="history-kicker"),
            heading("Spark 3.0 and AQE", level=1),
            node(NodeKind.Figure, children=[
                node(NodeKind.Svg, children=[
                    node(NodeKind.SvgTitle, content="Spark 3.0 and AQE", attributes=[attr("id", "hist-8-title")]),
                    node(NodeKind.SvgDescription, content="AQE uses runtime statistics to revise parts of the physical query plan.", attributes=[attr("id", "hist-8-desc")]),
                    node(NodeKind.SvgDefinitions, children=[
                        node(NodeKind.SvgMarker, children=[
                            node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L10 5L0 10"), attr("fill", "#54797d")]),
                        ], attributes=[attr("id", "hj-arrow-8"), attr("viewBox", "0 0 10 10"), attr("refX", "9"), attr("refY", "5"), attr("markerWidth", "6"), attr("markerHeight", "6"), attr("orient", "auto")]),
                    ]),
                    node(NodeKind.SvgGroup, children=[
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node neutral", attributes=[attr("x", "20"), attr("y", "96"), attr("width", "210"), attr("height", "100"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="Initial plan", style="hj-node-title", attributes=[attr("x", "125.0"), attr("y", "153.0"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgPath, style="hj-arrow", attributes=[attr("d", "M230 146 H300")]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node teal", attributes=[attr("x", "300"), attr("y", "96"), attr("width", "230"), attr("height", "100"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="Runtime statistics", style="hj-node-title", attributes=[attr("x", "415.0"), attr("y", "141.0"), attr("text-anchor", "middle")]),
                            node(NodeKind.SvgText, content="What actually happened", style="hj-node-sub", attributes=[attr("x", "415.0"), attr("y", "171.0"), attr("text-anchor", "middle")]),
                        ]),
                        node(NodeKind.SvgPath, style="hj-arrow", attributes=[attr("d", "M530 146 H600")]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgRectangle, style="hj-node spark", attributes=[attr("x", "600"), attr("y", "96"), attr("width", "230"), attr("height", "100"), attr("rx", "8")]),
                            node(NodeKind.SvgText, content="Adapted plan", style="hj-node-title", attributes=[attr("x", "715.0"), attr("y", "141.0"), attr("text-anchor", "middle")]),
                            node(NodeKind.SvgText, content="AQE", style="hj-node-sub", attributes=[attr("x", "715.0"), attr("y", "171.0"), attr("text-anchor", "middle")]),
                        ]),
                    ], attributes=[attr("style", "--hj-marker:url(#hj-arrow-8)")]),
                ], attributes=[attr("viewBox", "0 0 850 290"), attr("role", "img"), attr("aria-labelledby", "hist-8-title hist-8-desc")]),
            ], style="history-visual"),
            prose("Adaptive Query Execution can revise a query’s physical plan using statistics collected during execution.", style="history-backstory"),
        ], style="history-scene"),
            prose("Chronological milestones · spacing not to scale", style="history-scale-note"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("18"),
        ]),
        ],
        notes="""2020 / 2021 — Spark 3.0 and AQE.

Spark 3.0 introduces the modern AQE framework in 2020; 3.2 enables it by default in 2021. Examples to name briefly: coalescing shuffle partitions, adapting joins and handling skew. This does not remove the need to understand partitions and shuffles. Spark 3.2 also introduces the pandas API on Spark; it is not the same as ordinary local pandas.

Advance once to travel to the next milestone. The rail uses milestone spacing, not a proportional elapsed-time scale.

Sources (checked 2026-09-18):
https://spark.apache.org/releases/spark-release-3-0-0.html
https://spark.apache.org/releases/spark-release-3-2-0.html
https://spark.apache.org/releases/spark-release-3-4-0.html
https://spark.apache.org/releases/spark-release-4-0-0.html
https://spark.apache.org/releases/spark-release-4-2-0.html
https://spark.apache.org/history""",
    )

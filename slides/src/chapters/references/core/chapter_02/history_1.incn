"""History 1 slide."""

from surface import Frame, NodeKind, Slide, attr, group, heading, image, node, prose, span, text

pub def slide_history_1() -> Slide:
    return Slide(
        slug="history-1",
        title="2014 — Spark 1.0",
        frame=Frame.Composed,
        styles="slide migrated history-journey spark-era",
        attributes=[attr("data-history-index", "5")],
        content=[
            group([
            text("02 / INTRODUCING SPARK"),
        ], style="eyebrow"),
            group([
            group([
                group([
                    span("2003/04", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Google’s papers", style="history-rail-name"),
                ], style="history-stop  "),
                group([
                    span("2006", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Hadoop", style="history-rail-name"),
                ], style="history-stop  "),
                group([
                    span("2009", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark begins", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2010", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Open source", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2013", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Apache", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2014", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 1.0", style="history-rail-name"),
                ], style="history-stop spark-era focal"),
                group([
                    span("2015", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("DataFrames", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2016", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 2.0", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2020/21", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 3.x", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2023", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Connect", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2025", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 4.0", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2026", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 4.2", style="history-rail-name"),
                ], style="history-stop spark-era "),
            ], style="history-track", attributes=[attr("style", "transform:translateY(-856px)")]),
        ], style="history-rail", attributes=[attr("aria-hidden", "true")]),
            group([
            span("06 / 12", style="history-stop-count"),
            prose("A common engine for different workloads", style="history-kicker"),
            heading("Spark 1.0", level=1),
            node(NodeKind.Figure, children=[
                group([
                    image("assets/history/spark.png", "Apache Spark", style="history-project-logo"),
                    node(NodeKind.Svg, children=[
                        node(NodeKind.SvgTitle, content="Spark 1.0", attributes=[attr("id", "hist-5-title")]),
                        node(NodeKind.SvgDescription, content="Spark 1.0 includes libraries for SQL, streaming, machine learning and graphs around the core engine.", attributes=[attr("id", "hist-5-desc")]),
                        node(NodeKind.SvgDefinitions, children=[
                            node(NodeKind.SvgMarker, children=[
                                node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L10 5L0 10"), attr("fill", "#54797d")]),
                            ], attributes=[attr("id", "hj-arrow-5"), attr("viewBox", "0 0 10 10"), attr("refX", "9"), attr("refY", "5"), attr("markerWidth", "6"), attr("markerHeight", "6"), attr("orient", "auto")]),
                        ]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgGroup, children=[
                                node(NodeKind.SvgRectangle, style="hj-node spark", attributes=[attr("x", "15"), attr("y", "40"), attr("width", "190"), attr("height", "90"), attr("rx", "8")]),
                                node(NodeKind.SvgText, content="Spark SQL", style="hj-node-title", attributes=[attr("x", "110.0"), attr("y", "92.0"), attr("text-anchor", "middle")]),
                            ]),
                            node(NodeKind.SvgGroup, children=[
                                node(NodeKind.SvgRectangle, style="hj-node spark", attributes=[attr("x", "225"), attr("y", "40"), attr("width", "190"), attr("height", "90"), attr("rx", "8")]),
                                node(NodeKind.SvgText, content="Streaming", style="hj-node-title", attributes=[attr("x", "320.0"), attr("y", "92.0"), attr("text-anchor", "middle")]),
                            ]),
                            node(NodeKind.SvgGroup, children=[
                                node(NodeKind.SvgRectangle, style="hj-node spark", attributes=[attr("x", "435"), attr("y", "40"), attr("width", "190"), attr("height", "90"), attr("rx", "8")]),
                                node(NodeKind.SvgText, content="MLlib", style="hj-node-title", attributes=[attr("x", "530.0"), attr("y", "92.0"), attr("text-anchor", "middle")]),
                            ]),
                            node(NodeKind.SvgGroup, children=[
                                node(NodeKind.SvgRectangle, style="hj-node spark", attributes=[attr("x", "645"), attr("y", "40"), attr("width", "190"), attr("height", "90"), attr("rx", "8")]),
                                node(NodeKind.SvgText, content="GraphX", style="hj-node-title", attributes=[attr("x", "740.0"), attr("y", "92.0"), attr("text-anchor", "middle")]),
                            ]),
                            node(NodeKind.SvgPath, style="hj-arrow", attributes=[attr("d", "M110 130 V180")]),
                            node(NodeKind.SvgPath, style="hj-arrow", attributes=[attr("d", "M320 130 V180")]),
                            node(NodeKind.SvgPath, style="hj-arrow", attributes=[attr("d", "M530 130 V180")]),
                            node(NodeKind.SvgPath, style="hj-arrow", attributes=[attr("d", "M740 130 V180")]),
                            node(NodeKind.SvgGroup, children=[
                                node(NodeKind.SvgRectangle, style="hj-node teal", attributes=[attr("x", "15"), attr("y", "180"), attr("width", "820"), attr("height", "86"), attr("rx", "8")]),
                                node(NodeKind.SvgText, content="Spark Core", style="hj-node-title", attributes=[attr("x", "425.0"), attr("y", "218.0"), attr("text-anchor", "middle")]),
                                node(NodeKind.SvgText, content="Scheduling · distributed data · execution", style="hj-node-sub", attributes=[attr("x", "425.0"), attr("y", "248.0"), attr("text-anchor", "middle")]),
                            ]),
                        ], attributes=[attr("style", "--hj-marker:url(#hj-arrow-5)")]),
                    ], attributes=[attr("viewBox", "0 0 850 290"), attr("role", "img"), attr("aria-labelledby", "hist-5-title hist-5-desc")]),
                ], style="release-history-art"),
            ], style="history-visual"),
            prose("Spark becomes an Apache top-level project, and version 1.0 is released.", style="history-backstory"),
        ], style="history-scene"),
            prose("Chronological milestones · spacing not to scale", style="history-scale-note"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("15"),
        ]),
        ],
        notes="""Visual assets: see assets/history/CREDITS.md. Official logos identify the projects, not sponsorship. The Berkeley photo was taken in 2013 and illustrates the location, not the founding event. 2014 — Spark 1.0.

This is the transition from a research project to an established platform. RDDs are a foundational API; structured-data APIs are developing too. Avoid implying Spark SQL only appeared with Spark 2.0. The library stack illustrates Spark 1.0, including early Spark SQL and DStream-based Spark Streaming. These are not all new in 1.0; Structured Streaming arrives later.

Advance once to travel to the next milestone. The rail uses milestone spacing, not a proportional elapsed-time scale.

Sources (checked 2026-09-18):
https://spark.apache.org/history
https://spark.apache.org/releases/spark-release-1-0-0.html
https://spark.apache.org/releases/spark-release-1-3-0.html
https://spark.apache.org/releases/spark-release-2-0-0.html""",
    )

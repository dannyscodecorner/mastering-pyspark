"""History 4 slide."""

from surface import Frame, NodeKind, Slide, attr, group, heading, image, node, prose, span, text

pub def slide_history_4() -> Slide:
    return Slide(
        slug="history-4",
        title="2025 — Spark 4.0",
        frame=Frame.Composed,
        styles="slide migrated history-journey spark-era",
        attributes=[attr("data-history-index", "10")],
        content=[
            group([
            text("02 / INTRODUCING SPARK"),
        ], style="eyebrow"),
            group([
            group([
                group([
                    span("2003/04", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Google’s papers", style="history-rail-name"),
                ], style="history-stop  "),
                group([
                    span("2006", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Hadoop", style="history-rail-name"),
                ], style="history-stop  "),
                group([
                    span("2009", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark begins", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2010", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Open source", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2013", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Apache", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2014", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 1.0", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2015", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("DataFrames", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2016", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 2.0", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2020/21", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 3.x", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2023", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Connect", style="history-rail-name"),
                ], style="history-stop spark-era "),
                group([
                    span("2025", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 4.0", style="history-rail-name"),
                ], style="history-stop spark-era focal"),
                group([
                    span("2026", style="history-rail-year"),
                    span("", style="history-rail-dot"),
                    span("Spark 4.2", style="history-rail-name"),
                ], style="history-stop spark-era "),
            ], style="history-track", attributes=[attr("style", "transform:translateY(-1946px)")]),
        ], style="history-rail", attributes=[attr("aria-hidden", "true")]),
            group([
            span("11 / 12", style="history-stop-count"),
            prose("New APIs and new defaults", style="history-kicker"),
            heading("Spark 4.0", level=1),
            node(NodeKind.Figure, children=[
                group([
                    image("assets/history/spark.png", "Apache Spark", style="history-project-logo"),
                    node(NodeKind.Svg, children=[
                        node(NodeKind.SvgTitle, content="Spark 4.0", attributes=[attr("id", "hist-10-title")]),
                        node(NodeKind.SvgDescription, content="Spark 4.0 changes SQL defaults and expands Python and Spark Connect APIs.", attributes=[attr("id", "hist-10-desc")]),
                        node(NodeKind.SvgDefinitions, children=[
                            node(NodeKind.SvgMarker, children=[
                                node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L10 5L0 10"), attr("fill", "#54797d")]),
                            ], attributes=[attr("id", "hj-arrow-10"), attr("viewBox", "0 0 10 10"), attr("refX", "9"), attr("refY", "5"), attr("markerWidth", "6"), attr("markerHeight", "6"), attr("orient", "auto")]),
                        ]),
                        node(NodeKind.SvgGroup, children=[
                            node(NodeKind.SvgGroup, children=[
                                node(NodeKind.SvgRectangle, style="hj-node spark", attributes=[attr("x", "20"), attr("y", "58"), attr("width", "245"), attr("height", "170"), attr("rx", "8")]),
                                node(NodeKind.SvgText, content="SQL", style="hj-node-title", attributes=[attr("x", "142.5"), attr("y", "138.0"), attr("text-anchor", "middle")]),
                                node(NodeKind.SvgText, content="ANSI mode by default", style="hj-node-sub", attributes=[attr("x", "142.5"), attr("y", "168.0"), attr("text-anchor", "middle")]),
                            ]),
                            node(NodeKind.SvgGroup, children=[
                                node(NodeKind.SvgRectangle, style="hj-node teal", attributes=[attr("x", "302"), attr("y", "58"), attr("width", "245"), attr("height", "170"), attr("rx", "8")]),
                                node(NodeKind.SvgText, content="Python", style="hj-node-title", attributes=[attr("x", "424.5"), attr("y", "138.0"), attr("text-anchor", "middle")]),
                                node(NodeKind.SvgText, content="Data Source API", style="hj-node-sub", attributes=[attr("x", "424.5"), attr("y", "168.0"), attr("text-anchor", "middle")]),
                            ]),
                            node(NodeKind.SvgGroup, children=[
                                node(NodeKind.SvgRectangle, style="hj-node teal", attributes=[attr("x", "584"), attr("y", "58"), attr("width", "245"), attr("height", "170"), attr("rx", "8")]),
                                node(NodeKind.SvgText, content="Connect", style="hj-node-title", attributes=[attr("x", "706.5"), attr("y", "138.0"), attr("text-anchor", "middle")]),
                                node(NodeKind.SvgText, content="Lightweight client", style="hj-node-sub", attributes=[attr("x", "706.5"), attr("y", "168.0"), attr("text-anchor", "middle")]),
                            ]),
                        ], attributes=[attr("style", "--hj-marker:url(#hj-arrow-10)")]),
                    ], attributes=[attr("viewBox", "0 0 850 290"), attr("role", "img"), attr("aria-labelledby", "hist-10-title hist-10-desc")]),
                ], style="release-history-art"),
            ], style="history-visual"),
            prose("ANSI SQL mode becomes the default; Python data sources and Spark Connect gain capabilities.", style="history-backstory"),
        ], style="history-scene"),
            prose("Chronological milestones · spacing not to scale", style="history-scale-note"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("20"),
        ]),
        ],
        notes="""Visual assets: see assets/history/CREDITS.md. Official logos identify the projects, not sponsorship. The Berkeley photo was taken in 2013 and illustrates the location, not the founding event. 2025 — Spark 4.0.

Use this as a practical upgrade milestone, not a catalogue. Spark 4.0 defaults to ANSI SQL mode, which changes behavior for some invalid operations. Other developments include VARIANT, a Python Data Source API, a lightweight Connect client and richer streaming state APIs. The runtime baseline changes too: Java 17 and Scala 2.13. Version-specific behavior needs checking when migrating old examples.

Advance once to travel to the next milestone. The rail uses milestone spacing, not a proportional elapsed-time scale.

Sources (checked 2026-09-18):
https://spark.apache.org/releases/spark-release-3-0-0.html
https://spark.apache.org/releases/spark-release-3-2-0.html
https://spark.apache.org/releases/spark-release-3-4-0.html
https://spark.apache.org/releases/spark-release-4-0-0.html
https://spark.apache.org/releases/spark-release-4-2-0.html
https://spark.apache.org/history""",
    )

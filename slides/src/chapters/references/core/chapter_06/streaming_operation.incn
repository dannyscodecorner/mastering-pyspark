"""Streaming operation slide."""

from surface import Frame, NodeKind, Slide, group, heading, node, span, text

pub def slide_streaming_operation() -> Slide:
    return Slide(
        slug="streaming-operation",
        title="Managing Streaming Queries",
        frame=Frame.Composed,
        styles="slide ",
        content=[
            group([
            text("06 / BATCH VS. STREAMING"),
        ], style="eyebrow"),
            heading("Managing Streaming Queries", level=1),
            node(NodeKind.OrderedList, children=[
            node(NodeKind.ListItem, children=[
                span("01"),
                text("Output modes and supported operations"),
            ]),
            node(NodeKind.ListItem, children=[
                span("02"),
                text("Checkpointing, recovery and retries"),
            ]),
            node(NodeKind.ListItem, children=[
                span("03"),
                text("End-to-end guarantees and idempotent effects"),
            ]),
            node(NodeKind.ListItem, children=[
                span("04"),
                text("Backlog, state growth and query changes"),
            ]),
            node(NodeKind.ListItem, children=[
                span("05"),
                text("Batch and streaming side by side"),
            ]),
        ], style="topic-list"),
            span("CONTENT SKELETON", style="draft-label"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("50"),
        ]),
        ],
        notes="",
    )

"""Data work slide."""

from surface import Frame, NodeKind, Slide, group, heading, node, span, text

pub def slide_data_work() -> Slide:
    return Slide(
        slug="data-work",
        title="Data Preparation with Spark SQL",
        frame=Frame.Composed,
        styles="slide ",
        content=[
            group([
            text("07 / WORKING WITH PYSPARK"),
        ], style="eyebrow"),
            heading("Data Preparation with Spark SQL", level=1),
            node(NodeKind.OrderedList, children=[
            node(NodeKind.ListItem, children=[
                span("01"),
                text("Read, define schemas and explore the input"),
            ]),
            node(NodeKind.ListItem, children=[
                span("02"),
                text("Clean types, timestamps, nulls and nested data"),
            ]),
            node(NodeKind.ListItem, children=[
                span("03"),
                text("Join without losing track of correctness"),
            ]),
            node(NodeKind.ListItem, children=[
                span("04"),
                text("Aggregate and use window functions"),
            ]),
            node(NodeKind.ListItem, children=[
                span("05"),
                text("Write, control file layout and validate the result"),
            ]),
        ], style="topic-list"),
            span("CONTENT SKELETON", style="draft-label"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("52"),
        ]),
        ],
        notes="Movable practical module: explanation, instructor demonstration or participant exercise. Preserve strings/regex, profiling and non-ML preparation material; no fixed lab timetable.",
    )

"""Cover slide."""

from surface import Frame, NodeKind, Slide, group, line_break, node, prose, rich_heading, span, text

pub def slide_section_5() -> Slide:
    return Slide(
        slug="section-5",
        title="Spark Execution Model",
        frame=Frame.Composed,
        styles="slide dark",
        content=[
            group([
            text("05 / SPARK EXECUTION MODEL"),
        ], style="eyebrow"),
            group([
            span("05", style="chapter-number"),
            group([
                rich_heading([
                    text("Spark Execution"),
                    line_break(),
                    text("Model"),
                ], level=1),
                prose("Query planning and distributed execution"),
            ]),
        ], style="divider"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("45"),
        ]),
        ],
        notes="",
    )

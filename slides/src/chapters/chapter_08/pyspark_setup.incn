"""Pyspark setup slide."""

from surface import Frame, NodeKind, Slide, attr, code, group, heading, node, paragraph, prose, span, strong, text

pub def slide_pyspark_setup() -> Slide:
    return Slide(
        slug="pyspark-setup",
        title="Set up the lab",
        frame=Frame.Composed,
        styles="slide ho-lesson",
        content=[
            group([
            text("08 / WORKING WITH PYSPARK"),
        ], style="eyebrow"),
            heading("Set up the lab", level=1),
            group([
            group([
                heading("In the VS Code terminal", level=2),
                paragraph([
                    text("Open the project’s "),
                    code("labs"),
                    text(" folder."),
                ]),
                node(NodeKind.Preformatted, children=[
                    node(NodeKind.Code, content="""java -version
uv sync --locked --group notebook
uv run --locked check_setup.py""", style="language-text"),
                ]),
                prose("Java 21 · Python 3.12 · PySpark 4.2.0", style="ho-note"),
                paragraph([
                    text("Look for: "),
                    strong("Setup check passed"),
                ], style="ho-setup-pass"),
            ]),
            group([
                heading("Open one exercise notebook", level=2),
                prose("Everyone starts with the same notebook:"),
                node(NodeKind.Preformatted, children=[
                    node(NodeKind.Code, content="notebooks/01-inspect.ipynb", style="language-text"),
                ]),
                node(NodeKind.OrderedList, children=[
                    node(NodeKind.ListItem, content="Enable VS Code’s Python and Jupyter extensions."),
                    node(NodeKind.ListItem, children=[
                        text("Open "),
                        code("01-inspect.ipynb"),
                        text(" and select the project’s "),
                        code(".venv"),
                        text(" kernel."),
                    ]),
                    node(NodeKind.ListItem, children=[
                        text("Run its "),
                        strong("Setup"),
                        text(" cell to create "),
                        code("spark"),
                        text("."),
                    ]),
                ], style="ho-steps"),
                paragraph([
                    strong("Save and finish"),
                    text(" before opening the next notebook."),
                ], style="ho-note"),
            ]),
        ], style="ho-workgrid ho-setup-grid"),
            paragraph([
            text("Course repository: "),
            node(NodeKind.Link, content="dannyscodecorner/mastering-pyspark", attributes=[attr("href", "https://github.com/dannyscodecorner/mastering-pyspark"), attr("target", "_blank"), attr("rel", "noopener")]),
        ], style="ho-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("106"),
        ]),
        ],
        notes="Complete installation and the setup check before class. The Python and Jupyter VS Code extensions are required; select labs/.venv in the notebook kernel picker. Everyone starts at notebooks/01-inspect.ipynb. Core tasks form the 60-minute baseline; optional zoom-ins inside each notebook add depth for a 90-minute session. Larger investigations are linked by topic. One saved workspace supports all choices. Run Setup, complete task cells and checks, then Save and finish. The next notebook loads saved learner functions and starts its own session. Blank todo calls intentionally stop; do not Run All before answering. Native Windows needs a recorded full validation of the redesigned notebooks. The spare MacBook should have this exact project and its preflight completed.",
    )

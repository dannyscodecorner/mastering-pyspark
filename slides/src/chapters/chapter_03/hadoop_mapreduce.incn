"""Hadoop mapreduce slide."""

from surface import Frame, NodeKind, Slide, TeachingStep, attr, group, heading, node, prose, span, text
from components import step_rail, step_cues

pub def slide_hadoop_mapreduce() -> Slide:
    steps = [
        TeachingStep(label="Input",
            heading="Start with the question",
            explanation="What is the total per category? The input is split so tasks can work in parallel.",
            cue_key="0", numbered=true),
        TeachingStep(label="Map",
            heading="Map · emit a common key",
            explanation="Each map task emits category–amount pairs from its own input split.",
            cue_key="1", numbered=true),
        TeachingStep(label="Shuffle",
            heading="Shuffle · matching keys must meet",
            explanation="The books records came from different tasks. Bring their amounts together before adding them.",
            cue_key="2", numbered=true),
        TeachingStep(label="Reduce",
            heading="Reduce · combine each group",
            explanation="Add the amounts for each category: books 40, games 40, music 10.",
            cue_key="3", numbered=true),
        TeachingStep(label="Write",
            heading="Finish this job",
            explanation="Write the output to HDFS so another job can use it.",
            cue_key="4", numbered=true),
        TeachingStep(label="Read again",
            heading="Now do another calculation",
            explanation="That next job reads the intermediate output back. Repeated jobs repeat this storage round trip.",
            cue_key="5", numbered=true),
    ]
    return Slide(
        slug="hadoop-mapreduce",
        title="How MapReduce works",
        frame=Frame.Composed,
        styles="slide lesson-slide ",
        content=[
            group([
            text("03 / SPARK’S CORE ABSTRACTIONS"),
        ], style="eyebrow"),
            heading("How MapReduce works", level=1),
            group([
            prose("What is the total per category?", style="subtitle"),
            step_rail(steps),
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgTitle, content="mapreduce job", attributes=[attr("id", "mapreduce-job-title")]),
                node(NodeKind.SvgDescription, content="Four records are mapped in two tasks, shuffled by category, reduced to totals, written to HDFS and read by a later job.", attributes=[attr("id", "mapreduce-job-desc")]),
                node(NodeKind.SvgText, content="Input records", style="scene-heading", attributes=[attr("x", "20"), attr("y", "28")]),
                node(NodeKind.SvgText, content="Parallel map tasks", style="scene-heading mid-heading", attributes=[attr("x", "462"), attr("y", "28")]),
                node(NodeKind.SvgText, content="Group by key → reduce", style="scene-heading right-heading", attributes=[attr("x", "934"), attr("y", "28")]),
                node(NodeKind.SvgRectangle, style="worker-boundary", attributes=[attr("x", "8"), attr("y", "52"), attr("width", "278"), attr("height", "160"), attr("rx", "10")]),
                node(NodeKind.SvgRectangle, style="worker-boundary", attributes=[attr("x", "8"), attr("y", "228"), attr("width", "278"), attr("height", "160"), attr("rx", "10")]),
                node(NodeKind.SvgText, content="Input split A", style="tiny", attributes=[attr("x", "22"), attr("y", "71")]),
                node(NodeKind.SvgText, content="Input split B", style="tiny", attributes=[attr("x", "22"), attr("y", "247")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "0"), attr("y", "0"), attr("width", "244"), attr("height", "54"), attr("rx", "10"), attr("class", "")]),
                    node(NodeKind.SvgText, content="books", style="record-key", attributes=[attr("x", "18"), attr("y", "35")]),
                    node(NodeKind.SvgText, content="25", style="record-value", attributes=[attr("x", "190"), attr("y", "35")]),
                ], style="record books source-tile", attributes=[attr("transform", "translate(24 78)")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "0"), attr("y", "0"), attr("width", "244"), attr("height", "54"), attr("rx", "10"), attr("class", "")]),
                    node(NodeKind.SvgText, content="games", style="record-key", attributes=[attr("x", "18"), attr("y", "35")]),
                    node(NodeKind.SvgText, content="40", style="record-value", attributes=[attr("x", "190"), attr("y", "35")]),
                ], style="record games source-tile", attributes=[attr("transform", "translate(24 140)")]),
                node(NodeKind.SvgGroup, children=[

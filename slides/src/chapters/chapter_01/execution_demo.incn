                    node(NodeKind.SvgText, content="Task", style="ap-body", attributes=[attr("x", "1065"), attr("y", "375")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "4"), attr("aria-label", "Tasks run inside each executor")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, style="ap-cache", attributes=[attr("x", "1064"), attr("y", "60"), attr("width", "102"), attr("height", "36"), attr("rx", "7")]),
                    node(NodeKind.SvgText, content="Cache", style="ap-body", attributes=[attr("x", "1077"), attr("y", "85")]),

"""Execution demo slide."""

from surface import Frame, NodeKind, Slide, attr, code, group, heading, node, paragraph, prose, span, strong, text

pub def slide_execution_demo() -> Slide:
    return Slide(
        slug="execution-demo",
        title="Spark Applications",
        frame=Frame.Composed,
        styles="slide migrated",
        content=[
            group([
            text("01 / SPARK VS. PYTHON"),
        ], style="eyebrow"),
            heading("Spark Applications", level=1),
            prose("Independent sets of processes, coordinated by a driver.", style="subtitle"),
            node(NodeKind.Figure, children=[
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgTitle, content="Spark Applications", attributes=[attr("id", "applications-title")]),
                node(NodeKind.SvgDescription, content="One application has a driver and its own executor processes on worker nodes; the cluster manager allocates resources, executors run tasks and can cache data, and shuffle data travels between executors.", attributes=[attr("id", "applications-desc")]),
                node(NodeKind.SvgDefinitions, children=[
                    node(NodeKind.SvgMarker, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L10 5L0 10"), attr("fill", "#257f86")]),

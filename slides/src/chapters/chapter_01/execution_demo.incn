                    node(NodeKind.SvgRectangle, style="ap-worker", attributes=[attr("x", "868"), attr("y", "238"), attr("width", "330"), attr("height", "174"), attr("rx", "7")]),
                    node(NodeKind.SvgText, content="Worker node B", style="ap-heading", attributes=[attr("x", "888"), attr("y", "269")]),
                    node(NodeKind.SvgRectangle, style="ap-executor", attributes=[attr("x", "884"), attr("y", "280"), attr("width", "298"), attr("height", "115"), attr("rx", "7")]),
                    node(NodeKind.SvgText, content="Executor", style="ap-heading", attributes=[attr("x", "900"), attr("y", "311")]),

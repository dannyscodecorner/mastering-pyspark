                    node(NodeKind.SvgText, content="Resources", style="ap-label", attributes=[attr("x", "336"), attr("y", "190")]),
                    node(NodeKind.SvgPath, style="ap-line ap-resource", attributes=[attr("d", "M682 182 H756 Q764 182 764 174 V131 Q764 123 772 123 H866")]),
                    node(NodeKind.SvgPath, style="ap-line ap-resource", attributes=[attr("d", "M682 254 H756 Q764 254 764 262 V307 Q764 315 772 315  H866")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "2"), attr("aria-label", "The driver requests resources from the cluster manager")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, style="ap-driver", attributes=[attr("x", "16"), attr("y", "119"), attr("width", "304"), attr("height", "202"), attr("rx", "7")]),
                    node(NodeKind.SvgText, content="Driver", style="ap-heading", attributes=[attr("x", "38"), attr("y", "154")]),
                    node(NodeKind.SvgRectangle, style="ap-code", attributes=[attr("x", "36"), attr("y", "174"), attr("width", "264"), attr("height", "53"), attr("rx", "7")]),
                    node(NodeKind.SvgText, content="Your application code", style="ap-body", attributes=[attr("x", "55"), attr("y", "208")]),
                    node(NodeKind.SvgRectangle, style="ap-session", attributes=[attr("x", "36"), attr("y", "242"), attr("width", "264"), attr("height", "54"), attr("rx", "7")]),
                    node(NodeKind.SvgText, content="SparkSession", style="ap-body", attributes=[attr("x", "55"), attr("y", "276")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "1"), attr("aria-label", "The driver runs the application and holds its SparkSession")]),
                node(NodeKind.SvgGroup, children=[

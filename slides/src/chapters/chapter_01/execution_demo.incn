                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, style="ap-task", attributes=[attr("x", "901"), attr("y", "120"), attr("width", "112"), attr("height", "35"), attr("rx", "7")]),
                    node(NodeKind.SvgText, content="Task", style="ap-body", attributes=[attr("x", "917"), attr("y", "145")]),
                    node(NodeKind.SvgRectangle, style="ap-task", attributes=[attr("x", "1049"), attr("y", "120"), attr("width", "112"), attr("height", "35"), attr("rx", "7")]),
                    node(NodeKind.SvgText, content="Task", style="ap-body", attributes=[attr("x", "1065"), attr("y", "145")]),
                    node(NodeKind.SvgRectangle, style="ap-task", attributes=[attr("x", "901"), attr("y", "350"), attr("width", "112"), attr("height", "35"), attr("rx", "7")]),
                    node(NodeKind.SvgText, content="Task", style="ap-body", attributes=[attr("x", "917"), attr("y", "375")]),

"""Architecture slide."""

from surface import Frame, NodeKind, Slide, attr, code, group, heading, node, prose, span, text

pub def slide_architecture() -> Slide:
    return Slide(
        slug="architecture",
        title="Cluster Computing",
        frame=Frame.Composed,
        styles="slide migrated",
        content=[
            group([
            text("01 / SPARK VS. PYTHON"),
        ], style="eyebrow"),
            heading("Cluster Computing", level=1),
            prose("Several computers working together. Each computer is a node.", style="subtitle"),
            node(NodeKind.Figure, children=[
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgTitle, content="Cluster Computing", attributes=[attr("id", "cluster-title")]),
                node(NodeKind.SvgDescription, content="A Spark driver schedules tasks on executors across three worker nodes and receives results and status; a separate cluster manager allocates resources, and executors access data storage directly.", attributes=[attr("id", "cluster-desc")]),
                node(NodeKind.SvgDefinitions, children=[
                    node(NodeKind.SvgMarker, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L10 5L0 10"), attr("fill", "#257f86")]),
                    ], attributes=[attr("id", "cluster-arrow"), attr("viewBox", "0 0 10 10"), attr("refX", "9"), attr("refY", "5"), attr("markerWidth", "7"), attr("markerHeight", "7"), attr("orient", "auto-start-reverse")]),
                ]),
                node(NodeKind.SvgRectangle, style="cluster-zone", attributes=[attr("x", "650"), attr("y", "8"), attr("width", "414"), attr("height", "430"), attr("rx", "10")]),
                node(NodeKind.SvgText, content="Worker nodes", style="cluster-heading", attributes=[attr("x", "674"), attr("y", "43")]),
                node(NodeKind.SvgPath, style="cluster-flow", attributes=[attr("d", "M246 180 H352")]),
                node(NodeKind.SvgText, content="Launch", style="cluster-label", attributes=[attr("x", "298"), attr("y", "157"), attr("text-anchor", "middle")]),
                node(NodeKind.SvgPath, style="cluster-flow", attributes=[attr("d", "M612 179 H634 Q642 179 642 171 V128 Q642 120 650 120 H674")]),
                node(NodeKind.SvgPath, style="cluster-flow", attributes=[attr("d", "M612 232 H674")]),
                node(NodeKind.SvgPath, style="cluster-flow", attributes=[attr("d", "M612 282 H626 Q634 282 634 290 V336 Q634 344 642 344 H674")]),
                node(NodeKind.SvgPath, style="cluster-flow cluster-return", attributes=[attr("d", "M650 424 H558 Q550 424 550 416 V328")]),
                node(NodeKind.SvgText, content="Results and status", style="cluster-label", attributes=[attr("x", "462"), attr("y", "462")]),
                node(NodeKind.SvgPath, style="cluster-flow cluster-return", attributes=[attr("d", "M354 290 H298 Q290 290 290 298 V384 Q290 392 282 392 H246")]),
                node(NodeKind.SvgPath, style="cluster-flow cluster-resource", attributes=[attr("d", "M483 106 V142")]),
                node(NodeKind.SvgRectangle, style="cluster-app", attributes=[attr("x", "8"), attr("y", "123"), attr("width", "238"), attr("height", "122"), attr("rx", "8")]),
                node(NodeKind.SvgText, content="Your application", style="cluster-heading", attributes=[attr("x", "30"), attr("y", "164")]),
                node(NodeKind.SvgText, content="Submit the program", style="cluster-body", attributes=[attr("x", "30"), attr("y", "202")]),
                node(NodeKind.SvgRectangle, style="cluster-result", attributes=[attr("x", "8"), attr("y", "342"), attr("width", "238"), attr("height", "98"), attr("rx", "8")]),
                node(NodeKind.SvgText, content="Result", style="cluster-heading", attributes=[attr("x", "30"), attr("y", "379")]),
                node(NodeKind.SvgText, content="For count(): a number", style="cluster-body", attributes=[attr("x", "30"), attr("y", "413")]),
                node(NodeKind.SvgRectangle, style="cluster-manager", attributes=[attr("x", "354"), attr("y", "8"), attr("width", "258"), attr("height", "98"), attr("rx", "8")]),
                node(NodeKind.SvgText, content="Cluster manager", style="cluster-heading", attributes=[attr("x", "376"), attr("y", "44")]),
                node(NodeKind.SvgText, content="Allocates resources", style="cluster-body", attributes=[attr("x", "376"), attr("y", "79")]),
                node(NodeKind.SvgRectangle, style="cluster-driver", attributes=[attr("x", "354"), attr("y", "144"), attr("width", "258"), attr("height", "184"), attr("rx", "8")]),
                node(NodeKind.SvgText, content="Spark driver", style="cluster-heading", attributes=[attr("x", "376"), attr("y", "184")]),
                node(NodeKind.SvgText, content="Schedules tasks", style="cluster-body", attributes=[attr("x", "376"), attr("y", "224")]),
                node(NodeKind.SvgText, content="Tracks progress", style="cluster-body", attributes=[attr("x", "376"), attr("y", "259")]),
                node(NodeKind.SvgText, content="Handles results", style="cluster-body", attributes=[attr("x", "376"), attr("y", "294")]),
                node(NodeKind.SvgRectangle, style="cluster-store", attributes=[attr("x", "1120"), attr("y", "80"), attr("width", "180"), attr("height", "305"), attr("rx", "8")]),
                node(NodeKind.SvgEllipse, attributes=[attr("cx", "1210"), attr("cy", "128"), attr("rx", "45"), attr("ry", "14"), attr("fill", "#dce9ed"), attr("stroke", "#286faf"), attr("stroke-width", "2")]),
                node(NodeKind.SvgPath, attributes=[attr("d", "M1165 128 V168 C1165 187 1255 187 1255 168 V128 M1165 149 C1165 168 1255 168 1255 149"), attr("fill", "none"), attr("stroke", "#286faf"), attr("stroke-width", "2")]),
                node(NodeKind.SvgText, content="Data storage", style="cluster-heading", attributes=[attr("x", "1210"), attr("y", "222"), attr("text-anchor", "middle")]),
                node(NodeKind.SvgText, content="Files, tables,", style="cluster-body", attributes=[attr("x", "1210"), attr("y", "257"), attr("text-anchor", "middle")]),
                node(NodeKind.SvgText, content="object storage", style="cluster-body", attributes=[attr("x", "1210"), attr("y", "285"), attr("text-anchor", "middle")]),
                node(NodeKind.SvgText, content="Read / write", style="cluster-label", attributes=[attr("x", "1210"), attr("y", "347"), attr("text-anchor", "middle")]),
                node(NodeKind.SvgRectangle, style="cluster-worker", attributes=[attr("x", "674"), attr("y", "72"), attr("width", "366"), attr("height", "96"), attr("rx", "7")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "93"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "120"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "103"), attr("r", "3"), attr("fill", "#fafaf8")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "130"), attr("r", "3"), attr("fill", "#69bec3")]),
                node(NodeKind.SvgText, content="Worker node A", style="cluster-heading", attributes=[attr("x", "752"), attr("y", "107")]),
                node(NodeKind.SvgText, content="Executors run tasks", style="cluster-body", attributes=[attr("x", "752"), attr("y", "141")]),
                node(NodeKind.SvgPath, style="cluster-flow cluster-data", attributes=[attr("d", "M1040 120 H1120"), attr("marker-start", "url(#cluster-arrow)")]),
                node(NodeKind.SvgRectangle, style="cluster-worker", attributes=[attr("x", "674"), attr("y", "184"), attr("width", "366"), attr("height", "96"), attr("rx", "7")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "205"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "232"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "215"), attr("r", "3"), attr("fill", "#fafaf8")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "242"), attr("r", "3"), attr("fill", "#69bec3")]),
                node(NodeKind.SvgText, content="Worker node B", style="cluster-heading", attributes=[attr("x", "752"), attr("y", "219")]),
                node(NodeKind.SvgText, content="Executors run tasks", style="cluster-body", attributes=[attr("x", "752"), attr("y", "253")]),
                node(NodeKind.SvgPath, style="cluster-flow cluster-data", attributes=[attr("d", "M1040 232 H1120"), attr("marker-start", "url(#cluster-arrow)")]),
                node(NodeKind.SvgRectangle, style="cluster-worker", attributes=[attr("x", "674"), attr("y", "296"), attr("width", "366"), attr("height", "96"), attr("rx", "7")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "317"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "344"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "327"), attr("r", "3"), attr("fill", "#fafaf8")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "354"), attr("r", "3"), attr("fill", "#69bec3")]),
                node(NodeKind.SvgText, content="Worker node C", style="cluster-heading", attributes=[attr("x", "752"), attr("y", "331")]),
                node(NodeKind.SvgText, content="Executors run tasks", style="cluster-body", attributes=[attr("x", "752"), attr("y", "365")]),
                node(NodeKind.SvgPath, style="cluster-flow cluster-data", attributes=[attr("d", "M1040 344 H1120"), attr("marker-start", "url(#cluster-arrow)")]),
            ], attributes=[attr("viewBox", "0 0 1308 490"), attr("role", "img"), attr("aria-labelledby", "cluster-title cluster-desc")]),
        ], style="cluster-overview"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("5"),
        ]),
        ],
        notes="Start with the worker nodes: these are separate computers, each contributing CPU and memory. A large computation can be split into tasks that run in parallel. For Spark, distinguish the application’s driver (schedules tasks and handles their results) from the cluster manager (allocates resources across applications). Resource allocation is shown as a relationship, not the full launch protocol. Follow the outgoing work, then results and status returning. For our count example, the distributed computation produces a number that returns to the application. Executors read data directly from storage; input rows do not all travel through the driver. Storage can be remote or local; the drawing uses shared storage and does not imply one fixed partition per node. The driver can run inside or outside the cluster. Transition: “What does a program that uses this cluster look like?” Show the PySpark code and invite the group to explain it. Source: original workshop slide 10; corrected roles: https://spark.apache.org/docs/4.2.0/cluster-overview.html .",
    )

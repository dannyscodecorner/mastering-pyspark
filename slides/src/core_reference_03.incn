    return Chapter(number="3", title="Spark’s Core Abstractions", first_page=1, slides=[
        slide_section_3(),
        slide_hadoop_mapreduce(),
        slide_mapreduce_jobs(),
        slide_rdd_foundation(),
        slide_rdd_reuse(),
        slide_rdd_why(),
        slide_dataframe_meaning(),
        slide_dataframe_why(),
        slide_dataset_context(),
        slide_data_views(),
        slide_data_distributed(),
        slide_data_transform(),
        slide_core_abstractions(),
        slide_rdd_api(),
        slide_dataset_api(),
        slide_dataframe_api(),
        slide_dataframe_partitions(),
        slide_immutability(),
        slide_immutability_reference(),
    ])

"""Editable Incan content migrated from the captured core-abstractions-reference.html."""

from surface import Attribute, Chapter, Frame, NodeKind, Slide, Surface, TeachingStep, attr, code, code_block, emphasis, group, heading, image, line_break, node, paragraph, prose, rich_heading, span, strong, text
from components import step_rail, step_cues

pub def slide_section_3() -> Slide:
    return Slide(
        slug="section-3",
        title="Spark’s Core Abstractions",
        frame=Frame.Composed,
        styles="slide core-intro-art",
        content=[
            image("assets/core-abstractions-intro.png", "Illustrated numbered tiles, a table, and typed record cards represent RDD, DataFrame and Dataset against a dark charcoal background.", style="core-intro-image"),
            group([
            prose("03 / Spark’s Core Abstractions"),
            heading("Spark’s Core Abstractions", level=1),
            prose("Putting data into perspective"),
            prose("RDD · DataFrame · Dataset"),
            prose("Danny’s Code Corner"),
        ], style="sr-only"),
        ],
        notes="We have seen how Spark evolved and how its processes work together. Now look at the data interfaces: a collection of elements, a table with named columns, and typed objects. These illustrations introduce the three APIs; they are not a required conversion pipeline. The next slides follow the original workshop’s explanation. Artwork combines the tactile objects from option 2 with the dark palette from option 1.",
    )

pub def slide_hadoop_mapreduce() -> Slide:
    return Slide(
        slug="hadoop-mapreduce",
        title="Hadoop and MapReduce",
        frame=Frame.Composed,
        styles="slide core-slide core-trial",
        content=[
            group([
            text("03 / SPARK’S CORE ABSTRACTIONS"),
        ], style="eyebrow"),
            heading("Hadoop and MapReduce", level=1),
            prose("Store the records. Group matching keys. Compute the totals.", style="subtitle"),
            node(NodeKind.Figure, children=[
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgTitle, content="Hadoop and MapReduce", attributes=[attr("id", "hadoop-mapreduce-title")]),
                node(NodeKind.SvgDescription, content="Store the records. Group matching keys. Compute the totals.", attributes=[attr("id", "hadoop-mapreduce-desc")]),
                node(NodeKind.SvgDefinitions, children=[
                    node(NodeKind.SvgMarker, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L8 3L0 6Z"), attr("fill", "#286faf")]),
                    ], attributes=[attr("id", "hadoop-mapreduce-arrow"), attr("markerWidth", "8"), attr("markerHeight", "6"), attr("refX", "7"), attr("refY", "3"), attr("orient", "auto")]),
                ]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "8"), attr("y", "8"), attr("width", "330"), attr("height", "360"), attr("rx", "12"), attr("fill", "#edf3f8"), attr("stroke", "#97aec0"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Hadoop", style="trial-title", attributes=[attr("x", "30"), attr("y", "48")]),
                    node(NodeKind.SvgText, content="HDFS: distributed storage", style="trial-note", attributes=[attr("x", "30"), attr("y", "90")]),
                    node(NodeKind.SvgText, content="MapReduce: processing", style="trial-note", attributes=[attr("x", "30"), attr("y", "124")]),
                    node(NodeKind.SvgText, style="trial-note", attributes=[attr("x", "30"), attr("y", "158")]),
                    node(NodeKind.SvgText, content="Our question:", style="trial-note", attributes=[attr("x", "30"), attr("y", "192")]),
                    node(NodeKind.SvgText, content="sales total per category", style="trial-note", attributes=[attr("x", "30"), attr("y", "226")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "1"), attr("aria-label", "HDFS stores data; MapReduce processes it")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "370"), attr("y", "8"), attr("width", "330"), attr("height", "360"), attr("rx", "12"), attr("fill", "#edf3f8"), attr("stroke", "#97aec0"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Map → shuffle / sort", style="trial-title", attributes=[attr("x", "392"), attr("y", "48")]),
                    node(NodeKind.SvgText, content="Emit key / value pairs", style="trial-note", attributes=[attr("x", "392"), attr("y", "90")]),
                    node(NodeKind.SvgText, style="trial-note", attributes=[attr("x", "392"), attr("y", "124")]),
                    node(NodeKind.SvgText, content="books → [25, 15]", style="trial-note", attributes=[attr("x", "392"), attr("y", "158")]),
                    node(NodeKind.SvgText, content="games → [40]", style="trial-note", attributes=[attr("x", "392"), attr("y", "192")]),
                    node(NodeKind.SvgText, content="music → [10]", style="trial-note", attributes=[attr("x", "392"), attr("y", "226")]),
                    node(NodeKind.SvgPath, attributes=[attr("d", "M338 186H370"), attr("fill", "none"), attr("stroke", "#286faf"), attr("stroke-width", "3")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "2"), attr("aria-label", "Map emits category and amount; shuffle groups matching keys")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "732"), attr("y", "8"), attr("width", "568"), attr("height", "360"), attr("rx", "12"), attr("fill", "#e8f3ee"), attr("stroke", "#639681"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Reduce → output", style="trial-title", attributes=[attr("x", "754"), attr("y", "48")]),
                    node(NodeKind.SvgText, content="books: 25 + 15 = 40", style="trial-note", attributes=[attr("x", "754"), attr("y", "90")]),
                    node(NodeKind.SvgText, content="games: 40", style="trial-note", attributes=[attr("x", "754"), attr("y", "124")]),
                    node(NodeKind.SvgText, content="music: 10", style="trial-note", attributes=[attr("x", "754"), attr("y", "158")]),
                    node(NodeKind.SvgText, style="trial-note", attributes=[attr("x", "754"), attr("y", "192")]),
                    node(NodeKind.SvgText, content="Write the results to storage", style="trial-note", attributes=[attr("x", "754"), attr("y", "226")]),
                    node(NodeKind.SvgPath, attributes=[attr("d", "M700 186H732"), attr("fill", "none"), attr("stroke", "#286faf"), attr("stroke-width", "3")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "3"), attr("aria-label", "Reduce sums each group")]),
            ], attributes=[attr("viewBox", "0 0 1308 390"), attr("role", "img"), attr("aria-labelledby", "hadoop-mapreduce-title hadoop-mapreduce-desc")]),

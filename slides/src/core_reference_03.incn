                    node(NodeKind.SvgText, content="DataFrame B", style="core-svg-heading", attributes=[attr("x", "924"), attr("y", "63")]),
                    node(NodeKind.SvgText, content="amount", style="core-svg-code", attributes=[attr("x", "924"), attr("y", "115")]),
                    node(NodeKind.SvgText, content="Projection of A", attributes=[attr("x", "924"), attr("y", "164"), attr("class", "")]),
                    node(NodeKind.SvgText, content="A remains unchanged", style="core-svg-note", attributes=[attr("x", "924"), attr("y", "213")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "2"), attr("aria-label", "select returns a new DataFrame description")]),
                node(NodeKind.SvgGroup, children=[

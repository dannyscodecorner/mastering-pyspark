            group([
                paragraph([
                    strong("But why is this important?"),
                    span("Take a moment. What does this help us understand about Spark?"),
                ], style="narration-cue cue-0"),
                paragraph([
                    strong("1 · Parallel work"),
                    span("Partitions help explain how Spark divides a computation into tasks."),
                ], style="narration-cue cue-1"),
                paragraph([
                    strong("2 · Required work"),
                    span("Dependencies explain the work a result depends on."),
                ], style="narration-cue cue-2"),
                paragraph([

                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "930"), attr("y", "40"), attr("width", "368"), attr("height", "125"), attr("rx", "12"), attr("fill", "#fae8e3"), attr("stroke", "#bd725d"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Partition P0 lost", style="trial-title", attributes=[attr("x", "952"), attr("y", "80")]),

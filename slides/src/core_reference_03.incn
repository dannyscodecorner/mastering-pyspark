                    node(NodeKind.SvgText, content="3 · df now refers to B", style="core-svg-note", attributes=[attr("x", "344"), attr("y", "306")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "3"), attr("aria-label", "Assignment rebinds df to DataFrame B")]),

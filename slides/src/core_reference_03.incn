                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "2"), attr("aria-label", "A supporting columnar source can read only required columns")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "888"), attr("y", "20"), attr("width", "410"), attr("height", "338"), attr("rx", "12"), attr("fill", "#e8f3ee"), attr("stroke", "#639681"), attr("stroke-width", "2")]),
                    node(NodeKind.SvgText, content="Filter earlier", style="trial-title", attributes=[attr("x", "910"), attr("y", "60")]),
                    node(NodeKind.SvgText, content="amount > 20", style="trial-note", attributes=[attr("x", "910"), attr("y", "102")]),
                    node(NodeKind.SvgText, style="trial-note", attributes=[attr("x", "910"), attr("y", "136")]),
                    node(NodeKind.SvgText, content="Push toward the reader", style="trial-note", attributes=[attr("x", "910"), attr("y", "170")]),
                    node(NodeKind.SvgText, content="when supported.", style="trial-note", attributes=[attr("x", "910"), attr("y", "204")]),
                ], attributes=[attr("data-motion-item", flag=true), attr("data-step", "3"), attr("aria-label", "Supported filters can move closer to the source")]),
            ], attributes=[attr("viewBox", "0 0 1308 390"), attr("role", "img"), attr("aria-labelledby", "dataframe-why-title dataframe-why-desc")]),
            group([
                paragraph([
                    strong("Why use DataFrames?"),
                    span("Spark can use the meaning of your query to avoid unnecessary work."),
                ], style="narration-cue cue-0"),
                paragraph([
                    strong("1 · Tell Spark what you need"),
                    span("This query only needs the amount column and values above 20."),
                ], style="narration-cue cue-1"),
                paragraph([
                    strong("2 · Avoid unnecessary columns"),
                    span("With a suitable source such as Parquet, Spark can prune unused columns."),
                ], style="narration-cue cue-2"),
                paragraph([
                    strong("3 · Apply supported filters near the source"),
                    span("Pushdown may reduce data read or passed onward. Its effect depends on the source."),
                ], style="narration-cue cue-3"),
            ], style="narration-cues"),
            group([
                node(NodeKind.Button, content="Previous point", attributes=[attr("type", "button"), attr("data-motion-action", "prev")]),
                node(NodeKind.Button, content="Play slowly", attributes=[attr("type", "button"), attr("data-motion-action", "play")]),
                node(NodeKind.Button, content="Pause", attributes=[attr("type", "button"), attr("data-motion-action", "pause")]),
                node(NodeKind.Button, content="Next point", attributes=[attr("type", "button"), attr("data-motion-action", "next")]),
                node(NodeKind.Button, content="Replay", attributes=[attr("type", "button"), attr("data-motion-action", "replay")]),
                node(NodeKind.Span, children=[
                    text("Step "),
                    span("3", attributes=[attr("data-motion-step-label", flag=true)]),
                    text(" of 3"),
                ], style="core-step"),
            ], attributes=[attr("data-motion-controls", flag=true), attr("hidden", flag=true)]),
            node(NodeKind.Paragraph, style="sr-only", attributes=[attr("data-motion-status", flag=true), attr("role", "status"), attr("aria-live", "polite"), attr("aria-atomic", "true")]),
        ], style="core-motion jvm-walkthrough trial-motion", attributes=[attr("data-motion-root", flag=true), attr("data-motion-mode", "step"), attr("data-step-count", "3"), attr("data-step-current", "3"), attr("data-frame", "static"), attr("style", "--motion-hold:6000ms"), attr("tabindex", "0"), attr("aria-label", "Why use DataFrames?. Use Next point to advance.")]),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("30"),
        ]),
        ],
        notes="Use this as a concrete payoff, not a comprehensive optimiser lesson. The displayed chain is an expression illustration; use parentheses around a multiline chain when running Python. No execution happens merely by constructing it. Parquet column pruning avoids unused column data. Predicate pushdown and statistics may skip row groups, but cannot promise to avoid reading every nonmatching row; Spark may retain a residual filter. Do not imply guaranteed speedup or that arbitrary Python UDFs get the same optimisation. Later inspect an actual plan and explain logical/physical stages in the execution-model section. Source: https://spark.apache.org/docs/latest/sql-performance-tuning ; https://spark.apache.org/docs/latest/sql-data-sources-parquet.html",
    )

pub def slide_dataset_context() -> Slide:
    return Slide(
        slug="dataset-context",
        title="There’s also the Dataset API",
        frame=Frame.Composed,
        styles="slide lesson-slide ",
        content=[
            group([
            text("03 / SPARK’S CORE ABSTRACTIONS"),
        ], style="eyebrow"),
            heading("There’s also the Dataset API", level=1),
            group([
            group([
                prose("SCALA / JAVA", style="language-label"),
                heading("Dataset<Sale>", level=2),
                node(NodeKind.Preformatted, content="Sale(\"books\", 25)"),
                prose("A typed object API."),
                paragraph([
                    text("Unified since Spark 2.0"),
                    line_break(),
                    text("Scala: DataFrame = Dataset[Row]"),
                ], style="small-note"),
            ]),
            group([
                prose("OUR PYSPARK COURSE", style="language-label"),
                heading("DataFrame", level=2),
                node(NodeKind.Table, children=[
                    node(NodeKind.TableHead, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="category"),
                            node(NodeKind.HeaderCell, content="amount"),
                        ]),
                    ]),
                    node(NodeKind.TableBody, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="books"),
                            node(NodeKind.Cell, content="25"),
                        ]),
                    ]),
                ]),
                prose("No typed Dataset API to learn here."),
            ]),
        ], style="dataset-brief"),
            prose("Recognise the term in documentation. We’ll work with DataFrames.", style="dataset-close"),
            node(NodeKind.Link, content="Earlier explanations and comparison slides ↗", style="reference-link", attributes=[attr("href", "core-abstractions-reference.html#hadoop-mapreduce")]),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("31"),
        ]),
        ],
        notes="Keep this to a brief mention, around 30 seconds. Say: There’s also the Dataset API, for typed objects in Scala and Java. In this PySpark course we’ll use DataFrames, so we won’t spend time on it. The remaining details are backup for questions. Typed Dataset is a Scala/Java interface. Scala calls it Dataset[Sale]; Java writes Dataset<Sale>. In Scala DataFrame is an alias for Dataset[Row]; in Java the corresponding form is Dataset<Row>. Do not present this as a Python type equivalence. PySpark has DataFrames, not typed Dataset[T]. No automatic performance superiority. The original material remains in a separate reference deck linked on this slide. Spark 2.0 unified the DataFrame and Dataset APIs in Scala/Java; it did not add the typed Dataset API to Python. Transition to the overview of their relationship to execution. Source: https://spark.apache.org/releases/spark-release-2-0-0.html . Source: https://spark.apache.org/docs/latest/sql-programming-guide.html",
    )


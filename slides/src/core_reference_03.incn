                    span("3", attributes=[attr("data-motion-step-label", flag=true)]),
                    text(" of 3"),
                ], style="core-step"),
            ], attributes=[attr("data-motion-controls", flag=true), attr("hidden", flag=true)]),
            node(NodeKind.Paragraph, style="sr-only", attributes=[attr("data-motion-status", flag=true), attr("role", "status"), attr("aria-live", "polite"), attr("aria-atomic", "true")]),
        ], style="core-motion jvm-walkthrough", attributes=[attr("data-motion-root", flag=true), attr("data-motion-mode", "step"), attr("data-step-count", "3"), attr("data-step-current", "3"), attr("data-frame", "static"), attr("style", "--motion-hold:6000ms"), attr("tabindex", "0"), attr("aria-label", "Rebinding a Python name. Use previous and next point to step through the explanation.")]),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("41"),
        ]),
        ],
        notes="Original workshop slide 21, preserving its reference/identity explanation. Read the statement right to left. The old arrow becomes dashed to show a previous binding, not two simultaneous current bindings. A and B are teaching labels, not Spark IDs. We deliberately do not use df.rdd.id() to establish DataFrame identity: it exposes an implementation detail, is not a reliable abstraction for this lesson, and is unavailable in Connect. Once rebound, no separate Python name for A is retained in this snippet; B still describes a projection derived from its input plan. Ask: have we actually processed the rows yet? This bridges directly to Lazy Pandas. Reference: https://spark.apache.org/docs/latest/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrame.select.html  Original workshop slides 15–21. Updated against https://spark.apache.org/docs/latest/rdd-programming-guide.html and https://spark.apache.org/docs/latest/sql-programming-guide.html . ",
    )


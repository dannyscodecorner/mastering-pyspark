                    strong("Rebinding a Python name"),
                    span("The right-hand side creates a new DataFrame; assignment changes what df refers to."),
                ], style="narration-cue cue-0"),
                paragraph([
                    strong("1 · Start with df"),
                    span("Before this statement, df refers to the original DataFrame A."),
                ], style="narration-cue cue-1"),
                paragraph([
                    strong("2 · Evaluate the right-hand side"),
                    span("df.select(\"amount\") returns a new DataFrame B, derived from A."),
                ], style="narration-cue cue-2"),
                paragraph([
                    strong("3 · Assign the result"),
                    span("The name df now refers to B. A was not modified, and no full data copy is implied."),
                ], style="narration-cue cue-3"),
            ], style="narration-cues"),
            group([
                node(NodeKind.Button, content="Previous point", attributes=[attr("type", "button"), attr("data-motion-action", "prev")]),
                node(NodeKind.Button, content="Play slowly", attributes=[attr("type", "button"), attr("data-motion-action", "play")]),

                    node(NodeKind.SvgPath, attributes=[attr("style", "fill:none;stroke:#193140;stroke-width:2.3"), attr("d", "M580 313 H627"), attr("fill", "none"), attr("stroke", "#193140"), attr("stroke-width", "2.3"), attr("marker-end", "url(#sz-arrow-193140)")]),
                    node(NodeKind.SvgPath, attributes=[attr("style", "fill:none;stroke:#193140;stroke-width:2.3"), attr("d", "M810 313 H856"), attr("fill", "none"), attr("stroke", "#193140"), attr("stroke-width", "2.3"), attr("marker-end", "url(#sz-arrow-193140)")]),
                    node(NodeKind.SvgPath, attributes=[attr("style", "fill:none;stroke:#193140;stroke-width:2.3"), attr("d", "M1047 313 H1093"), attr("fill", "none"), attr("stroke", "#193140"), attr("stroke-width", "2.3"), attr("marker-end", "url(#sz-arrow-193140)")]),
                ], style="st-reveal-task"),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgPath, attributes=[attr("d", "M672 142 Q672 151 681 151 H1036 Q1045 151 1045 142 M858 184 L400 220"), attr("style", "fill:none;stroke:#0867c9;stroke-width:1.5;stroke-dasharray:5 5")]),
                    node(NodeKind.SvgText, content="Stage A tasks", attributes=[attr("x", "858"), attr("y", "177"), attr("text-anchor", "middle"), attr("style", "font-size:18px;fill:#0867c9;font-weight:700")]),
                ], style="sz-a-link"),
            ], style="st-art", attributes=[attr("viewBox", "0 0 1440 810"), attr("role", "img"), attr("aria-labelledby", "sz-title sz-desc")]),
            group([
                node(NodeKind.Paragraph, children=[
                    strong("Start with the physical plan Catalyst chose."),
                ], attributes=[attr("data-cue", flag=true)]),
                node(NodeKind.Paragraph, children=[
                    strong("A task runs the stage’s work on one partition."),
                ], attributes=[attr("data-cue", flag=true)]),
                node(NodeKind.Paragraph, children=[
                    strong("That task is one of the parallel tasks in Stage A."),
                ], attributes=[attr("data-cue", flag=true)]),
                node(NodeKind.Paragraph, children=[
                    strong("Stage B tasks read the shuffle and finish the totals."),
                ], attributes=[attr("data-cue", flag=true)]),
            ], style="lesson-cues"),
            group([
                node(NodeKind.OrderedList, children=[
                    node(NodeKind.ListItem, content="Plan"),
                    node(NodeKind.ListItem, content="One task"),
                    node(NodeKind.ListItem, content="All partitions"),
                    node(NodeKind.ListItem, content="Next stage"),
                ], style="lesson-rail"),
                node(NodeKind.Button, content="Previous", attributes=[attr("data-lesson-prev", flag=true)]),
                node(NodeKind.Button, content="Replay", attributes=[attr("data-lesson-reset", flag=true)]),
                node(NodeKind.Button, content="Next", attributes=[attr("data-lesson-next", flag=true)]),
                node(NodeKind.Span, children=[
                    text("Task counts are illustrative."),
                    line_break(),
                    text("Executors run tasks."),
                ], style="st-caveat"),
                span("", style="lesson-position", attributes=[attr("aria-live", "polite")]),
            ], style="lesson-controls"),
        ], style="lesson stages-walk stages-zoom", attributes=[attr("data-lesson", flag=true), attr("data-point", "3")]),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("50"),
        ]),
        ],
        notes="Accepted zoom layout; the previous static composition is archived outside the presentation. Four clicks: plan, one task, dock the close-up into Stage A, then reveal shuffle and Stage B. The task close-up is retired after docking; stage detail expands into its space. Keep the causal link to Catalyst: the compact top strip contains the same physical operators as slide39. First identify the operators before Exchange. Next zoom into one task: it reads one input partition, filters and computes partial totals. The illustrated partition has two books rows, 25 and 15, both passing amount greater than 0. Partial aggregation combines them into one books subtotal of 40 before the shuffle: two rows become one. This is a partition-local total; the downstream task combines any subtotals for that key from other partitions. Third show a stage as the repeated work across partitions, run by executors; tasks are not machines. Finally show shuffle repartitioning by category and downstream final aggregation. The coloured paths summarise routing, not a precise key mapping; the following shuffle slide traces concrete records. Three upstream and two downstream tasks are illustrative, not inferred from row count. Partition 0 contains books 25 and books 15, producing books 40. Partition 1 contains books 10 and games 40. Partition 2 contains music 10. The following shuffle slide follows these same three partitions and their partial totals through the shuffle. Final totals are books 50, games 40 and music 10. A task can be retried; counts here are logical tasks, not attempts. One action can cause multiple jobs, hence ONE ILLUSTRATIVE JOB. Operators need not each form a stage; the shuffle dependency is the important boundary. The output partition count can differ from the input count. AQE and existing distribution may change this example. No timings or actual execution capture claimed. Selected Product Design reference: exec-b177faa5-84aa-4dc6-b87d-2b671a189ea2.png.",
    )

pub def slide_execution_placement() -> Slide:
    return Slide(
        slug="execution-placement",
        title="Where do the tasks run?",
        frame=Frame.Composed,
        styles="slide lesson-slide execution-content placement-slide placement-workbench",
        content=[
            group([
            text("05 / FROM QUERY TO EXECUTION"),
        ], style="eyebrow"),
            heading("Where do the tasks run?", level=1),
            group([
            group([
                group([
                    heading("Driver schedules", level=2),
                    prose("Plans work. Schedules tasks. Tracks completion."),
                ], style="wb-heading wb-heading-driver"),
                group([
                    heading("Executors run tasks", level=2),
                ], style="wb-heading wb-heading-executor"),
                image("assets/execution-machines-bare.png", "", style="wb-machines wb-bare"),
                image("assets/execution-machines.png", "A driver workstation beside two worker machines, each containing an executor process.", style="wb-machines"),
                node(NodeKind.Svg, children=[
                    node(NodeKind.SvgDefinitions, children=[
                        node(NodeKind.SvgMarker, children=[
                            node(NodeKind.SvgPath, attributes=[attr("d", "M0 0 L10 5 L0 10Z"), attr("style", "fill:#b27420;stroke:none")]),
                        ], attributes=[attr("id", "wb-arrow"), attr("viewBox", "0 0 10 10"), attr("refX", "8"), attr("refY", "5"), attr("markerWidth", "6"), attr("markerHeight", "6"), attr("orient", "auto")]),
                        node(NodeKind.SvgMarker, children=[
                            node(NodeKind.SvgPath, attributes=[attr("d", "M0 0 L10 5 L0 10Z"), attr("style", "fill:#527b98;stroke:none")]),
                        ], attributes=[attr("id", "wb-return"), attr("viewBox", "0 0 10 10"), attr("refX", "8"), attr("refY", "5"), attr("markerWidth", "6"), attr("markerHeight", "6"), attr("orient", "auto")]),
                    ]),
                    node(NodeKind.SvgPath, attributes=[attr("d", "M260 110 H355 Q375 110 393 96 Q410 82 440 82 H1065 Q1100 82 1100 115 V145"), attr("style", "stroke:#c18831;stroke-width:5;fill:none"), attr("marker-end", "url(#wb-arrow)")]),
                    node(NodeKind.SvgPath, attributes=[attr("d", "M685 82 V145"), attr("style", "stroke:#c18831;stroke-width:5;fill:none"), attr("marker-end", "url(#wb-arrow)")]),
                    node(NodeKind.SvgPath, attributes=[attr("d", "M1100 315 V380 H162 V285"), attr("style", "fill:none;stroke:#527b98;stroke-width:2;stroke-dasharray:7 6"), attr("marker-end", "url(#wb-return)")]),
                ], style="wb-routes", attributes=[attr("viewBox", "0 0 1308 430"), attr("aria-hidden", "true")]),
                group([
                    text("Tasks sent to executors"),
                ], style="wb-dispatch-label"),
                group([
                    node(NodeKind.Strong, content="Stage A", style="wb-stage-a"),
                    node(NodeKind.Strong, content="Stage B", style="wb-stage-b"),
                    span("Schedule tasks", style="wb-screen-state"),
                    group([
                        strong("Totals"),
                        node(NodeKind.Span, children=[
                            text("books "),
                            node(NodeKind.Bold, content="50"),
                        ]),
                        node(NodeKind.Span, children=[
                            text("games "),
                            node(NodeKind.Bold, content="40"),
                        ]),
                        node(NodeKind.Span, children=[
                            text("music "),
                            node(NodeKind.Bold, content="10"),
                        ]),
                    ], style="wb-results"),
                    group([
                        text("0 / 3 reported"),
                    ], style="wb-received", attributes=[attr("aria-live", "polite")]),
                    group([
                        node(NodeKind.Bold, content="T0"),
                        node(NodeKind.Bold, content="T1"),
                        node(NodeKind.Bold, content="T2"),
                    ], style="wb-queue"),
                ], style="wb-screen"),
                group([
                    strong("Driver"),
                    span("Coordinates the work"),
                ], style="wb-driver-name"),
                group([
                    node(NodeKind.Header, children=[
                        strong("Executor 1"),
                        span("Application process"),
                    ]),
                    group([
                        text("Starting executor…"),
                    ], style="wb-launch-state"),
                    group([
                        group([
                            text("Available"),
                        ], style="wb-slot"),
                        group([
                            text("Available"),
                        ], style="wb-slot"),
                    ], style="wb-slots"),
                ], style="wb-executor wb-executor-a"),
                group([
                    node(NodeKind.Header, children=[
                        strong("Executor 2"),
                        span("Application process"),
                    ]),
                    group([
                        text("Starting executor…"),
                    ], style="wb-launch-state"),
                    group([
                        group([
                            text("Available"),
                        ], style="wb-slot"),
                        group([
                            text("Available"),
                        ], style="wb-slot"),
                    ], style="wb-slots"),
                ], style="wb-executor wb-executor-b"),
                group([
                    strong("Worker node A"),
                ], style="wb-node-name wb-node-a"),
                group([
                    strong("Worker node B"),
                ], style="wb-node-name wb-node-b"),
                group([
                    strong("Task 0"),
                    span("Input partition 0"),
                    node(NodeKind.Small, content="Running"),
                ], style="wb-ticket wb-t0 wb-task-a"),
                group([
                    strong("Task 1"),
                    span("Input partition 1"),
                    node(NodeKind.Small, content="Running"),
                ], style="wb-ticket wb-t1 wb-task-a"),
                group([
                    strong("Task 2"),
                    span("Input partition 2"),
                    node(NodeKind.Small, content="Running"),
                ], style="wb-ticket wb-t2 wb-task-a"),
                group([
                    strong("Task 3"),
                    span("Shuffle partition 0"),
                    node(NodeKind.Small, content="Final aggregate"),
                ], style="wb-ticket wb-t3 wb-task-b"),
                group([
                    strong("Task 4"),
                    span("Shuffle partition 1"),
                    node(NodeKind.Small, content="Final aggregate"),
                ], style="wb-ticket wb-t4 wb-task-b"),
                group([
                    text("Task completion status back to driver"),
                ], style="wb-return-label"),
                group([
                    text("Stage A complete"),
                ], style="wb-complete"),
                group([
                    text("Task 0 complete"),
                ], style="wb-report", attributes=[attr("hidden", flag=true)]),
                group([
                    text("Task 1 complete"),
                ], style="wb-report", attributes=[attr("hidden", flag=true)]),
                group([
                    text("Task 2 complete"),
                ], style="wb-report", attributes=[attr("hidden", flag=true)]),
            ], style="wb-scene"),
            group([
                group([
                    strong("Stage A"),
                    span("T0"),
                    span("T1"),
                    span("T2"),
                ]),
                node(NodeKind.Bold, content="then"),
                group([
                    strong("Stage B"),
                    span("T3"),
                    span("T4"),
                ]),
                paragraph([
                    text("Same machines. Same processes."),
                    line_break(),
                    strong("Different tasks."),
                ]),
            ], style="wb-progression"),
            group([
                node(NodeKind.Paragraph, children=[
                    strong("Imagine three machines: one driver and two worker nodes."),
                    span("Start with the hardware. Next, we will put the processes inside it."),
                ], attributes=[attr("data-cue", flag=true)]),
                node(NodeKind.Paragraph, children=[
                    strong("First, executor processes start on the workers."),
                    span("The cluster manager allocates resources and arranges executor startup."),
                ], attributes=[attr("data-cue", flag=true)]),
                node(NodeKind.Paragraph, children=[
                    strong("The driver sends each task to an executor."),
                    span("Stage A runs across both nodes; each task processes one input partition."),
                ], attributes=[attr("data-cue", flag=true)]),
                node(NodeKind.Paragraph, children=[
                    strong("Tasks finish. Their executors report completion."),
                    span("The processes remain available. Shuffle data stays with the workers."),
                ], attributes=[attr("data-cue", flag=true)]),
                node(NodeKind.Paragraph, children=[
                    strong("After the shuffle, the driver schedules Stage B."),
                    span("New tasks read shuffle partitions and produce the final totals."),
                ], attributes=[attr("data-cue", flag=true)]),
            ], style="lesson-cues"),
            group([
                node(NodeKind.OrderedList, children=[
                    node(NodeKind.ListItem, content="Machines"),
                    node(NodeKind.ListItem, content="Start executors"),
                    node(NodeKind.ListItem, content="Dispatch & run"),
                    node(NodeKind.ListItem, content="Complete"),
                    node(NodeKind.ListItem, content="Next stage"),
                ], style="lesson-rail"),
                node(NodeKind.Button, content="Previous point", attributes=[attr("data-lesson-prev", flag=true)]),
                node(NodeKind.Button, content="Replay", attributes=[attr("data-lesson-reset", flag=true)]),
                node(NodeKind.Button, content="Next point", attributes=[attr("data-lesson-next", flag=true)]),
                span("", style="lesson-position", attributes=[attr("aria-live", "polite")]),
            ], style="lesson-controls"),
        ], style="lesson workbench-walk", attributes=[attr("data-lesson", flag=true), attr("data-point", "4")]),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("51"),
        ]),
        ],
        notes="Return to the same three Stage A tasks and two Stage B tasks. A worker node is a machine (physical or virtual); an executor is an application-specific process on a node; a task is work scheduled onto an executor. One executor per node is an illustrative layout, not a universal rule. Multiple executors may share a node. The two visible positions represent available concurrency for teaching, not a claim that every executor always has two cores or that one task always requires exactly one core. Concurrency depends on allocated cores, task resource requirements and configuration. In Stage A executor 1 runs tasks 0 and 1, while executor 2 runs task 2. After the shuffle, those executor processes can run tasks from Stage B. Task 3 combines books 40 + 10 to 50, task 4 finalises games 40 and music 10. For this example the retained executor placement is unchanged; actual scheduling is not guaranteed to match and dynamic allocation can change the executor population. The driver coordinates tasks and receives status, but shuffle records are read by downstream tasks rather than gathered at the driver. The next slide follows those records through the shuffle. The driver box is a logical coordinator, not a claim that it always runs outside the cluster. The cluster manager allocates resources; resource acquisition is already covered in the application architecture and is omitted here to focus on execution placement. Source: https://spark.apache.org/docs/latest/cluster-overview.html",
    )

pub def slide_execution_shuffle() -> Slide:
    return Slide(
        slug="execution-shuffle",
        title="Why shuffle?",
        frame=Frame.Composed,
        styles="slide lesson-slide execution-content",
        content=[
            group([
            text("05 / FROM QUERY TO EXECUTION"),
        ], style="eyebrow"),
            heading("Why shuffle?", level=1),
            prose("We combined rows locally. Now combine partial totals across partitions.", style="subtitle"),
            node(NodeKind.Figure, children=[
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgDefinitions, children=[
                    node(NodeKind.SvgMarker, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M0 0 L10 5 L0 10Z"), attr("fill", "context-stroke")]),
                    ], attributes=[attr("id", "sh-key-arrow"), attr("viewBox", "0 0 10 10"), attr("refX", "9"), attr("refY", "5"), attr("markerWidth", "6"), attr("markerHeight", "6"), attr("orient", "auto")]),
                ]),
                node(NodeKind.SvgText, content="Stage A · partial totals", attributes=[attr("x", "20"), attr("y", "27"), attr("style", "font-size:22px;font-weight:700")]),
                node(NodeKind.SvgText, content="Shuffle · same keys meet", attributes=[attr("x", "425"), attr("y", "27"), attr("style", "font-size:22px;font-weight:700")]),
                node(NodeKind.SvgText, content="Stage B · final aggregation", attributes=[attr("x", "815"), attr("y", "27"), attr("style", "font-size:22px;font-weight:700")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "15"), attr("y", "48"), attr("width", "320"), attr("height", "92"), attr("rx", "8")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "15"), attr("y", "156"), attr("width", "320"), attr("height", "113"), attr("rx", "8")]),
                    node(NodeKind.SvgRectangle, attributes=[attr("x", "15"), attr("y", "285"), attr("width", "320"), attr("height", "86"), attr("rx", "8")]),
                ], attributes=[attr("fill", "#edf6fe"), attr("stroke", "#a9c5da")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgText, content="Task 0 · partition 0", attributes=[attr("x", "35"), attr("y", "78"), attr("style", "font-size:19px;fill:#526775")]),
                    node(NodeKind.SvgText, content="books: 40", attributes=[attr("x", "35"), attr("y", "111"), attr("style", "fill:#2277aa;font-weight:700")]),
                    node(NodeKind.SvgText, content="25 + 15 locally", attributes=[attr("x", "178"), attr("y", "111"), attr("style", "font-size:17px;fill:#526775")]),
                    node(NodeKind.SvgText, content="Task 1 · partition 1", attributes=[attr("x", "35"), attr("y", "187"), attr("style", "font-size:19px;fill:#526775")]),
                    node(NodeKind.SvgText, content="books: 10", attributes=[attr("x", "35"), attr("y", "218"), attr("style", "fill:#2277aa;font-weight:700")]),
                    node(NodeKind.SvgText, content="games: 40", attributes=[attr("x", "35"), attr("y", "250"), attr("style", "fill:#996a1c;font-weight:700")]),
                    node(NodeKind.SvgText, content="Task 2 · partition 2", attributes=[attr("x", "35"), attr("y", "316"), attr("style", "font-size:19px;fill:#526775")]),
                    node(NodeKind.SvgText, content="music: 10", attributes=[attr("x", "35"), attr("y", "349"), attr("style", "fill:#218675;font-weight:700")]),
                ], attributes=[attr("style", "font-size:22px")]),
                node(NodeKind.SvgGroup, children=[
                    node(NodeKind.SvgPath, attributes=[attr("stroke", "#2277aa"), attr("d", "M340 107 C520 107 610 110 806 110")]),
                    node(NodeKind.SvgPath, attributes=[attr("stroke", "#2277aa"), attr("d", "M340 214 C545 214 604 151 806 151")]),
                    node(NodeKind.SvgPath, attributes=[attr("stroke", "#c28e37"), attr("d", "M340 246 C540 246 600 291 806 291")]),
                    node(NodeKind.SvgPath, attributes=[attr("stroke", "#39a08e"), attr("d", "M340 345 C540 345 640 339 806 339")]),
                ], attributes=[attr("fill", "none"), attr("stroke-width", "3"), attr("marker-end", "url(#sh-key-arrow)")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "815"), attr("y", "48"), attr("width", "477"), attr("height", "142"), attr("rx", "9"), attr("fill", "#e2f1fb"), attr("stroke", "#6aaddb")]),
                node(NodeKind.SvgText, content="Task 3 · shuffle partition 0", attributes=[attr("x", "836"), attr("y", "78"), attr("style", "font-size:19px;fill:#526775")]),
                node(NodeKind.SvgText, content="books: 40", attributes=[attr("x", "836"), attr("y", "115"), attr("style", "font-size:22px;fill:#2277aa")]),
                node(NodeKind.SvgText, content="books: 10", attributes=[attr("x", "836"), attr("y", "155"), attr("style", "font-size:22px;fill:#2277aa")]),
                node(NodeKind.SvgText, content="→", attributes=[attr("x", "971"), attr("y", "139"), attr("style", "font-size:30px")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "1020"), attr("y", "100"), attr("width", "252"), attr("height", "64"), attr("rx", "6"), attr("fill", "#e1f1df"), attr("stroke", "#8cba95")]),
                node(NodeKind.SvgText, content="books: 50", attributes=[attr("x", "1146"), attr("y", "140"), attr("text-anchor", "middle"), attr("style", "font-size:28px;font-weight:700;fill:#08753b")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "815"), attr("y", "228"), attr("width", "477"), attr("height", "143"), attr("rx", "9"), attr("fill", "#eef8ed"), attr("stroke", "#8cba95")]),
                node(NodeKind.SvgText, content="Task 4 · shuffle partition 1", attributes=[attr("x", "836"), attr("y", "258"), attr("style", "font-size:19px;fill:#526775")]),
                node(NodeKind.SvgText, content="games: 40", attributes=[attr("x", "836"), attr("y", "298"), attr("style", "font-size:22px;fill:#996a1c")]),
                node(NodeKind.SvgText, content="music: 10", attributes=[attr("x", "836"), attr("y", "345"), attr("style", "font-size:22px;fill:#218675")]),
                node(NodeKind.SvgText, content="→", attributes=[attr("x", "971"), attr("y", "323"), attr("style", "font-size:30px")]),
                node(NodeKind.SvgText, content="games: 40", attributes=[attr("x", "1035"), attr("y", "299"), attr("style", "font-size:23px;font-weight:700;fill:#996a1c")]),
                node(NodeKind.SvgText, content="music: 10", attributes=[attr("x", "1035"), attr("y", "345"), attr("style", "font-size:23px;font-weight:700;fill:#218675")]),
            ], attributes=[attr("viewBox", "0 0 1308 390"), attr("role", "img"), attr("aria-label", "The same three tasks send partial totals through a shuffle. Books 40 from task 0 and books 10 from task 1 meet in shuffle partition 0, where final aggregation produces books 50. Games 40 and music 10 share shuffle partition 1.")]),
        ], style="exec-shuffle"),
            prose("Partial aggregation reduces what moves. The shuffle brings matching keys together.", style="exec-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("52"),
        ]),
        ],
        notes="Continue the exact partition example from “Jobs, stages and tasks”. Task 0 has already combined books 25 and 15 into books 40. Task 1 contributes books 10 and games 40. Task 2 contributes music 10. Five input rows have become four partial records before transfer. The shuffle routes books 40 and books 10 to the same destination partition; final aggregation there produces books 50. Games and music each have only one partial, so their final values stay unchanged. This is useful contrast: aggregation changes values only where multiple contributions must be combined. Shuffle itself moves and groups records; the following aggregation adds the values. Distinct keys can share a partition; this routing is illustrative, not a claim about Spark's actual hash mapping. Tasks run on executors, not on the driver. Transfers can involve network and disk I/O; not every block must cross a machine boundary. Existing distribution can sometimes avoid an exchange. Task counts are illustrative. Connect to section 03: memory reuse does not eliminate shuffles.",
    )

pub def slide_adaptive_execution() -> Slide:
    steps = [
        TeachingStep(label="Two tasks planned",
            heading="Before executing Stage B: two tasks are planned.",
            explanation="One task would read each shuffle partition, as on the previous slide.",
            cue_key="", numbered=false),
        TeachingStep(label="Measure actual output",
            heading="Now Spark has evidence the initial plan did not have.",
            explanation="For this illustration, the output is small enough to read together.",
            cue_key="", numbered=false),
        TeachingStep(label="Adapt the next stage",
            heading="Same result. Fewer small tasks to schedule.",
            explanation="AQE can coalesce the reads of neighbouring shuffle partitions into one task.",
            cue_key="", numbered=false),
    ]
    return Slide(
        slug="adaptive-execution",
        title="Adaptive Query Execution",
        frame=Frame.Composed,
        styles="slide lesson-slide execution-content aqe-story-slide",
        content=[
            group([
            text("05 / FROM QUERY TO EXECUTION"),
        ], style="eyebrow"),
            heading("The plan can adapt as Spark learns", level=1),
            prose("Adaptive Query Execution (AQE) · the same shuffle, less downstream work.", style="subtitle"),
            group([
            step_rail(steps),
            group([
                group([
                    node(NodeKind.Span, children=[
                        text("Stage A "),
                        node(NodeKind.Bold, content="completed"),
                    ]),
                    span("→"),
                    node(NodeKind.Span, children=[
                        text("Shuffle output "),
                        node(NodeKind.Bold, content="available"),
                    ]),
                    span("→"),
                    node(NodeKind.Span, children=[
                        text("Stage B "),
                        node(NodeKind.Bold, content="can still adapt"),
                    ], style="aq-context-next"),
                ], style="aq-context"),
                group([
                    heading("The same shuffle partitions", level=2),
                    group([
                        node(NodeKind.Header, content="Shuffle partition 0"),
                        group([
                            node(NodeKind.Span, children=[
                                text("books "),
                                node(NodeKind.Bold, content="40"),
                            ]),
                            node(NodeKind.Span, children=[
                                text("books "),
                                node(NodeKind.Bold, content="10"),
                            ]),
                        ]),
                    ], style="aq-part aq-books"),
                    group([
                        node(NodeKind.Header, content="Shuffle partition 1"),
                        group([
                            node(NodeKind.Span, children=[
                                text("games "),
                                node(NodeKind.Bold, content="40"),
                            ]),
                            node(NodeKind.Span, children=[
                                text("music "),
                                node(NodeKind.Bold, content="10"),
                            ]),
                        ]),
                    ], style="aq-part aq-other"),
                    prose("The completed shuffle stays in place.", style="aq-source-note"),
                ], style="aq-source"),
                node(NodeKind.Svg, children=[
                    node(NodeKind.SvgDefinitions, children=[
                        node(NodeKind.SvgMarker, children=[
                            node(NodeKind.SvgPath, attributes=[attr("d", "M0 0 L10 5 L0 10Z"), attr("style", "fill:#54788f;stroke:none")]),
                        ], attributes=[attr("id", "aq-arrow"), attr("viewBox", "0 0 10 10"), attr("refX", "9"), attr("refY", "5"), attr("markerWidth", "6"), attr("markerHeight", "6"), attr("orient", "auto")]),
                    ]),
                    node(NodeKind.SvgGroup, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M420 147 H856"), attr("style", "fill:none;stroke:#54788f;stroke-width:2.5"), attr("marker-end", "url(#aq-arrow)")]),
                        node(NodeKind.SvgPath, attributes=[attr("d", "M420 265 H856"), attr("style", "fill:none;stroke:#54788f;stroke-width:2.5"), attr("marker-end", "url(#aq-arrow)")]),
                    ], style="aq-two-links"),
                    node(NodeKind.SvgGroup, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M420 147 C680 147 690 207 856 207"), attr("style", "fill:none;stroke:#54788f;stroke-width:2.5"), attr("marker-end", "url(#aq-arrow)")]),
                        node(NodeKind.SvgPath, attributes=[attr("d", "M420 265 C680 265 690 207 856 207"), attr("style", "fill:none;stroke:#54788f;stroke-width:2.5"), attr("marker-end", "url(#aq-arrow)")]),
                    ], style="aq-one-links"),
                ], style="aq-links", attributes=[attr("viewBox", "0 0 1308 365"), attr("aria-hidden", "true")]),
                group([
                    span("RUNTIME EVIDENCE", style="aq-observation-label"),
                    heading("Both are small.", level=2),
                    paragraph([
                        text("Spark now knows the"),
                        line_break(),
                        text("actual shuffle-output sizes."),
                    ]),
                    group([
                        span("P0"),
                        node(NodeKind.Italic, children=[
                            node(NodeKind.Bold),
                        ]),
                    ], style="aq-meter"),
                    group([
                        span("P1"),
                        node(NodeKind.Italic, children=[
                            node(NodeKind.Bold),
                        ]),
                    ], style="aq-meter"),
                    node(NodeKind.Small, content="Size illustration · not measured bytes"),
                ], style="aq-observation"),
                group([
                    heading("Stage B · initial plan", level=2),
                    group([
                        strong("Task 3"),
                        node(NodeKind.Span, children=[
                            text("Read partition 0"),
                            line_break(),
                            text("Final aggregate"),
                        ]),
                    ], style="aq-reader"),
                    group([
                        strong("Task 4"),
                        node(NodeKind.Span, children=[
                            text("Read partition 1"),
                            line_break(),
                            text("Final aggregate"),
                        ]),
                    ], style="aq-reader"),
                ], style="aq-planned"),
                group([
                    heading("Stage B · adapted plan", level=2),
                    group([
                        span("ONE DOWNSTREAM TASK", style="aq-one-badge"),
                        heading("Read both partitions", level=3),
                        prose("Final aggregate, by category"),
                        group([
                            node(NodeKind.Span, children=[
                                text("books "),
                                node(NodeKind.Bold, content="50"),
                            ]),
                            node(NodeKind.Span, children=[
                                text("games "),
                                node(NodeKind.Bold, content="40"),
                            ]),
                            node(NodeKind.Span, children=[
                                text("music "),
                                node(NodeKind.Bold, content="10"),
                            ]),
                        ], style="aq-results"),
                    ], style="aq-combined"),
                ], style="aq-adapted"),
            ], style="aq-story-canvas"),
            step_cues(steps),
            group([
                node(NodeKind.Button, content="Previous point", attributes=[attr("data-lesson-prev", flag=true)]),
                node(NodeKind.Button, content="Next point", attributes=[attr("data-lesson-next", flag=true)]),
                node(NodeKind.Button, content="Replay", attributes=[attr("data-lesson-reset", flag=true)]),
                span("Illustrative choice · depends on sizes and configuration", style="aq-scope"),
                span("", style="lesson-position", attributes=[attr("aria-live", "polite")]),
            ], style="lesson-controls"),
        ], style="lesson aqe-story", attributes=[attr("data-lesson", flag=true), attr("data-point", "2")]),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("53"),
        ]),
        ],
        notes="Continue the initial two-task plan from “Why shuffle?”, pausing before Stage B executes. The exact same partial totals remain: partition 0 has books 40 and books 10; partition 1 has games 40 and music 10. Ask: do these tiny outputs really need two separate tasks? Reveal runtime evidence, then adaptation. AQE uses actual map-output size statistics, not the sales amounts and not simply the displayed row count. The small bars illustrate size without claiming a measured benchmark. Post-shuffle coalescing lets one downstream task read a contiguous range of original shuffle partitions; it does not rerun or undo the completed shuffle. For this example it then aggregates by category, yielding books 50, games 40, music 10. The same keys still meet; different keys remain distinct. The 2-to-1 choice is illustrative and depends on configuration, target sizes, minimum parallelism and plan constraints. This is fewer tasks, not fewer worker machines: distinguish from Glue autoscaling later. AQE can also change eligible join strategies and mitigate skewed joins; these are other applications of the same runtime-feedback principle, not claims about this aggregation example. Source: https://spark.apache.org/docs/latest/sql-performance-tuning.html#adaptive-query-execution",
    )

pub def slide_explain_plan() -> Slide:
    return Slide(
        slug="explain-plan",
        title="Explain the plan",
        frame=Frame.Composed,
        styles="slide lesson-slide execution-content",
        content=[
            group([
            text("05 / FROM QUERY TO EXECUTION"),
        ], style="eyebrow"),
            heading("Explain the plan", level=1),
            prose("Recognise the operators from the story we just followed.", style="subtitle"),
            group([
            group([
                code_block("totals.explain(mode=\"extended\")"),
                prose("Unresolved → analysed → optimised → physical"),
                code_block("totals.explain(mode=\"formatted\")"),
                prose("Physical outline + operator details"),
                prose("Inspecting the plan does not compute the result rows.", style="explain-warning"),
            ]),
            group([
                span("SIMPLIFIED PHYSICAL OUTLINE · READ BOTTOM-UP", style="exec-label"),
                node(NodeKind.Preformatted, content="""HashAggregate  ← final totals
└─ Exchange    ← shuffle by category
   └─ HashAggregate  ← partial totals
      └─ Filter      ← amount > 0
         └─ Scan parquet""", style="explain-tree"),
                paragraph([
                    text("With AQE, look for "),
                    code("AdaptiveSparkPlan"),
                    text("."),
                    line_break(),
                    text("An initial plan may change during execution."),
                ]),
            ]),
        ], style="explain-layout"),
            prose("Where will data move? What work happens before and after that?", style="exec-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("54"),
        ]),
        ],
        notes="Use the same totals DataFrame. Left snippets are valid API calls; right outline is intentionally simplified teaching text, not captured Spark output. Real explain labels, pushed filters, wrappers, attribute ids and operator choices vary by version, source and configuration. extended labels the first part Parsed Logical Plan even for DataFrame expressions; relate it to unresolved. formatted includes node details not shown here. explain may analyse/plan and access metadata but does not execute this query to produce result rows. It is not a timings report. Initial AQE output can show isFinalPlan=false; a later executed plan may differ, but do not promise that explaining totals after show always exposes the final plan used by show, which can wrap the query. No Spark UI demonstration here. Leave execution inspection for the dedicated Glue subsection. Source: https://spark.apache.org/docs/3.5.9/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrame.explain.html",
    )

pub def slide_query_execution_recap() -> Slide:
    return Slide(
        slug="query-execution-recap",
        title="Query execution: recap",
        frame=Frame.Composed,
        styles="slide chapter-recap recap-five",
        content=[
            group([
            text("05 / FROM QUERY TO EXECUTION"),
        ], style="eyebrow"),
            heading("Query execution: recap", level=1),
            node(NodeKind.Table, children=[
            node(NodeKind.Caption, content="Query execution: recap: key takeaways", style="sr-only"),
            node(NodeKind.Columns, children=[
                node(NodeKind.Column),
                node(NodeKind.Column),
            ]),
            node(NodeKind.TableBody, children=[
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Planning", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="Catalyst resolves the request, optimises it and chooses physical operators."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Stages and tasks", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="The driver schedules stage tasks on executors. Each task processes a partition."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Shuffle", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="An exchange redistributes data. Downstream tasks read it in the required partitioning."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Adaptation", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, content="AQE can revise downstream work using statistics collected during execution."),
                ]),
                node(NodeKind.Row, children=[
                    node(NodeKind.HeaderCell, content="Inspection", attributes=[attr("scope", "row")]),
                    node(NodeKind.Cell, children=[
                        code("explain()"),
                        text(" shows the plan. Inspecting it does not compute the result rows."),
                    ]),
                ]),
            ]),
        ], style="chapter-recap-table"),
            prose("Follow the plan to see where data moves and what each stage has to do.", style="chapter-recap-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("55"),
        ]),
        ],
        notes="""Recall the category totals: local aggregation, exchange, then final aggregation. A task belongs to a stage; an executor is a process that can run many tasks. Stages are not dedicated machines. The driver schedules work, while the cluster manager allocates application resources. AQE may revise downstream choices after runtime statistics become available; it does not make completed shuffle work free. One action is not a guarantee of exactly one Spark job.

https://spark.apache.org/docs/4.2.0/cluster-overview.html
https://spark.apache.org/docs/4.2.0/sql-performance-tuning.html""",
    )

pub def chapter_05_chapter() -> Chapter:
    return Chapter(number="5", title="05 / FROM QUERY TO EXECUTION", first_page=1, slides=[
        slide_section_5(),
        slide_operations(),
        slide_catalyst_planning(),
        slide_execution_stages(),
        slide_execution_placement(),
        slide_execution_shuffle(),
        slide_adaptive_execution(),
        slide_explain_plan(),
        slide_query_execution_recap(),
    ])

"""Section 04 authored as Incan surfaces and teaching steps.

This prototype explores Pallay-like composition. It is not a Pallay API.
The HTML target, visual styles and browser controls live outside this content.
"""

from surface import Attribute, Chapter, Frame, NodeKind, Slide, Surface, TeachingStep, cell, code, code_block, emphasis, group, heading, image, line_break, link, paragraph, prose, rich_heading, row, span, strong, table, text
from components import ApiRow, CodeExample, Phase, Takeaway, api_comparison, code_question, flow, recap_table

pub def cover() -> Slide:
    return Slide(
        slug="section-4",
        title="Lazy Pandas",
        frame=Frame.Cover,
        content=[
            image("assets/lazy-pandas-intro.png", "A panda resting on glass-like data tables, with data tiles waiting nearby.", style="lazy-intro-image"),
            group([], style="lazy-intro-shade"),
            group([
                rich_heading([
                    text("Lazy"),
                    line_break(),
                    emphasis("Pandas"),
                ], level=1),
                prose("Pandas? … Lazy? …"),
            ], style="lazy-intro-copy"),
        ],
        notes="Continue the handoff from the previous slide: “But first… let’s talk about Lazy Pandas.” Let the image land, then ask: “Any idea how this relates to the story you just heard about DataFrames?” Pause and take answers before explaining. Listen for whether participants distinguish describing transformations from executing the work. If needed, prompt: “When we wrote that filter and select, had Spark already processed the data?” Keep Catalyst as an open thread to return to; do not explain the optimiser here. The panda is a visual pun, not a claim that the pandas library evaluates lazily. Transition into transformations and actions after the audience has responded.",
    )

pub def pandas_and_spark() -> Slide:
    return Slide(
        slug="lazy-pandas",
        title="Pandas vs. Spark DataFrames",
        frame=Frame.Lesson,
        subtitle="The operations look familiar. When they run is different.",
        content=[
            api_comparison([
                ApiRow(operation="Select", pandas="df[[\"category\", \"amount\"]]", spark="df.select(\"category\", \"amount\")"),
                ApiRow(operation="Filter", pandas="df[df[\"amount\"] > 20]", spark="df.filter(col(\"amount\") > 20)"),
                ApiRow(operation="Sort", pandas="df.sort_values(\"amount\")", spark="df.orderBy(\"amount\")"),
                ApiRow(operation="Display rows", pandas="print(df.head(5))", spark="df.show(5)"),
            ]),
            group([
                paragraph([
                    strong("pandas"),
                    text("These operations compute as called."),
                ]),
                paragraph([
                    strong("Spark"),
                    text("Transformations build a plan."),
                    line_break(),
                    text("An action requests execution."),
                ]),
            ], style="lazy-timing"),
        ],
        notes="Based on original workshop slide 23. Start from familiarity, not a comprehensive API cheat sheet. Ask which operations people recognise. Assume df is an existing DataFrame, and col is imported from pyspark.sql.functions. These are separate snippets, not one program. Standard in-memory pandas is generally eager for these operations; pandas copy-on-write is a different concept, not Spark-style lazy query execution. We are not discussing pandas API on Spark here. No obsolete DataFrame.append; no invalid pandas header=True. Transition: let us watch what happens as we write a few Spark transformations. Source: https://spark.apache.org/docs/3.5.8/api/python/getting_started/quickstart_df.html",
    )

pub def lazy_definition() -> Slide:
    return Slide(
        slug="lazy-definition",
        title="Lazy — a definition",
        frame=Frame.Definition,
        content=[
            group([
                heading("lazy", level=1),
                paragraph([
                    span("/ˈleɪzi/"),
                    emphasis("adjective"),
                ], style="id-pronunciation"),
                paragraph([
                    text("unwilling to work or be active;"),
                    line_break(),
                    text("doing as little as possible"),
                ], style="id-definition"),
                paragraph([
                    link("Oxford Learner’s Dictionaries", "https://www.oxfordlearnersdictionaries.com/definition/english/lazy"),
                ], style="id-source"),
            ], style="id-entry"),
        ],
        notes="""Read the ordinary meaning, then pause. Suggested line: “In Spark, this is a compliment.” Continue to the filter, select and show example: transformations describe the work, and the action requests a result. The following slide explains the distinction using an existing DataFrame, including the qualification that analysis and input discovery may do work earlier.

Definition and pronunciation: Oxford Advanced Learner’s Dictionary, lazy (adjective), first sense. https://www.oxfordlearnersdictionaries.com/definition/english/lazy""",
    )

pub def query_walkthrough() -> Slide:
    return Slide(
        slug="dataframe-example",
        title="Spark is Lazy",
        frame=Frame.Lesson,
        subtitle="Describe the work first. Request the result afterwards.",
        content=[
            group([
                group([
                    code_block("""filtered = sales.filter(col("amount") > 20)

amounts = filtered.select("amount")

amounts.show()"""),
                    paragraph([
                        text("Same sales: books 25 · games 40"),
                        line_break(),
                        text("books 15 · music 10"),
                    ]),
                ], style="lazy-script"),
                group([
                    span("sales", style="lazy-stage source-stage"),
                    span("↓", style="lazy-connector filter-reveal"),
                    span("Filter · amount > 20", style="lazy-stage filter-reveal"),
                    span("↓", style="lazy-connector select-reveal"),
                    span("Select · amount", style="lazy-stage select-reveal"),
                    group([
                        text("show() requests rows →"),
                    ], style="lazy-request action-reveal"),
                    group([
                        span("amount"),
                        Surface(kind=NodeKind.Bold, content="25"),
                        Surface(kind=NodeKind.Bold, content="40"),
                    ], style="lazy-output action-reveal"),
                    paragraph([
                        span("Plan described · result not computed", style="before-action"),
                        span("Execute the required plan", style="after-action"),
                    ], style="lazy-plan-status"),
                ], style="lazy-plan"),
            ], style="lazy-walk-grid"),
        ],
        lesson_style="lazy-walk",
        steps=[
            TeachingStep(label="Existing DataFrame",
                heading="The data we already know",
                explanation="Assume sales already exists. We are following the query we build from it."),
            TeachingStep(label="Filter",
                heading="filter() returns a new DataFrame",
                explanation="The filter is added to the plan. It has not scanned the rows to produce filtered."),
            TeachingStep(label="Select",
                heading="select() extends that plan",
                explanation="We ask for one column. Still no result rows have been requested."),
            TeachingStep(label="Action",
                heading="show() is the action",
                explanation="Spark executes the required work and displays the requested rows. No ordering is guaranteed here."),
        ],
        notes="Based on original slides 24–27. Follow the preceding dictionary entry with this concrete walkthrough. Read the code line by line using Next point. Before revealing the action ask: Have we computed the filtered rows yet? After select ask: What do we need to make this run? The diagram is the conceptual request, not an exact physical plan or a promise of one job/stage. show may issue more than one job and only requests a limited number of rows; exact task count is not taught here. sales is an existing DataFrame containing the same four records, with col imported. Reads/schema inference/metadata discovery and analysis can do work before an action; we intentionally start from an existing DataFrame. Errors can occur during analysis or execution, not universally at action time. Output order is illustrative, not guaranteed without orderBy. Sources: https://spark.apache.org/docs/3.5.8/api/python/getting_started/quickstart_df.html ; https://spark.apache.org/docs/latest/spark-connect-gotchas.html",
    )

pub def transformations_and_actions() -> Slide:
    return Slide(
        slug="transformations-actions",
        title="Transformations and Actions",
        frame=Frame.Lesson,
        subtitle="Which of these asks Spark to produce a result?",
        content=[
            code_question(
                left=CodeExample(code="""sales.filter(col("amount") > 20)
sales.select("amount")
sales.groupBy("category").count()""", answer="Transformations", explanation="Return a new DataFrame describing work."),
                right=CodeExample(code="""sales.show()
sales.count()
sales.write.parquet("output/")""", answer="Actions", explanation="Request rows, a scalar, or written output."),
            ),
        ],
        lesson_style="lazy-quiz",
        steps=[
            TeachingStep(label="Your prediction",
                heading="Ask the room before revealing the labels",
                explanation="Look at both count() calls. Do they return the same kind of thing?"),
            TeachingStep(label="Transformations",
                heading="GroupedData.count() builds an aggregate",
                explanation="It returns a DataFrame. The aggregate is still a plan until a result is requested."),
            TeachingStep(label="Actions",
                heading="DataFrame.count() requests a number",
                explanation="show(), count() and a batch write trigger the work their result requires."),
        ],
        notes="Based on original workshop slide 28. Give the audience time to classify the examples. Explain that transformations create new DataFrames; they do not mutate existing rows in place. DataFrame.count returns an integer, but groupBy(...).count returns a DataFrame. The receiver matters. An action computes its own dependency path, not every unrelated branch in the program. Batch write executes even though it does not bring all result rows to the driver. Repeating actions may repeat computation unless suitable persistence/reuse applies; lazy does not mean automatically cached. Example output path is illustrative; not actually written in this presentation. Avoid collect as the default example for large data. Source: https://spark.apache.org/docs/latest/api/python/reference/pyspark.sql/dataframe.html",
    )

pub def action_results() -> Slide:
    return Slide(
        slug="action-results",
        title="What does an action ask for?",
        frame=Frame.ActionDetail,
        subtitle="Same four sales: books 25 · games 40 · books 15 · music 10",
        content=[
            group([
                group([
                    code_block("""from pyspark.sql import functions as F

books = sales.filter(
    F.col("category") == "books")""", style="ar-definition"),
                    code_block("books.show(5)", style="ar-call ar-show"),
                    code_block("number_of_books = books.count()", style="ar-call ar-count"),
                    code_block("books.write.parquet(\"output/books\")", style="ar-call ar-write"),
                ], style="ar-code"),
                group([
                    group([
                        heading("A DataFrame"),
                        prose("books", style="ar-variable"),
                        paragraph([
                            text("Keep rows where"),
                            line_break(),
                            code("category == \"books\""),
                        ], style="ar-condition"),
                        prose("The filtered rows have not been computed.", style="ar-detail"),
                    ], style="ar-result ar-defined"),
                    group([
                        heading("Displayed rows"),
                        table([
                            Surface(kind=NodeKind.Caption, content="The two books sales displayed by show", style="sr-only"),
                            Surface(kind=NodeKind.TableHead, children=[
                                row([
                                    cell([
                                        text("category"),
                                    ], header=true),
                                    cell([
                                        text("amount"),
                                    ], header=true),
                                ]),
                            ]),
                            Surface(kind=NodeKind.TableBody, children=[
                                row([
                                    cell([
                                        text("books"),
                                    ]),
                                    cell([
                                        text("25"),
                                    ]),
                                ]),
                                row([
                                    cell([
                                        text("books"),
                                    ]),
                                    cell([
                                        text("15"),
                                    ]),
                                ]),
                            ]),
                        ], style="ar-preview"),
                        prose("Up to 5 rows. Order shown is illustrative.", style="ar-detail"),
                        paragraph([
                            text("Python return: "),
                            code("None"),
                        ], style="ar-return"),
                    ], style="ar-result ar-displayed"),
                    group([
                        heading("A value in Python"),
                        prose("number_of_books", style="ar-variable-name"),
                        prose("2", style="ar-number"),
                        prose("An integer: the number of books sales.", style="ar-detail"),
                    ], style="ar-result ar-counted"),
                    group([
                        heading("Files in storage"),
                        paragraph([
                            code("output/books/"),
                        ], style="ar-directory"),
                        group([
                            strong("Parquet data files"),
                            span("The two books rows are saved here."),
                        ], style="ar-file-result"),
                        prose("The output can contain multiple files.", style="ar-detail"),
                        paragraph([
                            text("Python return: "),
                            code("None"),
                        ], style="ar-return"),
                    ], style="ar-result ar-written"),
                    group([
                        heading("Return values and effects"),
                        table([
                            Surface(kind=NodeKind.TableBody, children=[
                                row([
                                    cell([
                                        text("show(5)"),
                                    ], header=true),
                                    cell([
                                        text("Returns "),
                                        code("None"),
                                        text("."),
                                        line_break(),
                                        text("Displays the two books rows."),
                                    ]),
                                ]),
                                row([
                                    cell([
                                        text("count()"),
                                    ], header=true),
                                    cell([
                                        text("Returns the integer "),
                                        strong("2"),
                                        text("."),
                                    ]),
                                ]),
                                row([
                                    cell([
                                        text("write"),
                                    ], header=true),
                                    cell([
                                        text("Returns "),
                                        code("None"),
                                        text("."),
                                        line_break(),
                                        text("Writes Parquet files."),
                                    ]),
                                ]),
                            ]),
                        ]),
                    ], style="ar-summary"),
                ], style="ar-output", attributes=[Attribute(name="aria-live", value="polite")]),
            ], style="ar-layout"),
        ],
        lesson_style="action-requests",
        steps=[
            TeachingStep(label="Define books",
                heading="What have we created?",
                explanation="A new DataFrame describing the books sales. Assigning it to a variable has not materialised the rows."),
            TeachingStep(label="Display rows",
                heading="show() asks for a preview.",
                explanation="Spark executes the work needed to display up to five rows."),
            TeachingStep(label="Count rows",
                heading="count() asks for a number.",
                explanation="Spark counts the matching rows. Python receives the integer 2."),
            TeachingStep(label="Write files",
                heading="A batch write is also an action.",
                explanation="Spark executes the work needed to save the result in storage."),
        ],
        notes="""Continue from the classification exercise. Reuse the same four-row sales DataFrame from Spark is Lazy: books25, games40, books15 and music10. It is an existing DataFrame backed by our Parquet example, with category and amount columns, and has not been cached. F is explicitly imported. Do not switch to a new createDataFrame syntax or introduce the later five-row sales example yet.

Define books: ask what the variable contains. The transformation returns a new DataFrame representing a query, without materialising its result rows. The sales DataFrame is unchanged. Query analysis or source metadata work can already occur; this is not a claim that the driver has done absolutely nothing.

Display: reveal show(5). Spark displays up to five matching rows. There are two in this illustrative input. The table order is not guaranteed; no orderBy is present. show returns None, not a Python list of those rows, and it need not compute every partition for a limited preview. It can issue more than one job.

Count: reveal the assignment and the Python integer 2. This is DataFrame.count(), the action, not GroupedData.count(). The output is a number of rows, not the amount total 40.

Write: reveal the batch write. The output path denotes a Parquet dataset location and can contain multiple part files. We are not illustrating a single file per row or an exact number of tasks/files. On successful completion, write.parquet returns None to Python; creating files is its side effect. The full result is written to storage rather than collected into the Python variable. The default write mode errors if the destination already exists; use a fresh output path for an actual demonstration. This deck does not execute the write. All actions remain subject to their own optimised plan.

Transition: We have requested three results from the same books DataFrame. Does that mean Spark computed it once and kept it?
https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrame.filter.html
https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrame.show.html
https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrame.count.html
https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrameWriter.parquet.html""",
    )

pub def repeated_actions() -> Slide:
    return Slide(
        slug="actions-repeat",
        title="What happens when we ask again?",
        frame=Frame.ActionDetail,
        subtitle="The same books DataFrame, with no persistence requested.",
        content=[
            group([
                group([
                    span("Action"),
                    span("Work that can be repeated"),
                    span("Python return"),
                    span("Side effect"),
                ], style="rr-head"),
                group([
                    code_block("books.show(5)"),
                    group([
                        span("Read sales"),
                        Surface(kind=NodeKind.Bold, content="→", attributes=[Attribute(name="aria-hidden", value="true")]),
                        span("Filter books"),
                    ], style="rr-work"),
                    group([
                        code("None"),
                    ], style="rr-result"),
                    group([
                        text("Displays rows"),
                    ], style="rr-effect"),
                ], style="rr-row rr-first"),
                group([
                    code_block("number_of_books = books.count()"),
                    group([
                        span("Read sales"),
                        Surface(kind=NodeKind.Bold, content="→", attributes=[Attribute(name="aria-hidden", value="true")]),
                        span("Filter books"),
                    ], style="rr-work"),
                    group([
                        code("2"),
                    ], style="rr-result"),
                    group([
                        span("—", attributes=[Attribute(name="aria-hidden", value="true")]),
                        span("No displayed rows or written files", style="sr-only"),
                    ], style="rr-effect"),
                ], style="rr-row rr-second"),
                group([
                    code_block("books.write.parquet(\"output/books\")"),
                    group([
                        span("Read sales"),
                        Surface(kind=NodeKind.Bold, content="→", attributes=[Attribute(name="aria-hidden", value="true")]),
                        span("Filter books"),
                    ], style="rr-work"),
                    group([
                        code("None"),
                    ], style="rr-result"),
                    group([
                        text("Writes Parquet files"),
                    ], style="rr-effect"),
                ], style="rr-row rr-third"),
                group([
                    group([
                        span("For reuse, before the actions"),
                        code("books.cache()"),
                    ]),
                    paragraph([
                        text("Store partitions as they are computed."),
                        line_break(),
                        text("Release them afterwards with "),
                        code("books.unpersist()"),
                        text("."),
                    ]),
                ], style="rr-reuse"),
            ], style="rr-layout"),
        ],
        lesson_style="action-repeat",
        steps=[
            TeachingStep(label="Show",
                heading="Displaying a preview does not cache the DataFrame.",
                explanation="The books variable still describes the query."),
            TeachingStep(label="Then count",
                heading="Counting can require the read and filter again.",
                explanation="The previous preview did not request a reusable copy of all the books rows."),
            TeachingStep(label="Then write",
                heading="The write is another request for work.",
                explanation="The plan can differ for each action. Reusing the variable does not guarantee reuse of computed rows."),
            TeachingStep(label="Reusing work",
                heading="Persistence is a separate choice.",
                explanation="As we saw earlier, cached partitions can support later actions. Use it when the reuse is worth the storage."),
        ],
        notes="""Ask: We already displayed the books. Will count reuse that output? There has been no cache or persist request in this example. A Python reference to a DataFrame retains the query description, not an automatic materialised copy of the result. Reveal each successive request at the presenter's pace. Read and filter blocks indicate possible repeated upstream work, not exact physical plans, measured I/O or one whole scan per action. show can stop after enough rows, count can prune columns or benefit from source-specific optimisations, and the engine or storage layers may reuse some work. Say can repeat, not always rereads every byte. An action only requests its dependency path, not every unrelated transformation in the program. One action is not a guarantee of one job.

Python return values are separate from visible side effects. On successful completion, show returns None and displays rows; write.parquet returns None and writes files. DataFrame.count returns the integer 2 in this example. The side-effect column refers to displayed rows or written output, not a claim that executing count has no internal effects on Spark.

The final point is a callback to the earlier persistence material, not an instruction to cache every DataFrame. If repeated reuse justifies the cost, call books.cache() or a suitable persist() before the actions. That requests persistence; the cache is populated as partitions are computed. A limited show need not populate all partitions. Later actions can reuse retained partitions and compute any that are still missing. Cache blocks can be evicted or lost, causing recomputation, and storage/serialization costs affect the tradeoff. unpersist when done. The write example is illustrative and is not executed; use a fresh destination in a live demonstration.

Return to Why wait? after this practical consequence. Lazy evaluation lets Spark optimise the requested work. Section 05 follows that request into the actual planning and execution mechanics.
https://spark.apache.org/docs/4.2.0/sql-performance-tuning.html#caching-data
https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrame.cache.html
https://spark.apache.org/docs/4.2.0/rdd-programming-guide.html#rdd-persistence
https://spark.apache.org/docs/4.2.0/api/python/_modules/pyspark/sql/dataframe.html#DataFrame.show
https://spark.apache.org/docs/4.2.0/api/python/_modules/pyspark/sql/readwriter.html#DataFrameWriter.parquet""",
    )

pub def why_wait() -> Slide:
    return Slide(
        slug="why-lazy",
        title="Why wait?",
        frame=Frame.Lesson,
        subtitle="Spark can see the whole request before processing the rows.",
        content=[
            group([
                code_block("""amounts = sales.filter(col("amount") > 20).select("amount")
amounts.show()"""),
            ], style="lazy-benefit-code"),
            flow([
                Phase(label="YOU DESCRIBE", title="Filter + select", description=[
                    text("Only amounts above 20."),
                    line_break(),
                    text("Only the amount column."),
                ]),
                Phase(label="SPARK CAN PLAN", title="Less work", description=[
                    text("Prune unused columns."),
                    line_break(),
                    text("Combine compatible operations."),
                ]),
                Phase(label="YOU REQUEST", title="A result", description=[
                    text("Run the work needed"),
                    line_break(),
                    text("for this action."),
                ]),
            ]),
            prose("This is where Catalyst comes back into the story.", style="lazy-catalyst-return"),
        ],
        notes="Based on original slides 26–28. Close the open thread from the overview before the panda cover. Lazy evaluation provides the opportunity to inspect the whole relational request; Catalyst supplies the analysis and optimisation. Laziness alone does not guarantee a speedup or automatically memoise every result. Column pruning benefits depend on the source; the earlier Parquet example is a suitable illustration. Combining operators does not remove every shuffle, and actions need not execute all earlier transformations literally or separately. Explain the practical payoff without drawing the detailed Catalyst architecture yet; that is section 05. If asked about repeated actions: without persistence they can repeat work. If asked about failures: some are caught during analysis, others during execution. Do not promise delayed errors universally. Transition: how does Spark turn this request into work on the cluster? Source: https://spark.apache.org/docs/latest/sql-programming-guide.html",
    )

pub def recap() -> Slide:
    return Slide(
        slug="lazy-evaluation-recap",
        title="Lazy evaluation: recap",
        frame=Frame.Recap,
        content=[
            recap_table([
                Takeaway(label="Transformations", explanation=[
                    text("Return a new DataFrame describing work, such as "),
                    code("filter()"),
                    text(" or "),
                    code("select()"),
                    text("."),
                ]),
                Takeaway(label="Actions", explanation=[
                    text("Request a result: "),
                    code("show()"),
                    text(" displays rows, "),
                    code("count()"),
                    text(" returns a number, and a batch write saves output."),
                ]),
                Takeaway(label="The two counts", explanation=[
                    code("sales.groupBy(\"category\").count()"),
                    text(" builds an aggregate DataFrame."),
                    line_break(),
                    code("sales.count()"),
                    text(" requests a number."),
                ]),
                Takeaway(label="Required work", explanation=[
                    text("An action computes its own dependencies. Unrelated branches are not all executed."),
                ]),
            ], caption="Lazy evaluation: recap: key takeaways"),
            prose("Lazy evaluation gives Spark room to optimise. It does not mean the result is cached.", style="chapter-recap-takeaway"),
        ],
        notes="""Original corpus: Section 2, 2.5 Spark Data Operations, slides 6–7 and 10. The current chapter already has the explicit Transformations and Actions lesson and its count-versus-grouped-count comparison. Avoid the original wording that actions execute all transformations collected so far: only the required dependency path is computed. Transformations do not mutate the existing DataFrame. Query analysis or metadata work can occur before an action; laziness refers to computing result rows.

https://spark.apache.org/docs/4.2.0/rdd-programming-guide.html#rdd-operations
https://spark.apache.org/docs/latest/spark-connect-gotchas.html
https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.sql/api/pyspark.sql.GroupedData.count.html
https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.sql/api/pyspark.sql.DataFrame.count.html""",
    )


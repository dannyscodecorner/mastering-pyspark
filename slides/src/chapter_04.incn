    return Chapter(
        number="04",
        title="LAZY PANDAS",
        first_page=38,
        slides=[
            cover(),
            pandas_and_spark(),
            lazy_definition(),
            query_walkthrough(),
            transformations_and_actions(),
            action_results(),
            repeated_actions(),
            why_wait(),
            recap(),
        ],
    )

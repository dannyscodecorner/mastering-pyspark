pub def slide_pyspark_setup() -> Slide:
    return Slide(
        slug="pyspark-setup",
        title="Set up the lab",
        frame=Frame.Composed,
        styles="slide ho-lesson",
        content=[
            group([
            text("08 / WORKING WITH PYSPARK"),
        ], style="eyebrow"),
            heading("Set up the lab", level=1),
            group([
            group([
                heading("In the VS Code terminal", level=2),
                paragraph([
                    text("Open the extracted "),
                    code("chapter08"),
                    text(" folder."),
                ]),
                node(NodeKind.Preformatted, children=[
                    node(NodeKind.Code, content="""java -version
uv sync --locked
uv run --locked check_setup.py""", style="language-text"),
                ]),
                prose("Java 21 · Python 3.12 · PySpark 4.2.0", style="ho-note"),
                paragraph([
                    text("Look for: "),
                    strong("Setup check passed"),
                ], style="ho-setup-pass"),
            ]),
            group([
                heading("Work through the exercise cells", level=2),
                prose("Add the optional interactive dependencies:"),
                node(NodeKind.Preformatted, children=[
                    node(NodeKind.Code, content="uv sync --locked --group notebook", style="language-text"),
                ]),
                node(NodeKind.OrderedList, children=[
                    node(NodeKind.ListItem, content="Enable VS Code’s Python and Jupyter extensions."),
                    node(NodeKind.ListItem, children=[
                        text("Open "),
                        code("hands_on.py"),
                        text(" and select the project’s "),
                        code(".venv"),
                        text(" kernel."),
                    ]),
                    node(NodeKind.ListItem, children=[
                        text("Run its "),
                        strong("Setup"),
                        text(" cell to create "),
                        code("spark"),
                        text("."),
                    ]),
                ], style="ho-steps"),
                paragraph([
                    code("hands-on.ipynb"),
                    text(" contains the same exercises."),
                ], style="ho-note"),
            ]),
        ], style="ho-workgrid ho-setup-grid"),
            paragraph([
            text("Course repository: "),
            node(NodeKind.Link, content="dannyscodecorner/mastering-pyspark", attributes=[attr("href", "https://github.com/dannyscodecorner/mastering-pyspark"), attr("target", "_blank"), attr("rel", "noopener")]),
        ], style="ho-takeaway"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("106"),
        ]),
        ],
        notes="Walk through the existing uv project, rather than installing a separate Spark distribution or using Docker. Run the setup check before class wherever possible; show what success looks like here. Its check includes file writes and checkpoint restart, not just launching Spark. For cell-by-cell work, the optional notebook dependency group supplies ipykernel; the Python and Jupyter extensions supply Run Cell in VS Code. Select the project .venv as the Interactive window kernel; do not use another system Python. The script can also run end to end with uv run --locked hands_on.py, but that executes the complete worked reference. During class, run the Setup cell and then one numbered exercise at a time. The local helper starts Spark with two threads, UTC and two shuffle partitions for this tiny fixture. On native Windows, follow README requirements for the matching Hadoop components and validate on an attendee machine. Danny will bring a spare MacBook prepared with the same project as a classroom fallback. https://docs.astral.sh/uv/guides/projects/ https://code.visualstudio.com/docs/python/jupyter-support-py https://spark.apache.org/docs/4.2.0/index.html",
    )

pub def slide_pyspark_inputs() -> Slide:
    return Slide(
        slug="pyspark-inputs",
        title="Exercise 1 · Inspect the inputs",
        frame=Frame.Composed,
        styles="slide ho-lesson ho-exercise",
        content=[
            group([
            text("08 / WORKING WITH PYSPARK"),
        ], style="eyebrow"),
            heading("Exercise 1 · Inspect the inputs", level=1),
            group([
            group([
                heading("Your task", level=2),
                node(NodeKind.OrderedList, children=[
                    node(NodeKind.ListItem, content="Load the sales and product Parquet files."),
                    node(NodeKind.ListItem, content="Inspect both schemas and their rows."),
                    node(NodeKind.ListItem, content="Find values that need cleaning before the join."),
                ], style="ho-steps"),
            ]),
            group([
                heading("Check your result", level=2),
                node(NodeKind.Table, children=[
                    node(NodeKind.Caption, content="Prepared input sizes", style="sr-only"),
                    node(NodeKind.TableHead, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="Input", attributes=[attr("scope", "col")]),
                            node(NodeKind.HeaderCell, content="Rows", attributes=[attr("scope", "col")]),
                        ]),
                    ]),
                    node(NodeKind.TableBody, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="Sales"),
                            node(NodeKind.Cell, content="8"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="Products"),
                            node(NodeKind.Cell, content="3"),
                        ]),
                    ]),
                ], style="ho-table"),
                prose("Amounts and timestamps are stored as strings. Keys and categories have inconsistent case and spaces.", style="ho-note"),
            ]),
        ], style="ho-workgrid"),
            group([
            heading("Code to work with", level=2),
            code_block("""raw = spark.read.parquet(spark_path(DATA_ROOT / "sales.parquet"))
raw_products = spark.read.parquet(spark_path(DATA_ROOT / "products.parquet"))
raw.printSchema(); raw.orderBy("sale_id").show(truncate=False)"""),
        ], style="ho-hint"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("107"),
        ]),
        ],
        notes="Ask participants to inspect the raw input before explaining the problems. The prepared sales file has eight rows: five valid sales and three deliberately invalid records. The product lookup has three rows, including X1 with no sale. Parquet provides a schema, but that does not establish valid business values. Reuse the prepared files; do not introduce createDataFrame syntax. Both amounts and timestamps are strings here by design.",
    )

pub def slide_pyspark_cleaning() -> Slide:
    return Slide(
        slug="pyspark-cleaning",
        title="Exercise 2 · Clean the keys",
        frame=Frame.Composed,
        styles="slide ho-lesson ho-exercise",
        content=[
            group([
            text("08 / WORKING WITH PYSPARK"),
        ], style="eyebrow"),
            heading("Exercise 2 · Clean the keys", level=1),
            group([
            group([
                heading("Your task", level=2),
                node(NodeKind.OrderedList, children=[
                    node(NodeKind.ListItem, children=[
                        text("Import "),
                        code("pyspark.sql.functions"),
                        text(" as "),
                        code("F"),
                        text("."),
                    ]),
                    node(NodeKind.ListItem, content="Trim and uppercase product keys on both sides."),
                    node(NodeKind.ListItem, content="Trim and lowercase the product categories. Put the key expression in a reusable helper."),
                ], style="ho-steps"),
            ]),
            group([
                heading("Check your result", level=2),
                node(NodeKind.Table, children=[
                    node(NodeKind.Caption, content="Expected normalized values", style="sr-only"),
                    node(NodeKind.TableHead, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="Input", attributes=[attr("scope", "col")]),
                            node(NodeKind.HeaderCell, content="Clean value", attributes=[attr("scope", "col")]),
                        ]),
                    ]),
                    node(NodeKind.TableBody, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, children=[
                                code("\" b1 \""),
                            ]),
                            node(NodeKind.Cell, content="B1"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, children=[
                                code("\"g1\""),
                            ]),
                            node(NodeKind.Cell, content="G1"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, children=[
                                code("\" Books \""),
                            ]),
                            node(NodeKind.Cell, content="books"),
                        ]),
                    ]),
                ], style="ho-table"),
                paragraph([
                    code("F"),
                    text(" is an alias for the functions module."),
                ], style="ho-note"),
            ]),
        ], style="ho-workgrid"),
            group([
            heading("Code to work with", level=2),
            code_block("""from pyspark.sql import functions as F

key = F.upper(F.trim(F.col("product_id")))"""),
        ], style="ho-hint"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("108"),
        ]),
        ],
        notes="Callback: you have seen functions as F earlier; now use it. F.col refers to a column; F.lit creates a literal expression, which we use later for unmapped. Use select and withColumn to apply the expressions. A Python helper returning Column constructs an expression on the driver; Spark evaluates its built-in operations. This differs from a Python UDF, whose custom code executes on values in Python workers. The lesson includes that explanation; the pipeline needs no UDF. Apply this normalization policy to the provided ASCII keys, without claiming it suits every business identifier. https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.sql/functions.html",
    )

pub def slide_pyspark_types() -> Slide:
    return Slide(
        slug="pyspark-types",
        title="Exercise 3 · Validate the sales",
        frame=Frame.Composed,
        styles="slide ho-lesson ho-exercise",
        content=[
            group([
            text("08 / WORKING WITH PYSPARK"),
        ], style="eyebrow"),
            heading("Exercise 3 · Validate the sales", level=1),
            group([
            group([
                heading("Your task", level=2),
                node(NodeKind.OrderedList, children=[
                    node(NodeKind.ListItem, content="Parse amounts as decimals and timestamps as UTC."),
                    node(NodeKind.ListItem, content="Keep the raw values and record a rejection reason for invalid or missing values."),
                    node(NodeKind.ListItem, content="Separate accepted and rejected rows; reconcile them with the input."),
                ], style="ho-steps"),
            ]),
            group([
                heading("Check your result", level=2),
                node(NodeKind.Table, children=[
                    node(NodeKind.Caption, content="Expected rejected sales", style="sr-only"),
                    node(NodeKind.TableHead, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="Rejected sale", attributes=[attr("scope", "col")]),
                            node(NodeKind.HeaderCell, content="Reason", attributes=[attr("scope", "col")]),
                        ]),
                    ]),
                    node(NodeKind.TableBody, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="s6"),
                            node(NodeKind.Cell, content="Invalid amount"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="s7"),
                            node(NodeKind.Cell, content="Missing amount"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="s8"),
                            node(NodeKind.Cell, content="Invalid timestamp"),
                        ]),
                    ]),
                ], style="ho-table"),
                paragraph([
                    strong("8"),
                    text(" = "),
                    strong("5"),
                    text(" accepted + "),
                    strong("3"),
                    text(" rejected"),
                ], style="ho-reconciliation"),
            ]),
        ], style="ho-workgrid"),
            group([
            heading("Code to work with", level=2),
            code_block("""amount = F.expr("try_cast(amount_raw AS DECIMAL(12, 2))")
sold_at = F.try_to_timestamp("sold_at_raw", F.lit("yyyy-MM-dd HH:mm:ss"))"""),
        ], style="ho-hint"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("109"),
        ]),
        ],
        notes="The exercise clean_sales function normalizes keys, parses the two fields and records the first rejection reason. It also checks missing/empty product keys. Invalid amount conversion should produce null, not zero. Preserve raw fields for inspection. M1 is a well-formed key with no lookup match and remains accepted; it is not one of the rejected records. Use the lab functions and checks to review the result. https://spark.apache.org/docs/4.2.0/api/python/reference/pyspark.sql/api/pyspark.sql.functions.try_to_timestamp.html",
    )

pub def slide_pyspark_report() -> Slide:
    return Slide(
        slug="pyspark-report",
        title="Exercise 4 · Join and aggregate",
        frame=Frame.Composed,
        styles="slide ho-lesson ho-exercise",
        content=[
            group([
            text("08 / WORKING WITH PYSPARK"),
        ], style="eyebrow"),
            heading("Exercise 4 · Join and aggregate", level=1),
            group([
            group([
                heading("Your task", level=2),
                node(NodeKind.OrderedList, children=[
                    node(NodeKind.ListItem, content="Check that the cleaned product lookup has one row per key."),
                    node(NodeKind.ListItem, children=[
                        text("Left join accepted sales to products. Label a missing category "),
                        code("unmapped"),
                        text("."),
                    ]),
                    node(NodeKind.ListItem, content="Group by category; count sales and sum their amounts."),
                ], style="ho-steps"),
            ]),
            group([
                heading("Check your result", level=2),
                node(NodeKind.Table, children=[
                    node(NodeKind.Caption, content="Expected category report", style="sr-only"),
                    node(NodeKind.TableHead, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.HeaderCell, content="category", attributes=[attr("scope", "col")]),
                            node(NodeKind.HeaderCell, content="sales", attributes=[attr("scope", "col")]),
                            node(NodeKind.HeaderCell, content="total", attributes=[attr("scope", "col")]),
                        ]),
                    ]),
                    node(NodeKind.TableBody, children=[
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="books"),
                            node(NodeKind.Cell, content="3"),
                            node(NodeKind.Cell, content="50.00"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="games"),
                            node(NodeKind.Cell, content="1"),
                            node(NodeKind.Cell, content="40.00"),
                        ]),
                        node(NodeKind.Row, children=[
                            node(NodeKind.Cell, content="unmapped"),
                            node(NodeKind.Cell, content="1"),
                            node(NodeKind.Cell, content="10.00"),
                        ]),
                    ]),
                ], style="ho-table"),
                prose("Try INNER, then restore LEFT.", style="ho-note"),
            ]),
        ], style="ho-workgrid"),
            group([
            heading("Code to work with", level=2),
            code_block("""enriched = accepted.join(products, on="product_id", how="left")
report = enriched.groupBy("category").agg(
    F.count("*").alias("sales"), F.sum("amount").alias("total"))"""),
        ], style="ho-hint"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("110"),
        ]),
        ],
        notes="The short code seed omits the category replacement so participants add it: F.coalesce(\"category\", F.lit(\"unmapped\")). coalesce here is a column expression, not DataFrame.coalesce for partitions. Validate normalized lookup-key uniqueness before joining. An inner join removes M1/10.00, leaving four sales and total90.00. The full reference and pipeline.py include the left join, unmapped label and selected output columns.",
    )


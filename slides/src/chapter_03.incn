            group([
                node(NodeKind.Button, content="Previous point", attributes=[attr("type", "button"), attr("data-lesson-prev", flag=true)]),
                node(NodeKind.Button, content="Next point", attributes=[attr("type", "button"), attr("data-lesson-next", flag=true)]),
                node(NodeKind.Button, content="Replay", attributes=[attr("type", "button"), attr("data-lesson-reset", flag=true)]),

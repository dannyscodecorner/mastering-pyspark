    return Chapter(number="3", title="Spark’s Core Abstractions", first_page=1, slides=[
        slide_section_3(),
        slide_hadoop_mapreduce(),
        slide_spark_performance(),
        slide_spark_speedup(),
        slide_rdd_prompt(),
        slide_rdd_foundation(),
        slide_dataframe_meaning(),
        slide_immutable_definition(),
        slide_immutability(),
        slide_immutability_reference(),
        slide_api_overview(),
        slide_abstractions_recap(),
    ])

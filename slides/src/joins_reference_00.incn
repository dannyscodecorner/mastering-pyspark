                    ], style="ss-record ss-key-B1"),
                    prose("Alongside the other B1 inputs"),
                ], style="sc-read sc-fetch-reveal"),
                group([
                    span("Join", style="sc-node-label"),
                    group([
                        node(NodeKind.Bold, content="B1"),

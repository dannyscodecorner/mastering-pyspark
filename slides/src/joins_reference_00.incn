            group([
                node(NodeKind.Button, content="Previous point", attributes=[attr("data-lesson-prev", flag=true)]),
                node(NodeKind.Button, content="Next point", attributes=[attr("data-lesson-next", flag=true)]),
                node(NodeKind.Button, content="Replay", attributes=[attr("data-lesson-reset", flag=true)]),
                node(NodeKind.Link, content="Back to the chapter", style="sc-reference-return", attributes=[attr("href", "index.html#shuffle-cost-alternative")]),
                span("", style="lesson-position", attributes=[attr("aria-live", "polite")]),

                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "120"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "103"), attr("r", "3"), attr("fill", "#fafaf8")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "130"), attr("r", "3"), attr("fill", "#69bec3")]),
                node(NodeKind.SvgText, content="Worker node A", style="cluster-heading", attributes=[attr("x", "752"), attr("y", "107")]),
                node(NodeKind.SvgText, content="Executors run tasks", style="cluster-body", attributes=[attr("x", "752"), attr("y", "141")]),
                node(NodeKind.SvgPath, style="cluster-flow cluster-data", attributes=[attr("d", "M1040 120 H1120"), attr("marker-start", "url(#cluster-arrow)")]),
                node(NodeKind.SvgRectangle, style="cluster-worker", attributes=[attr("x", "674"), attr("y", "184"), attr("width", "366"), attr("height", "96"), attr("rx", "7")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "205"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "232"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "215"), attr("r", "3"), attr("fill", "#fafaf8")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "242"), attr("r", "3"), attr("fill", "#69bec3")]),
                node(NodeKind.SvgText, content="Worker node B", style="cluster-heading", attributes=[attr("x", "752"), attr("y", "219")]),
                node(NodeKind.SvgText, content="Executors run tasks", style="cluster-body", attributes=[attr("x", "752"), attr("y", "253")]),
                node(NodeKind.SvgPath, style="cluster-flow cluster-data", attributes=[attr("d", "M1040 232 H1120"), attr("marker-start", "url(#cluster-arrow)")]),
                node(NodeKind.SvgRectangle, style="cluster-worker", attributes=[attr("x", "674"), attr("y", "296"), attr("width", "366"), attr("height", "96"), attr("rx", "7")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "317"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgRectangle, attributes=[attr("x", "692"), attr("y", "344"), attr("width", "44"), attr("height", "21"), attr("rx", "4"), attr("fill", "#286faf")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "327"), attr("r", "3"), attr("fill", "#fafaf8")]),
                node(NodeKind.SvgCircle, attributes=[attr("cx", "701"), attr("cy", "354"), attr("r", "3"), attr("fill", "#69bec3")]),
                node(NodeKind.SvgText, content="Worker node C", style="cluster-heading", attributes=[attr("x", "752"), attr("y", "331")]),
                node(NodeKind.SvgText, content="Executors run tasks", style="cluster-body", attributes=[attr("x", "752"), attr("y", "365")]),
                node(NodeKind.SvgPath, style="cluster-flow cluster-data", attributes=[attr("d", "M1040 344 H1120"), attr("marker-start", "url(#cluster-arrow)")]),
            ], attributes=[attr("viewBox", "0 0 1308 490"), attr("role", "img"), attr("aria-labelledby", "cluster-title cluster-desc")]),
        ], style="cluster-overview"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("5"),
        ]),
        ],
        notes="Start with the worker nodes: these are separate computers, each contributing CPU and memory. A large computation can be split into tasks that run in parallel. For Spark, distinguish the application’s driver (schedules tasks and handles their results) from the cluster manager (allocates resources across applications). Resource allocation is shown as a relationship, not the full launch protocol. Follow the outgoing work, then results and status returning. For our count example, the distributed computation produces a number that returns to the application. Executors read data directly from storage; input rows do not all travel through the driver. Storage can be remote or local; the drawing uses shared storage and does not imply one fixed partition per node. The driver can run inside or outside the cluster. Transition: “What does a program that uses this cluster look like?” Show the PySpark code and invite the group to explain it. Source: original workshop slide 10; corrected roles: https://spark.apache.org/docs/4.2.0/cluster-overview.html .",
    )

pub def slide_pyspark_code() -> Slide:
    return Slide(
        slug="pyspark-code",
        title="A PySpark application",
        frame=Frame.Composed,
        styles="slide migrated",
        content=[
            group([
            text("01 / SPARK VS. PYTHON"),
        ], style="eyebrow"),
            heading("A PySpark application", level=1),
            code_block("""from pyspark.sql import SparkSession

spark = (SparkSession.builder
    .appName("MyApp")
    .getOrCreate())

df = spark.read.parquet("data/")
print(df.count())""", style="audience-code"),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("6"),
        ]),
        ],
        notes="Pause here and ask: “Who can explain this piece of code to me?” Let the group talk before explaining. Listen for what SparkSession does, what reading Parquet produces, when work actually starts, and where count and print execute. This is a conversation to gauge familiarity, not a test. The example assumes an available Spark runtime and a readable Parquet dataset at data/. Bridge: “We have seen the cluster. How does this Python program make use of it?” Move directly to the detailed PySpark diagram. Save the full discussion of laziness for the later section.",
    )

pub def slide_classic_pyspark() -> Slide:
    return Slide(
        slug="classic-pyspark",
        title="How Python Interacts with Spark",
        frame=Frame.Composed,
        styles="slide migrated",
        content=[
            group([
            text("01 / SPARK VS. PYTHON"),
        ], style="eyebrow"),
            heading("How Python Interacts with Spark", level=1),
            prose("Classic PySpark · application, driver and cluster", style="subtitle"),
            node(NodeKind.Figure, children=[
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgTitle, content="How Python interacts with Spark", attributes=[attr("id", "classic-title")]),
                node(NodeKind.SvgDescription, content="A PySpark application calls the driver JVM through Py4J. The driver distributes tasks to executor JVMs on cluster worker nodes and receives task results and status. Executors use Python workers when Python execution is required. The driver returns requested results to the application.", attributes=[attr("id", "classic-desc")]),
                node(NodeKind.SvgDefinitions, children=[
                    node(NodeKind.SvgMarker, children=[
                        node(NodeKind.SvgPath, attributes=[attr("d", "M0 0L10 5L0 10"), attr("fill", "#4b6973")]),
                    ], attributes=[attr("id", "classic-arrow"), attr("viewBox", "0 0 10 10"), attr("refX", "9"), attr("refY", "5"), attr("markerWidth", "6"), attr("markerHeight", "6"), attr("orient", "auto-start-reverse")]),
                ]),
                node(NodeKind.SvgRectangle, style="application-region", attributes=[attr("x", "8"), attr("y", "8"), attr("width", "428"), attr("height", "430"), attr("rx", "8")]),
                node(NodeKind.SvgText, content="Your Python application", style="region-title", attributes=[attr("x", "28"), attr("y", "46")]),
                node(NodeKind.SvgRectangle, style="driver-region", attributes=[attr("x", "566"), attr("y", "8"), attr("width", "324"), attr("height", "430"), attr("rx", "8")]),

"""Editable Incan content migrated from the captured index.html."""

from surface import Attribute, Chapter, Frame, NodeKind, Slide, Surface, TeachingStep, attr, code, code_block, emphasis, group, heading, image, line_break, node, paragraph, prose, rich_heading, span, strong, text
from components import step_rail, step_cues

pub def slide_section_1() -> Slide:
    return Slide(
        slug="section-1",
        title="Spark vs. Python",
        frame=Frame.Composed,
        styles="slide dark python-spark-intro",
        content=[
            image("assets/python-spark-bridge.png", "", style="bridge-backdrop"),
            group([
            text("01 / SPARK VS. PYTHON"),
        ], style="eyebrow"),
            group([
            image("assets/history/spark-reverse.svg", "Apache Spark"),
            prose("The distributed engine"),
        ], style="intro-technology spark-technology"),
            group([
            image("assets/python-logo.svg", "Python"),
            prose("The language you write"),
        ], style="intro-technology python-technology"),
            rich_heading([
            text("How do Python and Spark"),
            line_break(),
            emphasis("work together?"),
        ], level=1),
            node(NodeKind.Footer, children=[
            span("Danny’s Code Corner"),
            span("4"),
        ]),
        ],
        notes="Open the section with the distinction between the language and the distributed engine. Python and Spark are not competing tools: PySpark connects them. Ask how Python code becomes work on a cluster, then advance to Cluster Computing. The central connection is a visual metaphor, not a technical process diagram.",
    )

pub def slide_architecture() -> Slide:
    return Slide(
        slug="architecture",
        title="Cluster Computing",
        frame=Frame.Composed,
        styles="slide migrated",
        content=[
            group([
            text("01 / SPARK VS. PYTHON"),
        ], style="eyebrow"),
            heading("Cluster Computing", level=1),
            prose("Several computers working together. Each computer is a node.", style="subtitle"),
            node(NodeKind.Figure, children=[
            node(NodeKind.Svg, children=[
                node(NodeKind.SvgTitle, content="Cluster Computing", attributes=[attr("id", "cluster-title")]),
                node(NodeKind.SvgDescription, content="A Spark driver schedules tasks on executors across three worker nodes and receives results and status; a separate cluster manager allocates resources, and executors access data storage directly.", attributes=[attr("id", "cluster-desc")]),
                node(NodeKind.SvgDefinitions, children=[
                    node(NodeKind.SvgMarker, children=[
